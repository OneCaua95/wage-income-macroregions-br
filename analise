k 82: acumulado 7,067,789\n","  [Passada única] chunk 83: acumulado 7,128,061\n","N: 7,128,061\n","\n","Calculando testes e VIF...\n","\n","Gerando gráficos...\n","Exportado: m5_ajustado_diagnostico_residuos.png\n","Exportado: m5_ajustado_vif_grafico.png\n","Exportado: m5_ajustado_matriz_correlacao.png\n","\n","Concluído.\n"]}]},{"cell_type":"markdown","source":["FIX"],"metadata":{"id":"lQ-EN3Sw9Z_L"}},{"cell_type":"code","source":["\"\"\"\n","CONSOLIDAÇÃO DA TABELA FINAL DE COEFICIENTES — M5 AJUSTADO\n","================================================================================\n","Junta os dois CSVs já exportados nas etapas anteriores:\n","\n","  1. m5_ajustado_coeficientes_cluster_coorte_uf.csv\n","     -> resultado PRINCIPAL: coef. e SE cluster duplo (Coorte + UF, CGM 2011)\n","\n","  2. m5_wild_cluster_bootstrap_uf.csv\n","     -> CHECAGEM DE ROBUSTEZ: SE bootstrap na dimensão UF (não substitui a\n","        SE principal — só valida se ela está distorcida ou não)\n","\n","Saída: uma tabela única, pronta pra tese/artigo, com:\n","  - Coeficiente e SE cluster duplo (a que vai na tabela de resultados)\n","  - Estrelas de significância (*, **, ***) na notação usual\n","  - Interpretação percentual aproximada (exp(β)-1)×100 -- válida\n","    diretamente para dummies; para Anos_de_Estudo é o efeito de mais um\n","    ano de estudo\n","  - Sinalização de robustez: \"OK\" se a razão SE_boot/SE_assint (CGM\n","    duplo vs. bootstrap UF) ficou dentro de 0,85–1,15, \"Atenção\" fora\n","    disso (nenhuma variável caiu em \"Atenção\" na rodada anterior, mas o\n","    script já deixa isso automatizado pra próximas rodadas do modelo)\n","\"\"\"\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","def estrelas_significancia(p: float) -> str:\n","    if p < 0.01:\n","        return \"***\"\n","    elif p < 0.05:\n","        return \"**\"\n","    elif p < 0.10:\n","        return \"*\"\n","    return \"\"\n","\n","\n","def consolidar_tabela_final(\n","    caminho_coef_principal: str = \"m5_ajustado_coeficientes_cluster_coorte_uf.csv\",\n","    caminho_bootstrap_uf: str = \"m5_wild_cluster_bootstrap_uf.csv\",\n","    caminho_saida: str = \"m5_ajustado_tabela_final.csv\",\n","):\n","    principal = pd.read_csv(caminho_coef_principal)\n","    bootstrap = pd.read_csv(caminho_bootstrap_uf)\n","\n","    # -- Notação consistente entre os dois CSVs (mesma coluna \"Variável\")\n","    tabela = principal.merge(\n","        bootstrap[[\"Variável\", \"SE_Bootstrap_UF\", \"SE_Assintotica_UF\", \"Razao_Boot_Assint\"]],\n","        on=\"Variável\", how=\"left\"\n","    )\n","\n","    # -- Estrelas de significância a partir do P>|t| da SE cluster duplo (principal)\n","    tabela[\"Signif.\"] = tabela[\"P>|t|\"].apply(estrelas_significancia)\n","\n","    # -- Interpretação percentual aproximada: (exp(β)-1) × 100\n","    #    Válida como \"efeito percentual\" direto para dummies (0/1).\n","    #    Para Anos_de_Estudo, é o efeito de +1 ano de estudo.\n","    #    Para o Intercept, não faz sentido -- deixamos em branco.\n","    tabela[\"Efeito_%_Aprox\"] = (np.exp(tabela[\"Coef.\"]) - 1) * 100\n","    tabela.loc[tabela[\"Variável\"] == \"Intercept\", \"Efeito_%_Aprox\"] = np.nan\n","\n","    # -- Sinalização de robustez (só existe pra variáveis que entraram no\n","    #    bootstrap -- todas, neste caso, já que o bootstrap roda pro k\n","    #    corrente do design; o k mudou com a última revisão das dummies\n","    #    de referência de Setor/Ocupação, então não fixamos o valor aqui)\n","    def flag_robustez(razao):\n","        if pd.isna(razao):\n","            return \"não checado\"\n","        return \"OK\" if 0.85 <= razao <= 1.15 else \"Atenção\"\n","\n","    tabela[\"Robustez_Bootstrap\"] = tabela[\"Razao_Boot_Assint\"].apply(flag_robustez)\n","\n","    # -- Reordena colunas pra leitura direta\n","    colunas_finais = [\n","        \"Variável\", \"Coef.\", \"Signif.\", \"Erro_Padrao_Cluster_Duplo\",\n","        \"t\", \"P>|t|\", \"IC_2.5%\", \"IC_97.5%\", \"Efeito_%_Aprox\",\n","        \"SE_Bootstrap_UF\", \"Razao_Boot_Assint\", \"Robustez_Bootstrap\",\n","    ]\n","    tabela = tabela[colunas_finais]\n","\n","    tabela.to_csv(caminho_saida, index=False, encoding=\"utf-8-sig\")\n","    print(f\"Exportado: {caminho_saida}\")\n","\n","    n_atencao = (tabela[\"Robustez_Bootstrap\"] == \"Atenção\").sum()\n","    print(f\"\\nVariáveis sinalizadas para atenção na robustez bootstrap: {n_atencao} de {len(tabela)}\")\n","\n","    print(\"\\n\" + \"=\" * 100)\n","    print(\"TABELA FINAL DE COEFICIENTES — M5 AJUSTADO (cluster duplo Coorte + UF)\")\n","    print(\"=\" * 100)\n","    colunas_print = [\"Variável\", \"Coef.\", \"Signif.\", \"Erro_Padrao_Cluster_Duplo\", \"P>|t|\", \"Efeito_%_Aprox\"]\n","    print(tabela[colunas_print].to_string(index=False, float_format=lambda v: f\"{v:,.4f}\"))\n","    print(\"\\nSignificância: *** p<0.01, ** p<0.05, * p<0.10\")\n","    print(\"Efeito_%_Aprox = (exp(coef.) - 1) × 100 -- interpretação direta para dummies;\")\n","    print(\"para Anos_de_Estudo, é o efeito aproximado de +1 ano de estudo sobre o salário-hora.\")\n","\n","    return tabela\n","\n","\n","if __name__ == \"__main__\":\n","    tabela_final = consolidar_tabela_final()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"FpA4FRs9BcvR","executionInfo":{"status":"ok","timestamp":1786914015179,"user_tz":180,"elapsed":53,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"c5c74629-fc85-4da6-f01c-d9c395b21f8e"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Exportado: m5_ajustado_tabela_final.csv\n","\n","Variáveis sinalizadas para atenção na robustez bootstrap: 0 de 44\n","\n","====================================================================================================\n","TABELA FINAL DE COEFICIENTES — M5 AJUSTADO (cluster duplo Coorte + UF)\n","=================================================================