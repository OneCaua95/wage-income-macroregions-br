                                                                      Branca\n","FE Coorte (Faixa_Nascimento)                                                            Sim\n","FE Ano                                                                                  Sim\n","FE Trimestre                                                                            Sim\n","FE Região                                                                               Não\n","R²                                                                                   0.4302\n","R² Ajustado                                                                          0.4302\n","N                                                                                 7,128,061\n","Cluster (G Coorte)                                                                        8\n","\n","Exportado: m4_base_m5_resultados.xlsx\n","Exportado: m4_base_m5_resultados.csv\n","Exportado: m4_base_m5_vif.csv\n"]}]},{"cell_type":"code","source":["\"\"\"\n","Tabela de Coortes — Comparação 2013 vs 2025\n","Formato: linhas = Coorte (Sexo + faixa etária real, extraídos da coluna\n","`Coorte` já gerada no pipeline), colunas agrupadas = variável (2013 | 2025\n","lado a lado).\n","\n","A coluna `Coorte` do parquet vem no formato \"Sexo-Faixa-Cor\"\n","(ex.: '1-3-1'). Aqui usamos apenas os dois primeiros dígitos:\n","  - 1º dígito = Sexo (0 = Homem, 1 = Mulher)\n","  - 2º dígito = Faixa_Idade (código 1 a 8, ver FAIXA_IDADE_LABELS)\n","O 3º dígito (Cor/etnia) é ignorado nesta tabela.\n","\n","Variáveis: Salário-médio/hora, Escolaridade (anos), Formal (%),\n","Setor público (%). \"Capital (%)\" NÃO está disponível no dataset atual\n","(não há identificação de município/capital, só UF) — fica marcada como\n","placeholder (NaN) até que essa variável seja adicionada ao pipeline.\n","\n","NOVIDADE: agora a tabela considera apenas o ÚLTIMO TRIMESTRE (4º) de cada\n","ano, em vez de todos os trimestres agregados. Isso segue a prática comum\n","de comparação de coortes na PNAD Contínua (foto do 4º tri de cada ano).\n","Ajuste TRIMESTRE_COMPARACAO e/ou o nome da coluna \"Trimestre\" abaixo caso\n","o parquet use outro nome de coluna.\n","\"\"\"\n","\n","import pyarrow.parquet as pq\n","import pyarrow.compute as pc\n","import pandas as pd\n","import numpy as np\n","\n","# ---------------------------------------------------------------\n","# 1. Configuração\n","# ---------------------------------------------------------------\n","CAMINHO_PARQUET = \"/content/pnad_processado_final.parquet\"\n","CAMINHO_SAIDA = \"/content/tabela_coortes_2013_2025_T4.xlsx\"\n","\n","MAPA_SEXO = {\"0\": \"Homem\", \"1\": \"Mulher\"}\n","\n","ANOS_COMPARACAO = [2013, 2025]\n","\n","# Trimestre a considerar (último trimestre do ano = 4)\n","TRIMESTRE_COMPARACAO = 4\n","COLUNA_TRIMESTRE = \"Trimestre\"  # ajuste aqui se o nome da coluna for outro\n","\n","# Correspondência código -> faixa etária real (mesma do pipeline principal)\n","FAIXA_IDADE_LABELS = {\n","    \"1\": \"25-29\", \"2\": \"30-34\", \"3\": \"35-39\", \"4\": \"40-44\",\n","    \"5\": \"45-49\", \"6\": \"50-54\", \"7\": \"55-59\", \"8\": \"60-65\",\n","}\n","ORDEM_FAIXAS = [\"25-29\", \"30-34\", \"35-39\", \"40-44\", \"45-49\", \"50-54\", \"55-59\", \"60-65\"]\n","\n","APLICAR_FILTRO_QUALIDADE = True  # remove salario_hora <= 0\n","\n","\n","def carregar_dados(caminho: str, anos: list[int], trimestre: int) -> pd.DataFrame:\n","    colunas = [\n","        \"Ano\", COLUNA_TRIMESTRE, \"Coorte\",\n","        \"salario_hora\", \"Anos_de_Estudo\", \"is_formal\", \"is_public\",\n","    ]\n","    filtro = pc.field(\"Ano\").isin(anos) & (pc.field(COLUNA_TRIMESTRE) == trimestre)\n","    tabela = pq.read_table(caminho, columns=colunas, filters=filtro)\n","    df = tabela.to_pandas()\n","\n","    print(f\"Filtro de trimestre: apenas {COLUNA_TRIMESTRE} == {trimestre} \"\n","          f\"(4º trimestre / última leitura do ano)\")\n","\n","    # Extrai os dois primeiros dígitos da string \"Coorte\" (Sexo-Faixa-Cor),\n","    # ignorando o terceiro (Cor/etnia)\n","    partes = df[\"Coorte\"].astype(str).str.split(\"-\", expand=True)\n","    df[\"Sexo_cod\"] = partes[0]\n","    df[\"Faixa_cod\"] = partes[1]\n","\n","    df[\"Sexo\"] = df[\"Sexo_cod\"].map(MAPA_SEXO)\n","    df[\"Faixa_Idade\"] = pd.Categorical(\n","        df[\"Faixa_cod\"].map(FAIXA_IDADE_LABELS),\n","        categories=ORDEM_FAIXAS,\n","        ordered=True,\n","    )\n","\n","    return df\n","\n","\n","def aplicar_filtros(df: pd.DataFrame) -> pd.DataFrame:\n","    if not APLICAR_FILTRO_QUALIDADE:\n","        return df\n","    antes = len(df)\n","    df = df[df[\"salario_hora\"] > 0].copy()\n","    print(f\"Filtro de qualidade: {antes:,} -> {len(df):,} obs \"\n","          f\"({(antes - len(df)) / antes:.2%} removidas)\")\n","    return df\n","\n","\n","def construir_tabela(df: pd.DataFrame) -> pd.DataFrame:\n","    \"\"\"Agrega por Sexo x Faixa_Idade x Ano, depois pivota para o\n","    formato lado a lado (2013 | 2025) por variável, replicando a tabela\n","    de referência.\"\"\"\n","\n","    agregado = (\n","        df.groupby([\"Sexo\", \"Faixa_Idade\", \"Ano\"], observed=True)\n","        .agg(\n","            Salario_medio_hora=(\"salario_hora\", \"mean\"),\n","            Escolaridade_anos=(\"Anos_de_Estudo\", \"mean\"),\n","            Formal_pct=(\"is_formal\", lambda s: s.mean() * 100),\n","            Setor_publico_pct=(\"is_public\", lambda s: s.mean() * 100),\n","            N=(\"salario_hora\", \"count\"),\n","        )\n","        .reset_index()\n","    )\n","\n","    pivô = agregado.pivot_table(\n","        index=[\"Sexo\", \"Faixa_Idade\"],\n","        columns=\"Ano\",\n","        values=[\"Salario_medio_hora\", \"Escolaridade_anos\", \"Formal_pct\", \"Setor_publico_pct\", \"N\"],\n","        observed=True,\n","    )\n","\n","    # Placeholder para \"Capital (%)\" — variável não disponível no dataset atual\n","    for ano in ANOS_COMPARACAO:\n","        pivô[(\"Capital_pct\", ano)] = np.nan\n","\n","    # Ordena colunas: variável -> ano, na mesma ordem da tabela de referência\n","    ordem_variaveis = [\n","        \"Salario_medio_hora\", \"Escolaridade_anos\",\n","        \"Formal_pct\", \"Setor_publico_pct\", \"Capital_pct\",\n","    ]\n","    pivô = pivô.reindex(\n","        columns=pd.MultiIndex.from_product([ordem_variaveis, ANOS_COMPARACAO]),\n","        level=None,\n","    )\n","\n","    pivô = pivô.round(2)\n","\n","    # Ordena linhas: Homem (faixas em ordem crescente), depois Mulher\n","    pivô = pivô.reindex(\n","        pd.MultiIndex.from_product([[\"Homem\", \"Mulher\"], ORDEM_FAIXAS]),\n","    )\n","\n","    # Rótulo único \"Coorte\" (ex.: \"Homem 25-29\"), como na tabela de referência\n","    pivô.index = [f\"{sexo} {faixa}\" for sexo, faixa in pivô.index]\n","    pivô.index.name = \"Coorte\"\n","\n","    return pivô\n","\n","\n","NOMES_VARIAVEIS_PT = {\n","    \"Salario_medio_hora\": \"Salário-médio (hora)\",\n","    \"Escolaridade_anos\": \"Escolaridade (anos)\",\n","    \"Formal_pct\": \"Formal (%)\",\n","    \"Setor_publico_pct\": \"Setor público (%)\",\n","    \"Capital_pct\": \"Capital (%)\",\n","    \"N\": \"N (obs.)\",\n","}\n","\n","\n","def salvar_excel_formatado(tabela: pd.DataFrame, caminho: str):\n","    \"\"\"Salva com cabeçalho em duas linhas mescladas (variável / ano),\n","    replicando visualmente a tabela de referência.\"\"\"\n","    from openpyxl import Workbook\n","    from openpyxl.styles import Alignment, Font, Border, Side\n","    from openpyxl.utils import get_column_letter\n","\n","    wb = Workbook()\n","    ws = wb.active\n","    ws.title = \"Coortes_2013_2025_T4\"\n","\n","    variaveis = list(dict.fromkeys(v for v, _ in tabela.columns))  # ordem preservada, sem N\n","    anos = ANOS_COMPARACAO\n","\n","    # Cabeçalho linha 1: nome da variável (mesclado sobre as 2 colunas de ano)\n","    # Cabeçalho linha 2: ano\n","    col = 2  # coluna 1 é \"Coorte\"\n","    ws.cell(row=1, column=1, value=\"Coorte\")\n","    ws.merge_cells(start_row=1, start_column=1, end_row=2, end_column=1)\n","\n","    for var in variaveis:\n","        nome_pt = NOMES_VARIAVEIS_PT.get(var, var)\n","        ws.cell(row=1, column=col, value=nome_pt)\n","        ws.merge_cells(start_row=1, start_column=col, end_row=1, end_column=col + len(anos) - 1)\n","        for i, ano in enumerate(anos):\n","            ws.cell(row=2, column=col + i, value=ano)\n","        col += len(anos)\n","\n","    negrito = Font(bold=True)\n","    centro = Alignment(horizontal=\"center\", vertical=\"center\")\n","    borda = Border(bottom=Side(style=\"thin\"))\n","    for row in ws[1:2]:\n","        for cell in row:\n","            cell.font = negrito\n","            cell.alignment = centro\n","            cell.border = borda\n","\n","    # Linhas de dados\n","    linha_excel = 3\n","    for coorte, valores in tabela.iterrows():\n","        ws.cell(row=linha_excel, column=1, value=coorte)\n","        col = 2\n","        for var in variaveis:\n","            for ano in anos:\n","                v = valores[(var, ano)]\n","                ws.cell(row=linha_excel, column=col,\n","                         value=None if pd.isna(v) else float(v))\n","                col += 1\n","        linha_excel += 1\n","\n","    # Larguras de coluna\n","    ws.column_dimensions[\"A\"].width = 20\n","    for c in range(2, col):\n","        ws.column_dimensions[get_column_letter(c)].width = 10\n","\n","    wb.save(caminho)\n","\n","\n","def main():\n","    print(f\"Carregando dados para {ANOS_COMPARACAO}, \"\n","          f\"apenas {COLUNA_TRIMESTRE} == {TRIMESTRE_COMPARACAO}...\")\n","    df = carregar_dados(CAMINHO_PARQUET, ANOS_COMPARACAO, TRIMESTRE_COMPARACAO)\n","    print(f\"Total lido: {len(df):,} observações\")\n","\n","    df = aplicar_filtros(df)\n","\n","    print(\"Construindo tabela de coortes...\")\n","    tabela = construir_tabela(df)\n","\n","    print(\"\\n--- Tabela de Coortes 2013 vs 2025 (4º trimestre) ---\")\n","    print(tabela.to_string())\n","\n","    print(\"\\nSalvando em Excel (com cabeçalho mesclado)...\")\n","    salvar_excel_formatado(tabela, CAMINHO_SAIDA)\n","\n","    print(f\"Arquivo salvo em: {CAMINHO_SAIDA}\")\n","    print(\"\\nATENÇÃO: a coluna 'Capital (%)' foi deixada como NaN — essa \"\n","          \"variável (residência na capital/região metropolitana) não existe \"\n","          \"no parquet atual, que só tem granularidade de UF.\")\n","\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"id":"OMQyikBFHdaR","executionInfo":{"status":"ok","timestamp":1787251250506,"user_tz":180,"elapsed":2198,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"e2227285-3790-4fbd-fc21-139065dfe396","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Carregando dados para [2013, 2025], apenas Trimestre == 4...\n","Filtro de trimestre: apenas Trimestre == 4 (4º trimestre / última leitura do ano)\n","Total lido: 355,221 observações\n","Filtro de qualidade: 355,221 -> 355,221 obs (0.00% removidas)\n","Construindo tabela de coortes...\n","\n","--- Tabela de Coortes 2013 vs 2025 (4º trimestre) ---\n","             Salario_medio_hora            Escolaridade_anos        Formal_pct        Setor_publico_pct        Capital_pct     \n","                           2013       2025              2013   2025       2013   2025              2013   2025        2013 2025\n","Coorte                                                                                                                         \n","Homem 25-29           14.950000  16.430000             10.42  11.90      62.42  57.61              8.53   7.11         NaN  NaN\n","Homem 30-34           17.309999  19.410000              9.80  11.69      62.56  60.49              9.97   8.19         NaN  NaN\n","Homem 35-39           18.250000  23.000000              8.86  11.44      59.94  61.37             10.09  10.75         NaN  NaN\n","Homem 40-44           19.709999  23.790001              8.33  10.95      59.62  61.74             10.60  12.53         NaN  NaN\n","Homem 45-49           21.049999  23.799999              7.99  10.07      59.40  60.81             12.03  12.62         NaN  NaN\n","Homem 50-54           21.540001  23.420000              7.67   9.21      56.33  59.50             11.86  12.10         NaN  NaN\n","Homem 55-59           22.209999  21.790001              7.11   8.53      52.62  56.10             11.63  11.74         NaN  NaN\n","Homem 60-65           22.590000  24.290001              6.41   8.35      43.97  50.42              9.95  11.72         NaN  NaN\n","Mulher 25-29          14.240000  16.180000             12.01  13.22      63.05  59.21             15.68  15.68         NaN  NaN\n","Mulher 30-34          16.170000  18.950001             11.50  13.12      62.02  59.92             19.69  17.25         NaN  NaN\n","Mulher 35-39          16.670000  21.150000             10.78  12.92      61.43  61.12             21.56  20.62         NaN  NaN\n","Mulher 40-44          17.370001  20.910000             10.19  12.52      60.52  62.25             22.33  23.24         NaN  NaN\n","Mulher 45-49          18.230000  21.280001              9.84  11.91      60.56  62.87             25.11  24.80         NaN  NaN\n","Mulher 50-54          19.820000  20.230000              9.41  11.13      58.90  60.69             25.90  23.87         NaN  NaN\n","Mulher 55-59          19.670000  21.010000              8.87  10.79      54.98  58.46             25.49  24.53         NaN  NaN\n","Mulher 60-65          20.020000  23.010000              8.08  10.38      42.01  51.43             19.76  23.01         NaN  NaN\n","\n","Salvando em Excel (com cabeçalho mesclado)...\n","Arquivo salvo em: /content/tabela_coortes_2013_2025_T4.xlsx\n","\n","ATENÇÃO: a coluna 'Capital (%)' foi deixada como NaN — essa variável (residência na capital/região metropolitana) não existe no parquet atual, que só tem granularidade de UF.\n"]}]},{"cell_type":"markdown","source":["# Graficos"],"metadata":{"id":"8hCVKdj69FrV"}},{"cell_type":"code","source":["\"\"\"\n","Evolução do salário médio por hora real — PNAD Contínua (2013-2025)\n","\n","Versão otimizada:\n","  - Corrige o fator de conversão semana -> mês (era *4, o correto é 52/12).\n","  - Substitui os loops aninhados (período x sexo/setor/formalidade x região)\n","    por agregações vetorizadas com groupby/unstack.\n","  - Elimina a duplicação nos 7 gráficos, nas 7 validações e no relatório\n","    final, todos agora dirigidos por pequenas listas de configuração.\n","\n","Ajustes de visualização (a pedido do usuário):\n","  - Legendas maiores.\n","  - Eixo X mostrando apenas o ano (não mais ano.trimestre).\n","  - Fontes dos rótulos e ticks dos eixos X/Y maiores.\n","\"\"\"\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import matplotlib.ticker as mticker\n","\n","# ==========================================================\n","# CONSTANTES\n","# ==========================================================\n","\n","FILE_PATH = \"/content/pnad_consolidada_2013_2025.parquet\"\n","\n","REGIOES = [\"Norte\", \"Nordeste\", \"Sudeste\", \"Sul\", \"Centro-Oeste\"]\n","\n","# BUG CORRIGIDO: um mês tem em média 52/12 semanas (~4,345), não 4.\n","# Usar *4 inflava o salário/hora estimado em ~8,6% em todas as séries.\n","SEMANAS_POR_MES = 4.33\n","\n","FONTE = (\n","    \"Fonte: PNAD Contínua – IBGE (2013–2025). \"\n","    \"Valores deflacionados pelo IPCA (Base: Jan/2026).\"\n",")\n","\n","YLABEL_PADRAO = \"Salário médio por hora (R$ reais, Base Jan/2026)\"\n","XLABEL_PADRAO = \"Ano\"\n","\n","\n","# ==========================================================\n","# 1) LEITURA E PREPARAÇÃO DA BASE\n","# ==========================================================\n","\n","def carregar_base(file_path):\n","    df = pd.read_parquet(file_path)\n","\n","    print(\"=\" * 70)\n","    print(\"BASE CARREGADA\")\n","    print(\"=\" * 70)\n","    print(f\"Observações: {len(df):,}\")\n","    print(f\"Colunas: {len(df.columns)}\")\n","    print(f\"\\nPeríodo: {df['Ano'].min()} até {df['Ano'].max()}\")\n","\n","    df[\"Periodo\"] = df[\"Ano\"].astype(str) + \".\" + df[\"Trimestre\"].astype(str)\n","    return df\n","\n","\n","def calcular_salario_hora(df):\n","    \"\"\"Calcula o salário/hora linha a linha, de forma vetorizada.\"\"\"\n","    horas = df[\"Horas_hab_trabalhadas\"].replace(0, np.nan)\n","    rendimento = df[\"Rendimento_hab_Trab_princ\"]\n","\n","    valido = horas.notna() & rendimento.notna()\n","\n","    salario_hora = pd.Series(np.nan, index=df.index)\n","    salario_hora[valido] = rendimento[valido] / (horas[valido] * SEMANAS_POR_MES)\n","    return salario_hora\n","\n","\n","def classificar_grupos(df):\n","    \"\"\"Cria as colunas de corte: Sexo_Grupo, Setor e Formalidade.\"\"\"\n","\n","    df[\"Sexo_Grupo\"] = df[\"Sexo\"].map({1: \"Homem\", 2: \"Mulher\"})\n","\n","    df[\"Setor\"] = np.where(\n","        df[\"Categoria_emprego\"].isin([5, 6, 7]), \"Publico\", \"Privado\"\n","    )\n","\n","    formal = df[\"Categoria_emprego\"].isin([1, 3, 5, 7]) | (\n","        df[\"Categoria_emprego\"].isin([8, 9])\n","        & (df[\"Contribuicao_previdencia\"] == 1)\n","    )\n","    informal = df[\"Categoria_emprego\"].isin([2, 4, 6, 10]) | (\n","        df[\"Categoria_emprego\"].isin([8, 9])\n","        & (df[\"Contribuicao_previdencia\"] == 2)\n","    )\n","    df[\"Formalidade\"] = np.select([formal, informal], [\"Formal\", \"Informal\"], default=None)\n","\n","    return df\n","\n","\n","# ==========================================================\n","# 2) AGREGAÇÃO (VETORIZADA)\n","# ==========================================================\n","\n","def agregar_dimensao(df, periodos_ordenados, coluna_corte=None, categorias=None):\n","    \"\"\"\n","    Agrega o salário/hora médio por Período x Região, com um corte opcional\n","    (Sexo_Grupo, Setor ou Formalidade).\n","\n","    Sem corte -> colunas: Norte, Nordeste, ..., Brasil\n","    Com corte -> colunas: {categoria}_{regiao}, ..., Brasil_{categoria}\n","    \"\"\"\n","    resultado = pd.DataFrame(index=pd.Index(periodos_ordenados, name=\"Periodo\"))\n","\n","    if coluna_corte is None:\n","        tabela = (\n","            df.groupby([\"Periodo\", \"Regiao\"])[\"Salario_Hora\"]\n","            .mean()\n","            .round(2)\n","            .unstack(\"Regiao\")\n","        )\n","        for reg in REGIOES:\n","            resultado[reg] = tabela.get(reg)\n","        resultado[\"Brasil\"] = df.groupby(\"Periodo\")[\"Salario_Hora\"].mean().round(2)\n","        return resultado\n","\n","    for cat in categorias:\n","        sub = df[df[coluna_corte] == cat]\n","        tabela = (\n","            sub.groupby([\"Periodo\", \"Regiao\"])[\"Salario_Hora\"]\n","            .mean()\n","            .round(2)\n","            .unstack(\"Regiao\")\n","        )\n","        for reg in REGIOES:\n","            resultado[f\"{cat}_{reg}\"] = tabela.get(reg)\n","        resultado[f\"Brasil_{cat}\"] = sub.groupby(\"Periodo\")[\"Salario_Hora\"].mean().round(2)\n","\n","    return resultado\n","\n","\n","def montar_df_resultados(df, periodos_ordenados):\n","    partes = [\n","        agregar_dimensao(df, periodos_ordenados),\n","        agregar_dimensao(df, periodos_ordenados, \"Sexo_Grupo\", [\"Homem\", \"Mulher\"]),\n","        agregar_dimensao(df, periodos_ordenados, \"Setor\", [\"Publico\", \"Privado\"]),\n","        agregar_dimensao(df, periodos_ordenados, \"Formalidade\", [\"Formal\", \"Informal\"]),\n","    ]\n","    df_res = pd.concat(partes, axis=1).reset_index()\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"DATAFRAME DE RESULTADOS\")\n","    print(\"=\" * 70)\n","    print(f\"Períodos calculados: {len(df_res)}\")\n","    print(f\"Colunas calculadas: {len(df_res.columns)}\")\n","    print(\"\\nPrimeiros resultados:\")\n","    print(df_res.head(3))\n","\n","    return df_res\n","\n","\n","# ==========================================================\n","# 3) NOMES DAS LEGENDAS (gerados, não digitados um a um)\n","# ==========================================================\n","\n","def montar_nomes_legenda():\n","    nomes = {reg: reg for reg in REGIOES}\n","    nomes[\"Brasil\"] = \"Brasil\"\n","\n","    for prefixo in [\"Homem\", \"Mulher\", \"Publico\", \"Privado\", \"Formal\", \"Informal\"]:\n","        for reg in REGIOES:\n","            nomes[f\"{prefixo}_{reg}\"] = reg\n","        nomes[f\"Brasil_{prefixo}\"] = \"Brasil\"\n","\n","    return nomes\n","\n","\n","NOMES_LEGENDA = montar_nomes_legenda()\n","\n","\n","# ==========================================================\n","# 4) FUNÇÃO DE PLOTAGEM\n","# ==========================================================\n","\n","def plot_salario(df_plot, colunas, titulo, nome_arquivo, ncol_legenda=3,\n","                  ylabel=YLABEL_PADRAO, xlabel=XLABEL_PADRAO):\n","\n","    df_plot = df_plot.copy()\n","    periodo_split = df_plot[\"Periodo\"].astype(str).str.split(\".\", expand=True)\n","    df_plot[\"_Ano\"] = periodo_split[0].astype(int)\n","    df_plot[\"_Trimestre\"] = periodo_split[1].astype(int)\n","\n","    fig, ax = plt.subplots(figsize=(26, 11), dpi=300)\n","\n","    lines = {}\n","    for col in colunas:\n","        label = NOMES_LEGENDA.get(col, col)\n","        (line,) = ax.plot(\n","            df_plot[\"Periodo\"], df_plot[col],\n","            marker=\"o\", markersize=7, linewidth=3, label=label,\n","        )\n","        lines[col] = line\n","\n","    ax.set_title(titulo, fontsize=22, pad=28, fontweight=\"bold\")\n","    ax.set_ylabel(ylabel, fontsize=19)\n","    ax.set_xlabel(xlabel, fontsize=19)\n","    ax.grid(True, which=\"major\", axis=\"both\", linestyle=\"--\", linewidth=0.7, alpha=0.5)\n","    ax.tick_params(axis=\"x\", labelsize=16)\n","    ax.tick_params(axis=\"y\", labelsize=17)\n","    ax.yaxis.set_major_formatter(mticker.FormatStrFormatter(\"R$ %.0f\"))\n","\n","    # ---- Eixo X apenas anual: um tick por ano (posicionado no 1º trimestre\n","    #      disponível daquele ano), sem rotação, mostrando só o ano ----\n","    ticks_pos, ticks_labels = [], []\n","    for ano in sorted(df_plot[\"_Ano\"].unique()):\n","        idx_ano = df_plot.index[df_plot[\"_Ano\"] == ano]\n","        primeiro_idx = idx_ano[0]\n","        ticks_pos.append(df_plot.loc[primeiro_idx, \"Periodo\"])\n","        ticks_labels.append(str(ano))\n","    ax.set_xticks(ticks_pos)\n","    ax.set_xticklabels(ticks_labels, rotation=0, ha=\"center\")\n","\n","    # Eixo Y não começa em zero (mas nunca fica negativo)\n","    valores = df_plot[colunas].values.flatten()\n","    valores = valores[~pd.isna(valores)]\n","\n","    if len(valores) > 0:\n","        y_min_obs, y_max_obs = np.min(valores), np.max(valores)\n","        amplitude = y_max_obs - y_min_obs\n","        margem = amplitude * 0.08 if amplitude > 0 else abs(y_min_obs) * 0.05\n","\n","        y_inf = max(y_min_obs - margem, 0)\n","        y_sup = y_max_obs + margem\n","        ax.set_ylim(y_inf, y_sup)\n","\n","    ax.legend(\n","        loc=\"upper center\", bbox_to_anchor=(0.5, -0.14),\n","        ncol=ncol_legenda, fontsize=19, frameon=True,\n","        markerscale=1.8, handlelength=3,\n","    )\n","    fig.text(0.01, -0.03, FONTE, fontsize=9, color=\"gray\", style=\"italic\")\n","    plt.tight_layout()\n","    fig.canvas.draw()\n","\n","    _desenhar_rotulos(ax, fig, df_plot, colunas, lines)\n","\n","    for sufixo, dpi in [(\"300dpi\", 300), (\"100dpi\", 100)]:\n","        fname = f\"{nome_arquivo}_{sufixo}.png\"\n","        plt.savefig(fname, dpi=dpi, bbox_inches=\"tight\")\n","        print(f\"Salvo: {fname}\")\n","\n","    plt.show()\n","    plt.close()\n","\n","\n","def _desenhar_rotulos(ax, fig, df_plot, colunas, lines, min_gap_pt=20, font_size=11):\n","    \"\"\"Desenha os rótulos numéricos apenas no 4º trimestre, evitando sobreposição.\"\"\"\n","\n","    y_min, y_max = ax.get_ylim()\n","    ax_height_pt = ax.get_window_extent().height * 72 / fig.dpi\n","    pts_por_unidade = ax_height_pt / (y_max - y_min)\n","\n","    indices_rotulos = df_plot.index[df_plot[\"_Trimestre\"] == 4].tolist()\n","\n","    for idx in indices_rotulos:\n","        pontos = [\n","            (df_plot.loc[idx, col], col)\n","            for col in colunas\n","            if pd.notna(df_plot.loc[idx, col])\n","        ]\n","        if not pontos:\n","            continue\n","\n","        pontos = sorted(pontos, key=lambda x: x[0], reverse=True)\n","\n","        label_pos_pt = []\n","        for k, (val, _col) in enumerate(pontos):\n","            val_pt = val * pts_por_unidade\n","            if k == 0:\n","                pos = val_pt + min_gap_pt\n","            else:\n","                pos = min(val_pt - min_gap_pt, label_pos_pt[k - 1] - min_gap_pt)\n","            label_pos_pt.append(pos)\n","\n","        for k, (val, col) in enumerate(pontos):\n","            val_pt = val * pts_por_unidade\n","            offset_y = label_pos_pt[k] - val_pt\n","            va = \"bottom\" if offset_y >= 0 else \"top\"\n","\n","            ax.annotate(\n","                f\"{val:.1f}\",\n","                (df_plot.loc[idx, \"Periodo\"], val),\n","                textcoords=\"offset points\",\n","                xytext=(0, offset_y),\n","                ha=\"center\", va=va,\n","                fontsize=font_size,\n","                color=lines[col].get_color(),\n","                fontweight=\"bold\",\n","            )\n","\n","\n","# ==========================================================\n","# 5) CONFIGURAÇÃO DOS 7 GRÁFICOS (antes eram ~700 linhas repetidas)\n","# ==========================================================\n","\n","def gerar_colunas(prefixo=None):\n","    if prefixo is None:\n","        return REGIOES + [\"Brasil\"]\n","    return [f\"{prefixo}_{r}\" for r in REGIOES] + [f\"Brasil_{prefixo}\"]\n","\n","\n","GRAFICOS = [\n","    dict(colunas=gerar_colunas(), titulo=\"Evolução do Salário Médio por Hora Real — por Região (Brasil)\",\n","         arquivo=\"grafico_1_evolucao_regiao\"),\n","    dict(colunas=gerar_colunas(\"Homem\"), titulo=\"Evolução do Salário Médio por Hora Real — Homens por Região (Brasil)\",\n","         arquivo=\"grafico_2_homens_regiao\"),\n","    dict(colunas=gerar_colunas(\"Mulher\"), titulo=\"Evolução do Salário Médio por Hora Real — Mulheres por Região (Brasil)\",\n","         arquivo=\"grafico_3_mulheres_regiao\"),\n","    dict(colunas=gerar_colunas(\"Formal\"), titulo=\"Evolução do Salário Médio por Hora Real — Trabalhadores Formais por Região (Brasil)\",\n","         arquivo=\"grafico_4_formal_regiao\"),\n","    dict(colunas=gerar_colunas(\"Informal\"), titulo=\"Evolução do Salário Médio por Hora Real — Trabalhadores Informais por Região (Brasil)\",\n","         arquivo=\"grafico_5_informal_regiao\"),\n","    dict(colunas=gerar_colunas(\"Publico\"), titulo=\"Evolução do Salário Médio por Hora Real — Setor Público por Região (Brasil)\",\n","         arquivo=\"grafico_6_publico_regiao\"),\n","    dict(colunas=gerar_colunas(\"Privado\"), titulo=\"Evolução do Salário Médio por Hora Real — Setor Privado por Região (Brasil)\",\n","         arquivo=\"grafico_7_privado_regiao\"),\n","]\n","\n","\n","def gerar_todos_os_graficos(df_res):\n","    for cfg in GRAFICOS:\n","        plot_salario(\n","            df_plot=df_res[[\"Periodo\"] + cfg[\"colunas\"]],\n","            colunas=cfg[\"colunas\"],\n","            titulo=cfg[\"titulo\"],\n","            nome_arquivo=cfg[\"arquivo\"],\n","        )\n","    print(f\"\\nTotal de gráficos gerados: {len(GRAFICOS)}\")\n","\n","\n","# ==========================================================\n","# 6) VALIDAÇÃO — Brasil precisa estar dentro do intervalo regional\n","# ==========================================================\n","\n","def validar_brasil(df, colunas_regioes, coluna_brasil):\n","    erros = []\n","\n","    for _, row in df.iterrows():\n","        valores = [row[c] for c in colunas_regioes if pd.notna(row[c])]\n","        if not valores or pd.isna(row[coluna_brasil]):\n","            continue\n","\n","        minimo, maximo, brasil = min(valores), max(valores), row[coluna_brasil]\n","        if brasil < minimo or brasil > maximo:\n","            erros.append({\n","                \"Periodo\": row[\"Periodo\"],\n","                \"Brasil\": brasil,\n","                \"Min_Regiao\": minimo,\n","                \"Max_Regiao\": maximo,\n","            })\n","\n","    return pd.DataFrame(erros)\n","\n","\n","VALIDACOES_CFG = [\n","    (\"Geral\", None),\n","    (\"Homens\", \"Homem\"),\n","    (\"Mulheres\", \"Mulher\"),\n","    (\"Formal\", \"Formal\"),\n","    (\"Informal\", \"Informal\"),\n","    (\"Público\", \"Publico\"),\n","    (\"Privado\", \"Privado\"),\n","]\n","\n","\n","def rodar_validacoes(df_res):\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"VALIDAÇÃO DAS MÉDIAS BRASIL\")\n","    print(\"=\" * 70)\n","\n","    for nome, prefixo in VALIDACOES_CFG:\n","        colunas_regioes = gerar_colunas(prefixo)[:-1]  # remove o \"Brasil\" do fim\n","        coluna_brasil = \"Brasil\" if prefixo is None else f\"Brasil_{prefixo}\"\n","\n","        erros = validar_brasil(df_res, colunas_regioes, coluna_brasil)\n","\n","        if len(erros) == 0:\n","            print(f\"✓ {nome}: Brasil está dentro do intervalo das médias regionais em todos os períodos.\")\n","        else:\n","            print(f\"⚠ {nome}: {len(erros)} período(s) fora do intervalo regional.\")\n","            print(erros.head(10))\n","\n","\n","# ==========================================================\n","# 7) COMPARAÇÃO FINAL — ÚLTIMO PERÍODO\n","# ==========================================================\n","\n","GRUPOS_COMPARACAO = [\n","    (\"SETOR PÚBLICO\", \"Publico\"),\n","    (\"SETOR PRIVADO\", \"Privado\"),\n","    (\"HOMENS\", \"Homem\"),\n","    (\"MULHERES\", \"Mulher\"),\n","    (\"FORMAL\", \"Formal\"),\n","    (\"INFORMAL\", \"Informal\"),\n","]\n","\n","\n","def imprimir_comparacao_final(df_res):\n","    ultimo = df_res.iloc[-1]\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(f\"COMPARAÇÃO NO ÚLTIMO PERÍODO: {ultimo['Periodo']}\")\n","    print(\"=\" * 70)\n","\n","    for titulo, prefixo in GRUPOS_COMPARACAO:\n","        print(f\"\\n{titulo}:\")\n","        for reg in REGIOES:\n","            print(f\"{reg:15s}: R$ {ultimo[f'{prefixo}_{reg}']:.2f}\")\n","        print(f\"{'Brasil':15s}: R$ {ultimo[f'Brasil_{prefixo}']:.2f}\")\n","\n","\n","# ==========================================================\n","# MAIN\n","# ==========================================================\n","\n","def main():\n","    df = carregar_base(FILE_PATH)\n","\n","    periodos_ordenados = (\n","        df[[\"Ano\", \"Trimestre\", \"Periodo\"]]\n","        .drop_duplicates()\n","        .sort_values([\"Ano\", \"Trimestre\"])[\"Periodo\"]\n","        .tolist()\n","    )\n","    print(\"\\nPeríodos encontrados:\")\n","    print(periodos_ordenados)\n","    print(f\"\\nTotal de períodos: {len(periodos_ordenados)}\")\n","\n","    df[\"Salario_Hora\"] = calcular_salario_hora(df)\n","    df = classificar_grupos(df)\n","\n","    df_res = montar_df_resultados(df, periodos_ordenados)\n","\n","    gerar_todos_os_graficos(df_res)\n","    rodar_validacoes(df_res)\n","    imprimir_comparacao_final(df_res)\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"PROCESSAMENTO CONCLUÍDO\")\n","    print(\"=\" * 70)\n","\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1Tr_yWfkF45Kkv7VxdiR7C8vxoPOz4oo6"},"id":"oR1L22CkJxTs","executionInfo":{"status":"ok","timestamp":1787347608431,"user_tz":180,"elapsed":99448,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"8ea36dce-44b1-4ea9-daba-e410af1120ba"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}]},{"cell_type":"code","source":["import gc\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.ticker as mticker\n","\n","# ==========================================================\n","# 1) Leitura e preparação (otimizado p/ memória)\n","# ==========================================================\n","\n","file_path = '/content/pnad_consolidada_2013_2025.parquet'\n","\n","# Só lê as colunas realmente usadas -- evita carregar o parquet inteiro na RAM\n","COLUNAS_NECESSARIAS = [\n","    \"Ano\", \"Trimestre\", \"Horas_hab_trabalhadas\",\n","    \"Rendimento_hab_Trab_princ\", \"Anos_de_Estudo\", \"Regiao\",\n","]\n","df = pd.read_parquet(file_path, columns=COLUNAS_NECESSARIAS, engine=\"pyarrow\")\n","\n","# Filtra ANTES de criar colunas novas, para não processar linhas inúteis\n","mask_valido = (\n","    df[\"Horas_hab_trabalhadas\"].replace(0, np.nan).notna() &\n","    df[\"Rendimento_hab_Trab_princ\"].notna() &\n","    df[\"Anos_de_Estudo\"].between(0, 16) &          # já aplica o topcode aqui\n","    df[\"Regiao\"].notna()\n",")\n","df = df.loc[mask_valido, COLUNAS_NECESSARIAS]\n","gc.collect()\n","\n","# Dtypes compactos -- reduz bastante o footprint em RAM\n","df[\"Ano\"] = df[\"Ano\"].astype(\"int16\")\n","df[\"Trimestre\"] = df[\"Trimestre\"].astype(\"int8\")\n","df[\"Anos_de_Estudo\"] = df[\"Anos_de_Estudo\"].astype(\"int8\")\n","df[\"Regiao\"] = df[\"Regiao\"].astype(\"category\")\n","\n","# Salário/hora em float32 (metade do espaço de um float64)\n","df[\"Salario_Hora\"] = (\n","    df[\"Rendimento_hab_Trab_princ\"].astype(\"float32\")\n","    / (df[\"Horas_hab_trabalhadas\"].astype(\"float32\") * np.float32(4.33))\n",")\n","\n","# \"Periodo\" como category evita repetir a mesma string milhões de vezes\n","df[\"Periodo\"] = (\n","    df[\"Ano\"].astype(str) + \".\" + df[\"Trimestre\"].astype(str)\n",").astype(\"category\")\n","\n","# Colunas que não são mais necessárias em formato bruto\n","df = df.drop(columns=[\"Rendimento_hab_Trab_princ\", \"Horas_hab_trabalhadas\"])\n","gc.collect()\n","\n","FONTE = \"Fonte: PNAD Contínua – IBGE (2013–2025). Valores deflacionados pelo IPCA (Base: Jan/2026).\"\n","\n","# ==========================================================\n","# 2) Faixas de escolaridade\n","# ==========================================================\n","\n","FAIXAS = [\n","    (0, 4,  \"0 a 4 anos (Fund. incompleto)\"),\n","    (5, 8,  \"5 a 8 anos (Fund. completo)\"),\n","    (9, 11, \"9 a 11 anos (Médio)\"),\n","    (12, 14, \"12 a 14 anos (Sup. incompleto)\"),\n","    (15, 16, \"15 a 16 anos (Sup. completo+)\"),\n","]\n","\n","\n","# mapeamento vetorizado (evita apply linha-a-linha, que é caro em RAM/CPU)\n","bins = [lo for lo, _, _ in FAIXAS] + [FAIXAS[-1][1] + 1]\n","labels_faixas = [label for _, _, label in FAIXAS]\n","df[\"Faixa_Estudo\"] = pd.cut(\n","    df[\"Anos_de_Estudo\"], bins=bins, labels=labels_faixas,\n","    right=False, include_lowest=True,\n",").astype(\"category\")\n","\n","periodos_ordenados = (\n","    df[[\"Ano\", \"Trimestre\", \"Periodo\"]]\n","    .drop_duplicates()\n","    .sort_values([\"Ano\", \"Trimestre\"])\n","    [\"Periodo\"]\n","    .astype(str)\n","    .tolist()\n",")\n","\n","colunas_faixas = [label for _, _, label in FAIXAS]\n","regioes_ordenadas = sorted(df[\"Regiao\"].dropna().unique().tolist())\n","\n","# ------------------------------------------------------------\n","# Média Brasil, por Período x Faixa (linha de referência em todos os gráficos)\n","# ------------------------------------------------------------\n","tab_faixas_brasil = (\n","    df.groupby([\"Periodo\", \"Faixa_Estudo\"], observed=True)[\"Salario_Hora\"]\n","    .mean()\n","    .round(2)\n","    .unstack(\"Faixa_Estudo\")\n","    .reindex(periodos_ordenados)[colunas_faixas]\n",")\n","\n","# ------------------------------------------------------------\n","# Média por Região, Período x Faixa\n","# ------------------------------------------------------------\n","tab_faixas_regiao = (\n","    df.groupby([\"Periodo\", \"Faixa_Estudo\", \"Regiao\"], observed=True)[\"Salario_Hora\"]\n","    .mean()\n","    .round(2)\n","    .unstack(\"Regiao\")\n","    .reindex(periodos_ordenados, level=\"Periodo\")\n",")\n","\n","# A partir daqui só usamos as tabelas agregadas (muito menores) -- libera o df bruto\n","del df\n","gc.collect()\n","\n","\n","# ==========================================================\n","# 3) Função genérica de plot: evolução por região + média Brasil,\n","#    TODAS as faixas selecionadas juntas em um único gráfico\n","#    (cor = região / Brasil, estilo de linha = faixa de escolaridade)\n","# ==========================================================\n","\n","LINESTYLES = [\"-\", \"--\", \"-.\", \":\", (0, (3, 1, 1, 1))]\n","\n","\n","def plot_evolucao_regioes(faixas_selecionadas, nome_arquivo, figsize=(18, 10)):\n","    fig, ax = plt.subplots(figsize=figsize, dpi=300)\n","\n","    cmap = plt.get_cmap(\"tab10\")\n","    cores_regiao = {reg: cmap(i % 10) for i, reg in enumerate(regioes_ordenadas)}\n","    faixa_linestyle = {faixa: LINESTYLES[i % len(LINESTYLES)]\n","                        for i, faixa in enumerate(faixas_selecionadas)}\n","\n","    # Posições (no eixo x categórico) referentes ao último trimestre de cada ano\n","    idx_ultimo_tri = [pos for pos, periodo in enumerate(periodos_ordenados)\n","                       if periodo.split(\".\")[-1] == \"4\"]\n","\n","    for faixa in faixas_selecionadas:\n","        ls = faixa_linestyle[faixa]\n","\n","        # Linhas por região\n","        sub = tab_faixas_regiao.xs(faixa, level=\"Faixa_Estudo\").reindex(periodos_ordenados)\n","        for regiao in regioes_ordenadas:\n","            if regiao not in sub.columns:\n","                continue\n","            valores = sub[regiao].values\n","            ax.plot(periodos_ordenados, valores, marker=\"o\", markersize=7,\n","                    linewidth=3, linestyle=ls, color=cores_regiao[regiao],\n","                    alpha=0.85, label=f\"{regiao} — {faixa}\")\n","\n","            for pos in idx_ultimo_tri:\n","                v = valores[pos]\n","                if pd.isna(v):\n","                    continue\n","                ax.annotate(f\"{v:.0f}\", (pos, v), textcoords=\"offset points\",\n","                            xytext=(0, 5), ha=\"center\", fontsize=11,\n","                            color=cores_regiao[regiao])\n","\n","        # Linha Brasil (destacada, sempre preta, mesmo estilo da faixa)\n","        valores_brasil = tab_faixas_brasil[faixa].values\n","        ax.plot(periodos_ordenados, valores_brasil,\n","                marker=\"o\", markersize=7, linewidth=3,\n","                linestyle=ls, color=\"black\", label=f\"Brasil (média) — {faixa}\", zorder=10)\n","\n","        for pos in idx_ultimo_tri:\n","            v = valores_brasil[pos]\n","            if pd.isna(v):\n","                continue\n","            ax.annotate(f\"{v:.0f}\", (pos, v), textcoords=\"offset points\",\n","                        xytext=(0, 8), ha=\"center\", fontsize=11,\n","                        fontweight=\"bold\", color=\"black\", zorder=11)\n","\n","    ax.set_title(\"Evolução do Salário Médio por Hora Real, por Região (Brasil)\",\n","                 fontsize=22, pad=24, fontweight=\"bold\")\n","    ax.set_ylabel(\"Salário médio por hora (R$ reais, Base Jan/2026)\", fontsize=13)\n","    ax.set_xlabel(\"Ano\", fontsize=13)\n","    ax.grid(True, axis=\"both\", alpha=0.25, linewidth=0.6)\n","    ax.set_axisbelow(True)\n","    ax.tick_params(axis=\"x\", rotation=45, labelsize=8)\n","    ax.tick_params(axis=\"y\", labelsize=11)\n","    ax.yaxis.set_major_formatter(mticker.FormatStrFormatter('R$ %.0f'))\n","\n","    # Eixo x: mostra apenas o ano (um rótulo por ano, no último trimestre)\n","    anos_labels = [periodos_ordenados[pos].split(\".\")[0] for pos in idx_ultimo_tri]\n","    ax.set_xticks(idx_ultimo_tri)\n","    ax.set_xticklabels(anos_labels, rotation=0)\n","\n","    handles, labels = ax.get_legend_handles_labels()\n","    ax.legend(handles, labels, loc=\"upper center\", bbox_to_anchor=(0.5, -0.16),\n","              ncol=min(len(regioes_ordenadas) + 1, 3), fontsize=11,\n","              frameon=True, markerscale=1.2, handlelength=5, handletextpad=0.8,\n","              columnspacing=1.2)\n","\n","    fig.text(0.01, -0.02, FONTE, fontsize=9, color=\"gray\", style=\"italic\")\n","    plt.tight_layout()\n","\n","    for sufixo, dpi in [(\"300dpi\", 300), (\"100dpi\", 100)]:\n","        fname = f\"{nome_arquivo}_{sufixo}.png\"\n","        plt.savefig(fname, dpi=dpi, bbox_inches=\"tight\")\n","        print(f\"Salvo: {fname}\")\n","\n","    plt.show()\n","    plt.close()\n","\n","\n","# ==========================================================\n","# 4) GRÁFICO -- apenas Fund. incompleto e Superior completo+, por região + Brasil,\n","#    combinadas em um único gráfico\n","# ==========================================================\n","\n","faixas_extremos = [\n","    \"0 a 4 anos (Fund. incompleto)\",\n","    \"15 a 16 anos (Sup. completo+)\",\n","]\n","\n","plot_evolucao_regioes(faixas_extremos, nome_arquivo=\"grafico_evolucao_extremos_regioes\",\n","                       figsize=(18, 10))\n","\n","print(\"\\nGráficos gerados com sucesso!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":530},"id":"F55C3t-zNYNQ","executionInfo":{"status":"ok","timestamp":1787347637219,"user_tz":180,"elapsed":18419,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"71cb73ce-c769-47d4-9548-447ef9a27e7f"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Salvo: grafico_evolucao_extremos_regioes_300dpi.png\n","Salvo: grafico_evolucao_extremos_regioes_100dpi.png\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 5400x3000 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Gráficos gerados com sucesso!\n"]}]},{"cell_type":"code","source":["\"\"\"\n","Evolução do salário médio por hora real — PNAD Contínua (2013-2025)\n","\n","Versão otimizada:\n","  - Corrige o fator de conversão semana -> mês (era *4, o correto é 52/12).\n","  - Substitui os loops aninhados (período x sexo/setor/formalidade x região)\n","    por agregações vetorizadas com groupby/unstack.\n","  - Elimina a duplicação nos gráficos, nas validações e no relatório\n","    final, todos agora dirigidos por pequenas listas de configuração.\n","\n","Ajustes de visualização (a pedido do usuário):\n","  - Legendas maiores.\n","  - Eixo X mostrando apenas o ano (não mais ano.trimestre).\n","  - Fontes dos rótulos e ticks dos eixos X/Y maiores.\n","  - Os gráficos por Homem/Mulher, Formal/Informal e Público/Privado foram\n","    agrupados em 3 PNGs (um por dupla), cada PNG com os 2 gráficos\n","    empilhados (um embaixo do outro). Cada gráfico mantém seu PRÓPRIO\n","    título e sua PRÓPRIA legenda.\n","\"\"\"\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import matplotlib.ticker as mticker\n","\n","# ==========================================================\n","# CONSTANTES\n","# ==========================================================\n","\n","FILE_PATH = \"/content/pnad_consolidada_2013_2025.parquet\"\n","\n","REGIOES = [\"Norte\", \"Nordeste\", \"Sudeste\", \"Sul\", \"Centro-Oeste\"]\n","\n","# BUG CORRIGIDO: um mês tem em média 52/12 semanas (~4,345), não 4.\n","# Usar *4 inflava o salário/hora estimado em ~8,6% em todas as séries.\n","SEMANAS_POR_MES = 4.33\n","\n","FONTE = (\n","    \"Fonte: PNAD Contínua – IBGE (2013–2025). \"\n","    \"Valores deflacionados pelo IPCA (Base: Jan/2026).\"\n",")\n","\n","YLABEL_PADRAO = \"Salário médio por hora (R$ reais, Base Jan/2026)\"\n","XLABEL_PADRAO = \"Ano\"\n","\n","\n","# ==========================================================\n","# 1) LEITURA E PREPARAÇÃO DA BASE\n","# ==========================================================\n","\n","def carregar_base(file_path):\n","    df = pd.read_parquet(file_path)\n","\n","    print(\"=\" * 70)\n","    print(\"BASE CARREGADA\")\n","    print(\"=\" * 70)\n","    print(f\"Observações: {len(df):,}\")\n","    print(f\"Colunas: {len(df.columns)}\")\n","    print(f\"\\nPeríodo: {df['Ano'].min()} até {df['Ano'].max()}\")\n","\n","    df[\"Periodo\"] = df[\"Ano\"].astype(str) + \".\" + df[\"Trimestre\"].astype(str)\n","    return df\n","\n","\n","def calcular_salario_hora(df):\n","    \"\"\"Calcula o salário/hora linha a linha, de forma vetorizada.\"\"\"\n","    horas = df[\"Horas_hab_trabalhadas\"].replace(0, np.nan)\n","    rendimento = df[\"Rendimento_hab_Trab_princ\"]\n","\n","    valido = horas.notna() & rendimento.notna()\n","\n","    salario_hora = pd.Series(np.nan, index=df.index)\n","    salario_hora[valido] = rendimento[valido] / (horas[valido] * SEMANAS_POR_MES)\n","    return salario_hora\n","\n","\n","def classificar_grupos(df):\n","    \"\"\"Cria as colunas de corte: Sexo_Grupo, Setor e Formalidade.\"\"\"\n","\n","    df[\"Sexo_Grupo\"] = df[\"Sexo\"].map({1: \"Homem\", 2: \"Mulher\"})\n","\n","    df[\"Setor\"] = np.where(\n","        df[\"Categoria_emprego\"].isin([5, 6, 7]), \"Publico\", \"Privado\"\n","    )\n","\n","    formal = df[\"Categoria_emprego\"].isin([1, 3, 5, 7]) | (\n","        df[\"Categoria_emprego\"].isin([8, 9])\n","        & (df[\"Contribuicao_previdencia\"] == 1)\n","    )\n","    informal = df[\"Categoria_emprego\"].isin([2, 4, 6, 10]) | (\n","        df[\"Categoria_emprego\"].isin([8, 9])\n","        & (df[\"Contribuicao_previdencia\"] == 2)\n","    )\n","    df[\"Formalidade\"] = np.select([formal, informal], [\"Formal\", \"Informal\"], default=None)\n","\n","    return df\n","\n","\n","# ==========================================================\n","# 2) AGREGAÇÃO (VETORIZADA)\n","# ==========================================================\n","\n","def agregar_dimensao(df, periodos_ordenados, coluna_corte=None, categorias=None):\n","    \"\"\"\n","    Agrega o salário/hora médio por Período x Região, com um corte opcional\n","    (Sexo_Grupo, Setor ou Formalidade).\n","\n","    Sem corte -> colunas: Norte, Nordeste, ..., Brasil\n","    Com corte -> colunas: {categoria}_{regiao}, ..., Brasil_{categoria}\n","    \"\"\"\n","    resultado = pd.DataFrame(index=pd.Index(periodos_ordenados, name=\"Periodo\"))\n","\n","    if coluna_corte is None:\n","        tabela = (\n","            df.groupby([\"Periodo\", \"Regiao\"])[\"Salario_Hora\"]\n","            .mean()\n","            .round(2)\n","            .unstack(\"Regiao\")\n","        )\n","        for reg in REGIOES:\n","            resultado[reg] = tabela.get(reg)\n","        resultado[\"Brasil\"] = df.groupby(\"Periodo\")[\"Salario_Hora\"].mean().round(2)\n","        return resultado\n","\n","    for cat in categorias:\n","        sub = df[df[coluna_corte] == cat]\n","        tabela = (\n","            sub.groupby([\"Periodo\", \"Regiao\"])[\"Salario_Hora\"]\n","            .mean()\n","            .round(2)\n","            .unstack(\"Regiao\")\n","        )\n","        for reg in REGIOES:\n","            resultado[f\"{cat}_{reg}\"] = tabela.get(reg)\n","        resultado[f\"Brasil_{cat}\"] = sub.groupby(\"Periodo\")[\"Salario_Hora\"].mean().round(2)\n","\n","    return resultado\n","\n","\n","def montar_df_resultados(df, periodos_ordenados):\n","    partes = [\n","        agregar_dimensao(df, periodos_ordenados),\n","        agregar_dimensao(df, periodos_ordenados, \"Sexo_Grupo\", [\"Homem\", \"Mulher\"]),\n","        agregar_dimensao(df, periodos_ordenados, \"Setor\", [\"Publico\", \"Privado\"]),\n","        agregar_dimensao(df, periodos_ordenados, \"Formalidade\", [\"Formal\", \"Informal\"]),\n","    ]\n","    df_res = pd.concat(partes, axis=1).reset_index()\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"DATAFRAME DE RESULTADOS\")\n","    print(\"=\" * 70)\n","    print(f\"Períodos calculados: {len(df_res)}\")\n","    print(f\"Colunas calculadas: {len(df_res.columns)}\")\n","    print(\"\\nPrimeiros resultados:\")\n","    print(df_res.head(3))\n","\n","    return df_res\n","\n","\n","# ==========================================================\n","# 3) NOMES DAS LEGENDAS (gerados, não digitados um a um)\n","# ==========================================================\n","\n","def montar_nomes_legenda():\n","    nomes = {reg: reg for reg in REGIOES}\n","    nomes[\"Brasil\"] = \"Brasil\"\n","\n","    for prefixo in [\"Homem\", \"Mulher\", \"Publico\", \"Privado\", \"Formal\", \"Informal\"]:\n","        for reg in REGIOES:\n","            nomes[f\"{prefixo}_{reg}\"] = reg\n","        nomes[f\"Brasil_{prefixo}\"] = \"Brasil\"\n","\n","    return nomes\n","\n","\n","NOMES_LEGENDA = montar_nomes_legenda()\n","\n","\n","# ==========================================================\n","# 4) FUNÇÃO DE PLOTAGEM — gráfico único (usada para o gráfico geral)\n","# ==========================================================\n","\n","def plot_salario(df_plot, colunas, titulo, nome_arquivo, ncol_legenda=3,\n","                  ylabel=YLABEL_PADRAO, xlabel=XLABEL_PADRAO):\n","\n","    df_plot = df_plot.copy()\n","    periodo_split = df_plot[\"Periodo\"].astype(str).str.split(\".\", expand=True)\n","    df_plot[\"_Ano\"] = periodo_split[0].astype(int)\n","    df_plot[\"_Trimestre\"] = periodo_split[1].astype(int)\n","\n","    fig, ax = plt.subplots(figsize=(26, 11), dpi=300)\n","\n","    lines = {}\n","    for col in colunas:\n","        label = NOMES_LEGENDA.get(col, col)\n","        (line,) = ax.plot(\n","            df_plot[\"Periodo\"], df_plot[col],\n","            marker=\"o\", markersize=7, linewidth=3, label=label,\n","        )\n","        lines[col] = line\n","\n","    ax.set_title(titulo, fontsize=28, pad=28, fontweight=\"bold\")\n","    ax.set_ylabel(ylabel, fontsize=23)\n","    ax.set_xlabel(xlabel, fontsize=23)\n","    ax.grid(True, which=\"major\", axis=\"both\", linestyle=\"--\", linewidth=0.7, alpha=0.5)\n","    ax.tick_params(axis=\"x\", labelsize=20)\n","    ax.tick_params(axis=\"y\", labelsize=21)\n","    ax.yaxis.set_major_formatter(mticker.FormatStrFormatter(\"R$ %.0f\"))\n","\n","    # ---- Eixo X apenas anual: um tick por ano (posicionado no 1º trimestre\n","    #      disponível daquele ano), sem rotação, mostrando só o ano ----\n","    ticks_pos, ticks_labels = [], []\n","    for ano in sorted(df_plot[\"_Ano\"].unique()):\n","        idx_ano = df_plot.index[df_plot[\"_Ano\"] == ano]\n","        primeiro_idx = idx_ano[0]\n","        ticks_pos.append(df_plot.loc[primeiro_idx, \"Periodo\"])\n","        ticks_labels.append(str(ano))\n","    ax.set_xticks(ticks_pos)\n","    ax.set_xticklabels(ticks_labels, rotation=0, ha=\"center\")\n","\n","    # Eixo Y não começa em zero (mas nunca fica negativo)\n","    valores = df_plot[colunas].values.flatten()\n","    valores = valores[~pd.isna(valores)]\n","\n","    if len(valores) > 0:\n","        y_min_obs, y_max_obs = np.min(valores), np.max(valores)\n","        amplitude = y_max_obs - y_min_obs\n","        margem = amplitude * 0.08 if amplitude > 0 else abs(y_min_obs) * 0.05\n","\n","        y_inf = max(y_min_obs - margem, 0)\n","        y_sup = y_max_obs + margem\n","        ax.set_ylim(y_inf, y_sup)\n","\n","    ax.legend(\n","        loc=\"upper center\", bbox_to_anchor=(0.5, -0.14),\n","        ncol=ncol_legenda, fontsize=22, frameon=True,\n","        markerscale=1.8, handlelength=3,\n","    )\n","    fig.text(0.01, -0.03, FONTE, fontsize=12, color=\"gray\", style=\"italic\")\n","    plt.tight_layout()\n","    fig.canvas.draw()\n","\n","    _desenhar_rotulos(ax, fig, df_plot, colunas, lines)\n","\n","    for sufixo, dpi in [(\"300dpi\", 300), (\"100dpi\", 100)]:\n","        fname = f\"{nome_arquivo}_{sufixo}.png\"\n","        plt.savefig(fname, dpi=dpi, bbox_inches=\"tight\")\n","        print(f\"Salvo: {fname}\")\n","\n","    plt.show()\n","    plt.close()\n","\n","\n","def _desenhar_rotulos(ax, fig, df_plot, colunas, lines, min_gap_pt=20, font_size=14):\n","    \"\"\"Desenha os rótulos numéricos apenas no 4º trimestre, evitando sobreposição.\"\"\"\n","\n","    y_min, y_max = ax.get_ylim()\n","    ax_height_pt = ax.get_window_extent().height * 72 / fig.dpi\n","    pts_por_unidade = ax_height_pt / (y_max - y_min)\n","\n","    indices_rotulos = df_plot.index[df_plot[\"_Trimestre\"] == 4].tolist()\n","\n","    for idx in indices_rotulos:\n","        pontos = [\n","            (df_plot.loc[idx, col], col)\n","            for col in colunas\n","            if pd.notna(df_plot.loc[idx, col])\n","        ]\n","        if not pontos:\n","            continue\n","\n","        pontos = sorted(pontos, key=lambda x: x[0], reverse=True)\n","\n","        label_pos_pt = []\n","        for k, (val, _col) in enumerate(pontos):\n","            val_pt = val * pts_por_unidade\n","            if k == 0:\n","                pos = val_pt + min_gap_pt\n","            else:\n","                pos = min(val_pt - min_gap_pt, label_pos_pt[k - 1] - min_gap_pt)\n","            label_pos_pt.append(pos)\n","\n","        for k, (val, col) in enumerate(pontos):\n","            val_pt = val * pts_por_unidade\n","            offset_y = label_pos_pt[k] - val_pt\n","            va = \"bottom\" if offset_y >= 0 else \"top\"\n","\n","            ax.annotate(\n","                f\"{val:.1f}\",\n","                (df_plot.loc[idx, \"Periodo\"], val),\n","                textcoords=\"offset points\",\n","                xytext=(0, offset_y),\n","                ha=\"center\", va=va,\n","                fontsize=font_size,\n","                color=lines[col].get_color(),\n","                fontweight=\"bold\",\n","            )\n","\n","\n","# ==========================================================\n","# 5) GRÁFICO GERAL (por região, sem corte)\n","# ==========================================================\n","\n","def gerar_colunas(prefixo=None):\n","    if prefixo is None:\n","        return REGIOES + [\"Brasil\"]\n","    return [f\"{prefixo}_{r}\" for r in REGIOES] + [f\"Brasil_{prefixo}\"]\n","\n","\n","GRAFICO_GERAL = dict(\n","    colunas=gerar_colunas(),\n","    titulo=\"Evolução do Salário Médio por Hora Real — por Região (Brasil)\",\n","    arquivo=\"grafico_1_evolucao_regiao\",\n",")\n","\n","\n","def gerar_grafico_geral(df_res):\n","    plot_salario(\n","        df_plot=df_res[[\"Periodo\"] + GRAFICO_GERAL[\"colunas\"]],\n","        colunas=GRAFICO_GERAL[\"colunas\"],\n","        titulo=GRAFICO_GERAL[\"titulo\"],\n","        nome_arquivo=GRAFICO_GERAL[\"arquivo\"],\n","    )\n","\n","\n","# ==========================================================\n","# 5b) PARES DE GRÁFICOS EMPILHADOS — um PNG por dupla (sexo, formalidade,\n","#     setor), com os 2 gráficos um embaixo do outro. Cada gráfico\n","#     (subplot) mantém o seu PRÓPRIO título e a sua PRÓPRIA legenda —\n","#     ou seja, cada PNG tem 2 títulos e 2 legendas (um par por PNG).\n","# ==========================================================\n","\n","PARES_GRAFICOS = [\n","    dict(\n","        nome_arquivo=\"grafico_sexo_regiao\",\n","        titulo=\"Evolução do Salário Médio por Hora Real — Homens e Mulheres por Região (Brasil)\",\n","        graficos=[\n","            dict(prefixo=\"Homem\", rotulo=\"Homens\"),\n","            dict(prefixo=\"Mulher\", rotulo=\"Mulheres\"),\n","        ],\n","    ),\n","    dict(\n","        nome_arquivo=\"grafico_formalidade_regiao\",\n","        titulo=\"Evolução do Salário Médio por Hora Real — Formal e Informal por Região (Brasil)\",\n","        graficos=[\n","            dict(prefixo=\"Formal\", rotulo=\"Formal\"),\n","            dict(prefixo=\"Informal\", rotulo=\"Informal\"),\n","        ],\n","    ),\n","    dict(\n","        nome_arquivo=\"grafico_setor_regiao\",\n","        titulo=\"Evolução do Salário Médio por Hora Real — Público e Privado por Região (Brasil)\",\n","        graficos=[\n","            dict(prefixo=\"Publico\", rotulo=\"Setor Público\"),\n","            dict(prefixo=\"Privado\", rotulo=\"Setor Privado\"),\n","        ],\n","    ),\n","]\n","\n","\n","def _preparar_eixo_temporal(df_plot):\n","    df_plot = df_plot.copy()\n","    periodo_split = df_plot[\"Periodo\"].astype(str).str.split(\".\", expand=True)\n","    df_plot[\"_Ano\"] = periodo_split[0].astype(int)\n","    df_plot[\"_Trimestre\"] = periodo_split[1].astype(int)\n","    return df_plot\n","\n","\n","def _plotar_subplot(ax, fig, df_plot, colunas, rotulo, cor_regiao):\n","    \"\"\"Desenha um gráfico (região x Brasil) em um eixo (subplot) já existente,\n","    incluindo os rótulos numéricos no último trimestre de cada ano.\n","    SEM título e SEM legenda próprios — título e legenda são únicos para\n","    o PNG inteiro (definidos em plot_par_empilhado).\"\"\"\n","\n","    lines = {}\n","    for col in colunas:\n","        reg = NOMES_LEGENDA.get(col, col)\n","        (line,) = ax.plot(\n","            df_plot[\"Periodo\"], df_plot[col],\n","            marker=\"o\", markersize=6, linewidth=2.6,\n","            color=cor_regiao[reg], label=reg,\n","        )\n","        lines[col] = line\n","\n","    # Identifica o subplot apenas pelo rótulo do eixo Y (não é um título)\n","    ax.set_ylabel(f\"{rotulo}\\n{YLABEL_PADRAO}\", fontsize=20)\n","    ax.set_xlabel(XLABEL_PADRAO, fontsize=20)\n","    ax.grid(True, linestyle=\"--\", linewidth=0.6, alpha=0.5)\n","    ax.tick_params(axis=\"x\", labelsize=17)\n","    ax.tick_params(axis=\"y\", labelsize=17)\n","    ax.yaxis.set_major_formatter(mticker.FormatStrFormatter(\"R$ %.0f\"))\n","\n","    ticks_pos, ticks_labels = [], []\n","    for ano in sorted(df_plot[\"_Ano\"].unique()):\n","        idx_ano = df_plot.index[df_plot[\"_Ano\"] == ano]\n","        primeiro_idx = idx_ano[0]\n","        ticks_pos.append(df_plot.loc[primeiro_idx, \"Periodo\"])\n","        ticks_labels.append(str(ano))\n","    ax.set_xticks(ticks_pos)\n","    ax.set_xticklabels(ticks_labels, rotation=0, ha=\"center\")\n","\n","    valores = df_plot[colunas].values.flatten()\n","    valores = valores[~pd.isna(valores)]\n","    if len(valores) > 0:\n","        y_min_obs, y_max_obs = np.min(valores), np.max(valores)\n","        amplitude = y_max_obs - y_min_obs\n","        margem = amplitude * 0.08 if amplitude > 0 else abs(y_min_obs) * 0.05\n","        ax.set_ylim(max(y_min_obs - margem, 0), y_max_obs + margem)\n","\n","    # ---- rótulos numéricos, iguais aos do gráfico geral ----\n","    fig.canvas.draw()\n","    _desenhar_rotulos(ax, fig, df_plot, colunas, lines)\n","\n","\n","def plot_par_empilhado(df_res, nome_arquivo, titulo, graficos):\n","    \"\"\"\n","    Gera um único PNG com 2 gráficos empilhados verticalmente (um embaixo\n","    do outro), com APENAS UM título (para o PNG inteiro) e APENAS UMA\n","    legenda (compartilhada pelos dois gráficos, já que as regiões usam\n","    a mesma cor nos dois).\n","    \"\"\"\n","    df_plot = _preparar_eixo_temporal(df_res)\n","\n","    todas_regioes = REGIOES + [\"Brasil\"]\n","    cores = plt.cm.tab10.colors\n","    cor_regiao = {reg: cores[i % len(cores)] for i, reg in enumerate(todas_regioes)}\n","\n","    fig, axes = plt.subplots(2, 1, figsize=(26, 20), dpi=300)\n","\n","    for ax, cfg in zip(axes, graficos):\n","        colunas = gerar_colunas(cfg[\"prefixo\"])\n","        _plotar_subplot(ax, fig, df_plot, colunas, cfg[\"rotulo\"], cor_regiao)\n","\n","    # ---- único título do PNG ----\n","    fig.suptitle(titulo, fontsize=30, fontweight=\"bold\", y=0.995)\n","\n","    # ---- única legenda do PNG, compartilhada pelos 2 gráficos ----\n","    handles, labels = axes[0].get_legend_handles_labels()\n","    fig.legend(\n","        handles, labels, loc=\"lower center\", bbox_to_anchor=(0.5, -0.02),\n","        ncol=3, fontsize=19, frameon=True, markerscale=1.6, handlelength=2.5,\n","    )\n","\n","    fig.text(0.01, -0.05, FONTE, fontsize=12, color=\"gray\", style=\"italic\")\n","    plt.tight_layout(rect=[0, 0.04, 1, 0.98])\n","\n","    for sufixo, dpi in [(\"300dpi\", 300), (\"100dpi\", 100)]:\n","        fname = f\"{nome_arquivo}_{sufixo}.png\"\n","        plt.savefig(fname, dpi=dpi, bbox_inches=\"tight\")\n","        print(f\"Salvo: {fname}\")\n","\n","    plt.show()\n","    plt.close()\n","\n","\n","def gerar_pares_de_graficos(df_res):\n","    for par in PARES_GRAFICOS:\n","        plot_par_empilhado(df_res, par[\"nome_arquivo\"], par[\"titulo\"], par[\"graficos\"])\n","    print(f\"\\nTotal de PNGs gerados (pares empilhados): {len(PARES_GRAFICOS)}\")\n","\n","\n","# ==========================================================\n","# 6) VALIDAÇÃO — Brasil precisa estar dentro do intervalo regional\n","# ==========================================================\n","\n","def validar_brasil(df, colunas_regioes, coluna_brasil):\n","    erros = []\n","\n","    for _, row in df.iterrows():\n","        valores = [row[c] for c in colunas_regioes if pd.notna(row[c])]\n","        if not valores or pd.isna(row[coluna_brasil]):\n","            continue\n","\n","        minimo, maximo, brasil = min(valores), max(valores), row[coluna_brasil]\n","        if brasil < minimo or brasil > maximo:\n","            erros.append({\n","                \"Periodo\": row[\"Periodo\"],\n","                \"Brasil\": brasil,\n","                \"Min_Regiao\": minimo,\n","                \"Max_Regiao\": maximo,\n","            })\n","\n","    return pd.DataFrame(erros)\n","\n","\n","VALIDACOES_CFG = [\n","    (\"Geral\", None),\n","    (\"Homens\", \"Homem\"),\n","    (\"Mulheres\", \"Mulher\"),\n","    (\"Formal\", \"Formal\"),\n","    (\"Informal\", \"Informal\"),\n","    (\"Público\", \"Publico\"),\n","    (\"Privado\", \"Privado\"),\n","]\n","\n","\n","def rodar_validacoes(df_res):\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"VALIDAÇÃO DAS MÉDIAS BRASIL\")\n","    print(\"=\" * 70)\n","\n","    for nome, prefixo in VALIDACOES_CFG:\n","        colunas_regioes = gerar_colunas(prefixo)[:-1]  # remove o \"Brasil\" do fim\n","        coluna_brasil = \"Brasil\" if prefixo is None else f\"Brasil_{prefixo}\"\n","\n","        erros = validar_brasil(df_res, colunas_regioes, coluna_brasil)\n","\n","        if len(erros) == 0:\n","            print(f\"✓ {nome}: Brasil está dentro do intervalo das médias regionais em todos os períodos.\")\n","        else:\n","            print(f\"⚠ {nome}: {len(erros)} período(s) fora do intervalo regional.\")\n","            print(erros.head(10))\n","\n","\n","# ==========================================================\n","# 7) COMPARAÇÃO FINAL — ÚLTIMO PERÍODO\n","# ==========================================================\n","\n","GRUPOS_COMPARACAO = [\n","    (\"SETOR PÚBLICO\", \"Publico\"),\n","    (\"SETOR PRIVADO\", \"Privado\"),\n","    (\"HOMENS\", \"Homem\"),\n","    (\"MULHERES\", \"Mulher\"),\n","    (\"FORMAL\", \"Formal\"),\n","    (\"INFORMAL\", \"Informal\"),\n","]\n","\n","\n","def imprimir_comparacao_final(df_res):\n","    ultimo = df_res.iloc[-1]\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(f\"COMPARAÇÃO NO ÚLTIMO PERÍODO: {ultimo['Periodo']}\")\n","    print(\"=\" * 70)\n","\n","    for titulo, prefixo in GRUPOS_COMPARACAO:\n","        print(f\"\\n{titulo}:\")\n","        for reg in REGIOES:\n","            print(f\"{reg:15s}: R$ {ultimo[f'{prefixo}_{reg}']:.2f}\")\n","        print(f\"{'Brasil':15s}: R$ {ultimo[f'Brasil_{prefixo}']:.2f}\")\n","\n","\n","# ==========================================================\n","# MAIN\n","# ==========================================================\n","\n","def main():\n","    df = carregar_base(FILE_PATH)\n","\n","    periodos_ordenados = (\n","        df[[\"Ano\", \"Trimestre\", \"Periodo\"]]\n","        .drop_duplicates()\n","        .sort_values([\"Ano\", \"Trimestre\"])[\"Periodo\"]\n","        .tolist()\n","    )\n","    print(\"\\nPeríodos encontrados:\")\n","    print(periodos_ordenados)\n","    print(f\"\\nTotal de períodos: {len(periodos_ordenados)}\")\n","\n","    df[\"Salario_Hora\"] = calcular_salario_hora(df)\n","    df = classificar_grupos(df)\n","\n","    df_res = montar_df_resultados(df, periodos_ordenados)\n","\n","    # Gráfico 1: geral, por região (sem corte)\n","    gerar_grafico_geral(df_res)\n","\n","    # Gráficos 2 e 3 (Homens/Mulheres), 4 e 5 (Formal/Informal) e\n","    # 6 e 7 (Público/Privado): cada dupla vira 1 PNG, com os 2 gráficos\n","    # empilhados (um embaixo do outro), cada um com seu próprio título\n","    # e sua própria legenda.\n","    gerar_pares_de_graficos(df_res)\n","\n","    rodar_validacoes(df_res)\n","    imprimir_comparacao_final(df_res)\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"PROCESSAMENTO CONCLUÍDO\")\n","    print(\"=\" * 70)\n","\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1Ps_CApPMhXoqIjPWm3Ylh0lD19veEDLH"},"id":"DNwW6dFrbms0","executionInfo":{"status":"ok","timestamp":1787541288405,"user_tz":180,"elapsed":62676,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"a5719358-7e92-452f-bac9-8346cf6cc847"},"execution_count":2,"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}]},{"cell_type":"code","source":["import gc\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.ticker as mticker\n","from matplotlib.lines import Line2D\n","\n","# ==========================================================\n","# 1) Leitura e preparação (otimizado p/ memória)\n","# ==========================================================\n","\n","file_path = '/content/pnad_consolidada_2013_2025.parquet'\n","\n","# Só lê as colunas realmente usadas -- evita carregar o parquet inteiro na RAM\n","COLUNAS_NECESSARIAS = [\n","    \"Ano\", \"Trimestre\", \"Horas_hab_trabalhadas\",\n","    \"Rendimento_hab_Trab_princ\", \"Anos_de_Estudo\", \"Regiao\",\n","]\n","df = pd.read_parquet(file_path, columns=COLUNAS_NECESSARIAS, engine=\"pyarrow\")\n","\n","# Filtra ANTES de criar colunas novas, para não processar linhas inúteis\n","mask_valido = (\n","    df[\"Horas_hab_trabalhadas\"].replace(0, np.nan).notna() &\n","    df[\"Rendimento_hab_Trab_princ\"].notna() &\n","    df[\"Anos_de_Estudo\"].between(0, 16) &          # já aplica o topcode aqui\n","    df[\"Regiao\"].notna()\n",")\n","df = df.loc[mask_valido, COLUNAS_NECESSARIAS]\n","gc.collect()\n","\n","# Dtypes compactos -- reduz bastante o footprint em RAM\n","df[\"Ano\"] = df[\"Ano\"].astype(\"int16\")\n","df[\"Trimestre\"] = df[\"Trimestre\"].astype(\"int8\")\n","df[\"Anos_de_Estudo\"] = df[\"Anos_de_Estudo\"].astype(\"int8\")\n","df[\"Regiao\"] = df[\"Regiao\"].astype(\"category\")\n","\n","# Salário/hora em float32 (metade do espaço de um float64)\n","# Fator de conversão semana -> mês: 52/12 (~4,33 semanas por mês)\n","df[\"Salario_Hora\"] = (\n","    df[\"Rendimento_hab_Trab_princ\"].astype(\"float32\")\n","    / (df[\"Horas_hab_trabalhadas\"].astype(\"float32\") * np.float32(4.33))\n",")\n","\n","# \"Periodo\" como category evita repetir a mesma string milhões de vezes\n","df[\"Periodo\"] = (\n","    df[\"Ano\"].astype(str) + \".\" + df[\"Trimestre\"].astype(str)\n",").astype(\"category\")\n","\n","# Colunas que não são mais necessárias em formato bruto\n","df = df.drop(columns=[\"Rendimento_hab_Trab_princ\", \"Horas_hab_trabalhadas\"])\n","gc.collect()\n","\n","FONTE = \"Fonte: PNAD Contínua – IBGE (2013–2025). Valores deflacionados pelo IPCA (Base: Jan/2026).\"\n","\n","YLABEL_PADRAO = \"Salário médio por hora (R$ reais, Base Jan/2026)\"\n","XLABEL_PADRAO = \"Ano\"\n","\n","# ==========================================================\n","# 2) Faixas de escolaridade\n","# ==========================================================\n","\n","FAIXAS = [\n","    (0, 4,  \"0 a 4 anos (Fund. incompleto)\"),\n","    (5, 8,  \"5 a 8 anos (Fund. completo)\"),\n","    (9, 11, \"9 a 11 anos (Médio)\"),\n","    (12, 14, \"12 a 14 anos (Sup. incompleto)\"),\n","    (15, 16, \"15 a 16 anos (Sup. completo+)\"),\n","]\n","\n","\n","# mapeamento vetorizado (evita apply linha-a-linha, que é caro em RAM/CPU)\n","bins = [lo for lo, _, _ in FAIXAS] + [FAIXAS[-1][1] + 1]\n","labels_faixas = [label for _, _, label in FAIXAS]\n","df[\"Faixa_Estudo\"] = pd.cut(\n","    df[\"Anos_de_Estudo\"], bins=bins, labels=labels_faixas,\n","    right=False, include_lowest=True,\n",").astype(\"category\")\n","\n","periodos_ordenados = (\n","    df[[\"Ano\", \"Trimestre\", \"Periodo\"]]\n","    .drop_duplicates()\n","    .sort_values([\"Ano\", \"Trimestre\"])\n","    [\"Periodo\"]\n","    .astype(str)\n","    .tolist()\n",")\n","\n","colunas_faixas = [label for _, _, label in FAIXAS]\n","regioes_ordenadas = sorted(df[\"Regiao\"].dropna().unique().tolist())\n","\n","# ------------------------------------------------------------\n","# Média Brasil, por Período x Faixa (linha de referência em todos os gráficos)\n","# ------------------------------------------------------------\n","tab_faixas_brasil = (\n","    df.groupby([\"Periodo\", \"Faixa_Estudo\"], observed=True)[\"Salario_Hora\"]\n","    .mean()\n","    .round(2)\n","    .unstack(\"Faixa_Estudo\")\n","    .reindex(periodos_ordenados)[colunas_faixas]\n",")\n","\n","# ------------------------------------------------------------\n","# Média por Região, Período x Faixa\n","# ------------------------------------------------------------\n","tab_faixas_regiao = (\n","    df.groupby([\"Periodo\", \"Faixa_Estudo\", \"Regiao\"], observed=True)[\"Salario_Hora\"]\n","    .mean()\n","    .round(2)\n","    .unstack(\"Regiao\")\n","    .reindex(periodos_ordenados, level=\"Periodo\")\n",")\n","\n","# A partir daqui só usamos as tabelas agregadas (muito menores) -- libera o df bruto\n","del df\n","gc.collect()\n","\n","\n","# ==========================================================\n","# 3) Função genérica de plot: evolução por região + média Brasil,\n","#    TODAS as faixas selecionadas juntas em um único gráfico\n","#    (cor = região / Brasil, estilo de linha = faixa de escolaridade)\n","#\n","#    Estilo padronizado, igual ao script principal (salario_medio_pnad.py):\n","#    título 28pt, eixos 23pt, ticks 20/21pt, legenda 22pt, rótulos\n","#    numéricos 14pt, nota de fonte 12pt, linhas com espessura 3 e\n","#    marcadores tamanho 7, eixo X só com o ano (sem rotação), eixo Y\n","#    nunca começa em zero (margem de 8% sobre a amplitude dos dados).\n","# ==========================================================\n","\n","LINESTYLES = [\"-\", \"--\", \"-.\", \":\", (0, (3, 1, 1, 1))]\n","\n","\n","def plot_evolucao_regioes(faixas_selecionadas, nome_arquivo, figsize=(26, 11)):\n","    fig, ax = plt.subplots(figsize=figsize, dpi=300)\n","\n","    cmap = plt.get_cmap(\"tab10\")\n","    cores_regiao = {reg: cmap(i % 10) for i, reg in enumerate(regioes_ordenadas)}\n","    faixa_linestyle = {faixa: LINESTYLES[i % len(LINESTYLES)]\n","                        for i, faixa in enumerate(faixas_selecionadas)}\n","\n","    # Posições (no eixo x categórico) referentes ao último trimestre de cada ano\n","    idx_ultimo_tri = [pos for pos, periodo in enumerate(periodos_ordenados)\n","                       if periodo.split(\".\")[-1] == \"4\"]\n","\n","    valores_todos = []  # para calcular os limites do eixo Y (nunca começa em zero)\n","\n","    for faixa in faixas_selecionadas:\n","        ls = faixa_linestyle[faixa]\n","\n","        # Linhas por região (sem label individual -- a legenda é só por região,\n","        # igual ao gráfico geral; o estilo de linha por faixa é explicado no subtítulo)\n","        sub = tab_faixas_regiao.xs(faixa, level=\"Faixa_Estudo\").reindex(periodos_ordenados)\n","        for regiao in regioes_ordenadas:\n","            if regiao not in sub.columns:\n","                continue\n","            valores = sub[regiao].values\n","            valores_todos.append(valores)\n","            ax.plot(periodos_ordenados, valores, marker=\"o\", markersize=7,\n","                    linewidth=3, linestyle=ls, color=cores_regiao[regiao], alpha=0.85)\n","\n","            for pos in idx_ultimo_tri:\n","                v = valores[pos]\n","                if pd.isna(v):\n","                    continue\n","                ax.annotate(f\"{v:.1f}\", (pos, v), textcoords=\"offset points\",\n","                            xytext=(0, 8), ha=\"center\", fontsize=14,\n","                            fontweight=\"bold\", color=cores_regiao[regiao])\n","\n","        # Linha Brasil (destacada, sempre preta, mesmo estilo da faixa)\n","        valores_brasil = tab_faixas_brasil[faixa].values\n","        valores_todos.append(valores_brasil)\n","        ax.plot(periodos_ordenados, valores_brasil,\n","                marker=\"o\", markersize=7, linewidth=3,\n","                linestyle=ls, color=\"black\", zorder=10)\n","\n","        for pos in idx_ultimo_tri:\n","            v = valores_brasil[pos]\n","            if pd.isna(v):\n","                continue\n","            ax.annotate(f\"{v:.1f}\", (pos, v), textcoords=\"offset points\",\n","                        xytext=(0, 10), ha=\"center\", fontsize=14,\n","                        fontweight=\"bold\", color=\"black\", zorder=11)\n","\n","    # ---- Título (único) + subtítulo explicando o estilo de linha (faixa) ----\n","    fig.suptitle(\"Evolução do Salário Médio por Hora Real, por Região (Brasil)\",\n","                  fontsize=28, fontweight=\"bold\", y=1.01)\n","    legenda_linestyle = \"   •   \".join(\n","        f\"{'Linha contínua' if faixa_linestyle[f] == '-' else 'Linha tracejada'} = {f}\"\n","        for f in faix