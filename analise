nad_processado_final.parquet), sem FE de Região\n","================================================================================\n","Este script NÃO troca de base: usa exatamente as mesmas variáveis e a mesma\n","preparação de dados do pipeline M5 anterior (Setor, Ocupação, Cor, Sexo_Dummy,\n","Ano_Nascimento -> Faixa_Nascimento, Idade/Experiência etc.). O que muda é\n","SÓ a especificação do modelo, seguindo a IDEIA da M4 do script \"Tabela 3\":\n","\n","  Controles substantivos + FE Coorte + FE Ano + FE Trimestre, SEM FE Região.\n","  Erro-padrão clusterizado em UMA via: Coorte (não mais o cluster duplo\n","  Coorte+UF do M5 ajustado -- aqui replica a lógica do M4 original, que\n","  clusteriza só em Coorte).\n","\n","\"Coorte\", aqui, é a mesma Faixa_Nascimento (bins de ano de nascimento) que o\n","M5 já usava para o cluster de Coorte -- é o análogo natural de \"Coorte\" nesse\n","dataframe (não existe uma coluna de coorte pronta como no script do pseudo-\n","-painel; ela é construída a partir de Ano_Nascimento, igual antes).\n","\n","Trimestre entra como efeito fixo (coluna já existente no parquet, só não\n","era lida pelos scripts anteriores porque não era usada no M5/M5-ajustado).\n","Região (UF/Regiao) é OMITIDA do modelo inteiramente -- nem é lida do parquet.\n","\n","Dependente : log(salario_hora)\n","Controles  : Anos_de_Estudo, is_formal, is_public, Sexo_Dummy,\n","             Setor (DUMMIES_SETOR), Ocupação (DUMMIES_OCUPACAO), Cor (NOMES_COLUNAS_COR)\n","Efeitos fixos: Coorte (Faixa_Nascimento), Ano, Trimestre -- SEM Região\n","Cluster    : Coorte (uma via)\n","\"\"\"\n","\n","import gc\n","import numpy as np\n","import pandas as pd\n","import scipy.stats as stats\n","import pyarrow.parquet as pq\n","from patsy import dmatrix, build_design_matrices\n","\n","# =============================================================================\n","# 0. CONFIGURAÇÃO (mesmos nomes de variáveis do pipeline M5)\n","# =============================================================================\n","\n","BINS_NASCIMENTO = [1947, 1952, 1957, 1962, 1967, 1972, 1977, 1982, 1988]\n","LABELS_NASCIMENTO = ['1', '2', '3', '4', '5', '6', '7', '8']  # = níveis de \"Coorte\"\n","IDADE_MINIMA_TRABALHO = 14\n","\n","DUMMIES_SETOR = [\n","    \"Setor_Industria_Geral\", \"Setor_Construcao\", \"Setor_Comercio\",\n","    \"Setor_Transporte_Armazenagem_Correio\", \"Setor_Alojamento_Alimentacao\",\n","    \"Setor_Info_Comunicacao_Financ_Imob_Prof_Adm\", \"Setor_Adm_Publica\",\n","    \"Setor_Educacao_Saude\", \"Setor_Outros_Servicos\", \"Setor_Servicos_Domesticos\",\n","]  # referência omitida: Setor_Agropecuaria\n","\n","DUMMIES_OCUPACAO = [\n","    \"Ocup_Diretores_Gerentes\", \"Ocup_Profissionais_Ciencias_Intelectuais\",\n","    \"Ocup_Tecnicos_Nivel_Medio\", \"Ocup_Apoio_Administrativo\",\n","    \"Ocup_Servicos_Vendedores_Comercio_Mercado\",\n","    \"Ocup_Qualificados_Agropecuaria_Pesca\",\n","    \"Ocup_Qualificados_Construcao_Mecanica_Oficios\",\n","    \"Ocup_Operadores_Instalacoes_Maquinas\",\n","    \"Ocup_Forcas_Armadas_Policiais_Bombeiros\",\n","]  # referência omitida: Ocup_Elementares\n","\n","CODIGOS_COR_NAO_REFERENCIA = [2, 3, 4, 5]  # 1 = Branca (referência, omitida)\n","NOMES_COR = {1: \"Branca\", 2: \"Preta\", 3: \"Amarela\", 4: \"Parda\", 5: \"Indigena\"}\n","NOMES_COLUNAS_COR = [f\"Cor_{NOMES_COR[c]}\" for c in CODIGOS_COR_NAO_REFERENCIA]\n","\n","# NOTA: sem DUMMIES_REGIAO_FORMULA e sem UF/Regiao -- é a diferença central p/\n","# a \"ideia do M4\": nada de FE Região aqui.\n","CONTROLES_BASE = (\n","    [\"Anos_de_Estudo\", \"is_formal\", \"is_public\", \"Sexo_Dummy\"]\n","    + DUMMIES_SETOR + DUMMIES_OCUPACAO + NOMES_COLUNAS_COR\n",")\n","\n","FORMULA_RHS = \" + \".join(\n","    CONTROLES_BASE\n","    + [\"C(Coorte, levels=COORTE_LEVELS)\", \"C(Ano, levels=ANO_LEVELS)\", \"C(Trimestre, levels=TRIMESTRE_LEVELS)\"]\n",")\n","\n","# Só as colunas realmente usadas -- igual ao critério do M5 original\n","# (não carrega Regiao/UF: não fazem parte da especificação M4-sem-Região)\n","COLUNAS_NECESSARIAS = list(set(\n","    [\"salario_hora\", \"Ano\", \"Ano_Nascimento\", \"Trimestre\", \"Anos_de_Estudo\",\n","     \"is_formal\", \"is_public\", \"Sexo_Dummy\", \"Cor\"] + DUMMIES_SETOR + DUMMIES_OCUPACAO\n","))\n","\n","\n","def eh_coluna_efeito_fixo(nome_coluna: str) -> bool:\n","    \"\"\"Identifica colunas de C(Coorte)/C(Ano)/C(Trimestre) no design (continuam\n","    controlando o modelo como efeito fixo, mas são omitidas da tabela final).\"\"\"\n","    return nome_coluna.startswith(\"C(Coorte\") or nome_coluna.startswith(\"C(Ano\") \\\n","        or nome_coluna.startswith(\"C(Trimestre\")\n","\n","\n","# =============================================================================\n","# 1. PREPARAÇÃO DE CHUNK (idêntica à do M5, menos Regiao/UF; +Trimestre)\n","# =============================================================================\n","\n","def preparar_chunk(chunk: pd.DataFrame) -> pd.DataFrame:\n","    chunk[\"Ano\"] = pd.to_numeric(chunk[\"Ano\"], downcast=\"unsigned\")\n","    chunk[\"Ano_Nascimento\"] = pd.to_numeric(chunk[\"Ano_Nascimento\"], downcast=\"unsigned\")\n","    chunk[\"Trimestre\"] = pd.to_numeric(chunk[\"Trimestre\"], downcast=\"unsigned\")\n","    chunk[\"Cor\"] = pd.to_numeric(chunk[\"Cor\"], downcast=\"integer\")\n","    chunk[\"Anos_de_Estudo\"] = pd.to_numeric(chunk[\"Anos_de_Estudo\"], downcast=\"float\")\n","    chunk[\"salario_hora\"] = chunk[\"salario_hora\"].astype(\"float32\")\n","    for col in [\"is_formal\", \"is_public\", \"Sexo_Dummy\"] + DUMMIES_SETOR + DUMMIES_OCUPACAO:\n","        chunk[col] = pd.to_numeric(chunk[col], downcast=\"unsigned\")\n","\n","    chunk = chunk[chunk[\"salario_hora\"] > 0].copy()\n","    if chunk.empty:\n","        return chunk\n","\n","    chunk[\"Idade\"] = chunk[\"Ano\"].astype(np.int32) - chunk[\"Ano_Nascimento\"].astype(np.int32)\n","    chunk[\"Experiencia\"] = chunk[\"Idade\"] - chunk[\"Anos_de_Estudo\"] - 6\n","    chunk = chunk[(chunk[\"Experiencia\"] >= 0) & (chunk[\"Idade\"] >= IDADE_MINIMA_TRABALHO)].copy()\n","    if chunk.empty:\n","        return chunk\n","\n","    chunk[\"Faixa_Nascimento\"] = pd.cut(\n","        chunk[\"Ano_Nascimento\"], bins=BINS_NASCIMENTO, labels=LABELS_NASCIMENTO,\n","        include_lowest=True\n","    ).astype(object)\n","    chunk = chunk[chunk[\"Faixa_Nascimento\"].notna()].copy()\n","    if chunk.empty:\n","        return chunk\n","    chunk[\"Coorte\"] = chunk[\"Faixa_Nascimento\"].astype(str)  # = FE/cluster do M4\n","\n","    for codigo in CODIGOS_COR_NAO_REFERENCIA:\n","        chunk[f\"Cor_{NOMES_COR[codigo]}\"] = (chunk[\"Cor\"] == codigo).astype(np.uint8)\n","\n","    chunk[\"y\"] = np.log(chunk[\"salario_hora\"].astype(np.float64))\n","    return chunk\n","\n","\n","# =============================================================================\n","# 2. NÍVEIS DE Ano/Trimestre + DESIGN INFO FIXO\n","#    (níveis de Coorte já são fixos: LABELS_NASCIMENTO)\n","# =============================================================================\n","\n","def obter_niveis(caminho_parquet: str):\n","    tabela = pq.read_table(caminho_parquet, columns=[\"Ano\", \"Trimestre\"]).to_pandas()\n","    ano_levels = sorted(tabela[\"Ano\"].dropna().unique().tolist())\n","    trimestre_levels = sorted(tabela[\"Trimestre\"].dropna().unique().tolist())\n","    print(f\"Ano: {len(ano_levels)} níveis ({ano_levels}) | \"\n","          f\"Trimestre: {len(trimestre_levels)} níveis ({trimestre_levels}) | \"\n","          f\"Coorte: {len(LABELS_NASCIMENTO)} níveis (Faixa_Nascimento)\")\n","    del tabela\n","    gc.collect()\n","    return ano_levels, trimestre_levels\n","\n","\n","def construir_design_info(ano_levels: list, trimestre_levels: list):\n","    coorte_levels = LABELS_NASCIMENTO\n","    n_rows = max(len(coorte_levels), len(ano_levels), len(trimestre_levels))\n","    df_sint = pd.DataFrame({\n","        \"Coorte\": [coorte_levels[i % len(coorte_levels)] for i in range(n_rows)],\n","        \"Ano\": [ano_levels[i % len(ano_levels)] for i in range(n_rows)],\n","        \"Trimestre\": [trimestre_levels[i % len(trimestre_levels)] for i in range(n_rows)],\n","    })\n","    df_sint[\"Anos_de_Estudo\"] = 0.0\n","    df_sint[\"is_formal\"] = 0\n","    df_sint[\"is_public\"] = 0\n","    df_sint[\"Sexo_Dummy\"] = 0\n","    for col in DUMMIES_SETOR + DUMMIES_OCUPACAO + NOMES_COLUNAS_COR:\n","        df_sint[col] = 0\n","\n","    global COORTE_LEVELS, ANO_LEVELS, TRIMESTRE_LEVELS\n","    COORTE_LEVELS, ANO_LEVELS, TRIMESTRE_LEVELS = coorte_levels, ano_levels, trimestre_levels\n","\n","    X_design = dmatrix(FORMULA_RHS, data=df_sint, return_type=\"dataframe\")\n","    return X_design.design_info, X_design.columns.tolist()\n","\n","\n","def iterar_chunks(caminho_parquet: str, colunas: list, tamanho_chunk: int):\n","    parquet_file = pq.ParquetFile(caminho_parquet)\n","    for batch in parquet_file.iter_batches(batch_size=tamanho_chunk, columns=colunas):\n","        yield batch.to_pandas()\n","\n","\n","# =============================================================================\n","# 3. PASSADA 1 — EQUAÇÕES NORMAIS -> beta\n","# =============================================================================\n","\n","def passada_1_equacoes_normais(caminho_parquet: str, X_design_info, tamanho_chunk: int):\n","    k = None\n","    XtX = None\n","    Xty = None\n","    soma_y = 0.0\n","    soma_y2 = 0.0\n","    n_total = 0\n","    colunas_leitura = list(set(COLUNAS_NECESSARIAS))\n","\n","    for i, chunk_bruto in enumerate(iterar_chunks(caminho_parquet, colunas_leitura, tamanho_chunk)):\n","        chunk = preparar_chunk(chunk_bruto)\n","        del chunk_bruto\n","        if chunk.empty:\n","            del chunk\n","            gc.collect()\n","            continue\n","\n","        (X_mat,), = [build_design_matrices([X_design_info], chunk, return_type=\"dataframe\")]\n","        X_vals = X_mat.values\n","        y_vals = chunk[\"y\"].values\n","\n","        if XtX is None:\n","            k = X_vals.shape[1]\n","            XtX = np.zeros((k, k))\n","            Xty = np.zeros(k)\n","\n","        XtX += X_vals.T @ X_vals\n","        Xty += X_vals.T @ y_vals\n","        soma_y += y_vals.sum()\n","        soma_y2 += (y_vals ** 2).sum()\n","        n_total += X_vals.shape[0]\n","\n","        print(f\"  [Passada 1/2] chunk {i+1}: +{X_vals.shape[0]:,} obs (acumulado: {n_total:,})\")\n","        del chunk, X_mat, X_vals, y_vals\n","        gc.collect()\n","\n","    beta = np.linalg.solve(XtX, Xty)\n","    return beta, XtX, Xty, soma_y, soma_y2, n_total, k\n","\n","\n","# =============================================================================\n","# 4. PASSADA 2 — RESÍDUOS + SOMAS POR CLUSTER (Coorte, uma via) + momentos BP\n","# =============================================================================\n","\n","def passada_2_residuos(caminho_parquet: str, X_design_info, beta: np.ndarray,\n","                        n_total: int, k: int, nomes_colunas: list, tamanho_chunk: int):\n","    residuos = np.empty(n_total, dtype=np.float32)\n","    xu2_vec_sum = np.zeros(k)\n","    cluster_sums_coorte: dict[str, np.ndarray] = {}\n","    colunas_leitura = list(set(COLUNAS_NECESSARIAS))\n","    idx = 0\n","\n","    for i, chunk_bruto in enumerate(iterar_chunks(caminho_parquet, colunas_leitura, tamanho_chunk)):\n","        chunk = preparar_chunk(chunk_bruto)\n","        del chunk_bruto\n","        if chunk.empty:\n","            del chunk\n","            gc.collect()\n","            continue\n","\n","        (X_mat,), = [build_design_matrices([X_design_info], chunk, return_type=\"dataframe\")]\n","        X_vals = X_mat.values\n","        y_vals = chunk[\"y\"].values\n","        u = y_vals - X_vals @ beta\n","        n_c = len(u)\n","\n","        residuos[idx: idx + n_c] = u.astype(np.float32)\n","        idx += n_c\n","        xu2_vec_sum += X_vals.T @ (u ** 2)\n","\n","        xu = X_vals * u[:, None]\n","        base = pd.DataFrame(xu, columns=nomes_colunas)\n","        base[\"cluster\"] = chunk[\"Coorte\"].values\n","        grouped = base.groupby(\"cluster\", observed=True)[nomes_colunas].sum()\n","        for label, row in grouped.iterrows():\n","            if label not in cluster_sums_coorte:\n","                cluster_sums_coorte[label] = np.zeros(k)\n","            cluster_sums_coorte[label] += row.values\n","\n","        print(f\"  [Passada 2/2] chunk {i+1}: +{n_c:,} obs (acumulado: {idx:,})\")\n","        del chunk, X_mat, X_vals, y_vals, u, xu, base, grouped\n","        gc.collect()\n","\n","    return residuos, xu2_vec_sum, cluster_sums_coorte\n","\n","\n","# =============================================================================\n","# 5. ERRO-PADRÃO CLUSTER (UMA VIA — Coorte), Cameron-Gelbach-Miller\n","# =============================================================================\n","\n","def erro_padrao_cluster(XtX, cluster_sums: dict, n_total: int, k: int):\n","    XtX_inv = np.linalg.inv(XtX)\n","    labels = list(cluster_sums.keys())\n","    G = len(labels)\n","    S = np.vstack([cluster_sums[lb] for lb in labels])\n","    Omega = S.T @ S\n","    correcao = (G / (G - 1)) * ((n_total - 1) / (n_total - k))\n","    V = correcao * (XtX_inv @ Omega @ XtX_inv)\n","    se_cluster = np.sqrt(np.diag(V))\n","    return se_cluster, G\n","\n","\n","# =============================================================================\n","# 6. DIAGNÓSTICOS (JB, DW, BP) + VIF\n","# =============================================================================\n","\n","def teste_jarque_bera(residuos):\n","    jb_stat, jb_p = stats.jarque_bera(residuos)\n","    return jb_stat, jb_p, stats.skew(residuos), stats.kurtosis(residuos, fisher=False)\n","\n","\n","def teste_durbin_watson(residuos):\n","    diffs = np.diff(residuos)\n","    return float(np.sum(diffs ** 2) / np.sum(residuos ** 2))\n","\n","\n","def teste_breusch_pagan(xu2_vec_sum, XtX_inv, soma_u2, soma_u4, n_total, k):\n","    beta_aux = XtX_inv @ xu2_vec_sum\n","    sse_aux = soma_u4 - beta_aux @ xu2_vec_sum\n","    sst_aux = soma_u4 - (soma_u2 ** 2) / n_total\n","    r2_aux = 1 - sse_aux / sst_aux\n","    bp_stat = n_total * r2_aux\n","    bp_p = 1 - stats.chi2.cdf(bp_stat, k - 1)\n","    return bp_stat, bp_p\n","\n","\n","def calcular_vif(XtX, nomes_colunas):\n","    idx_intercepto = nomes_colunas.index(\"Intercept\") if \"Intercept\" in nomes_colunas else 0\n","    idx_outros = [i for i in range(len(nomes_colunas)) if i != idx_intercepto]\n","    nomes_outros = [nomes_colunas[i] for i in idx_outros]\n","    n = XtX[idx_intercepto, idx_intercepto]\n","    soma_x = XtX[idx_intercepto, idx_outros]\n","    XtX_sub = XtX[np.ix_(idx_outros, idx_outros)]\n","    M = XtX_sub - np.outer(soma_x, soma_x) / n\n","    M_inv = np.linalg.inv(M)\n","    vif = np.diag(M) * np.diag(M_inv)\n","    return (pd.DataFrame({\"Variável\": nomes_outros, \"VIF\": vif})\n","            .sort_values(\"VIF\", ascending=False).reset_index(drop=True))\n","\n","\n","# =============================================================================\n","# 7. TABELA FINAL (estilo \"Tabela 3\", sem exibir dummies de FE, sem Região)\n","# =============================================================================\n","\n","def _rotulo(nome: str) -> str:\n","    if nome in (\"Intercept\", \"Anos_de_Estudo\", \"is_formal\", \"is_public\", \"Sexo_Dummy\"):\n","        return {\n","            \"Intercept\": \"Constante\", \"Anos_de_Estudo\": \"Escolaridade (anos)\",\n","            \"is_formal\": \"Formalidade\", \"is_public\": \"Setor Público\",\n","            \"Sexo_Dummy\": \"Sexo (dummy)\",\n","        }[nome]\n","    if nome.startswith(\"Setor_\"):\n","        return \"Setor: \" + nome.replace(\"Setor_\", \"\").replace(\"_\", \" \")\n","    if nome.startswith(\"Ocup_\"):\n","        return \"Ocupação: \" + nome.replace(\"Ocup_\", \"\").replace(\"_\", \" \")\n","    if nome.startswith(\"Cor_\"):\n","        return \"Cor: \" + nome.replace(\"Cor_\", \"\")\n","    return nome\n","\n","\n","ORDEM_VARIAVEIS = (\n","    [\"Intercept\", \"Anos_de_Estudo\", \"is_formal\", \"is_public\", \"Sexo_Dummy\"]\n","    + DUMMIES_SETOR + DUMMIES_OCUPACAO + NOMES_COLUNAS_COR\n",")\n","\n","\n","def estrelas(p):\n","    if p < 0.01:\n","        return \"***\"\n","    elif p < 0.05:\n","        return \"**\"\n","    elif p < 0.10:\n","        return \"*\"\n","    return \"\"\n","\n","\n","def montar_tabela_m4(beta, se_cluster, nomes_colunas, G, n_total, k, r2, r2_ajustado):\n","    df_t = G - 1\n","    t_stats = beta / se_cluster\n","    p_valores = 2 * (1 - stats.t.cdf(np.abs(t_stats), df_t))\n","    mapa = dict(zip(nomes_colunas, zip(beta, se_cluster, p_valores)))\n","    col = \"M4 (FE Coorte+Ano+Trimestre, sem Região)\"\n","\n","    linhas = []\n","    for var in ORDEM_VARIAVEIS:\n","        label = _rotulo(var)\n","        if var in mapa:\n","            b, se, p = mapa[var]\n","            linhas.append({\"Variável\": label, col: f\"{b:.3f}{estrelas(p)}\"})\n","            linhas.append({\"Variável\": \"\", col: f\"({se:.3f})\"})\n","        else:\n","            linhas.append({\"Variável\": label, col: \"\"})\n","            linhas.append({\"Variável\": \"\", col: \"\"})\n","\n","    linhas.append({\"Variável\": \"\", col: \"\"})\n","    linhas.append({\"Variável\": \"Ref. Setor\", col: \"Agropecuária\"})\n","    linhas.append({\"Variável\": \"Ref. Ocupação\", col: \"Elementares\"})\n","    linhas.append({\"Variável\": \"Ref. Cor\", col: \"Branca\"})\n","    linhas.append({\"Variável\": \"FE Coorte (Faixa_Nascimento)\", col: \"Sim\"})\n","    linhas.append({\"Variável\": \"FE Ano\", col: \"Sim\"})\n","    linhas.append({\"Variável\": \"FE Trimestre\", col: \"Sim\"})\n","    linhas.append({\"Variável\": \"FE Região\", col: \"Não\"})\n","    linhas.append({\"Variável\": \"R²\", col: f\"{r2:.4f}\"})\n","    linhas.append({\"Variável\": \"R² Ajustado\", col: f\"{r2_ajustado:.4f}\"})\n","    linhas.append({\"Variável\": \"N\", col: f\"{n_total:,}\"})\n","    linhas.append({\"Variável\": \"Cluster (G Coorte)\", col: f\"{G}\"})\n","\n","    return pd.DataFrame(linhas).set_index(\"Variável\")\n","\n","\n","# =============================================================================\n","# 8. PONTO DE ENTRADA\n","# =============================================================================\n","\n","def estimar_m4_mesma_base(caminho_parquet: str, tamanho_chunk: int = 100_000):\n","    print(\"#\" * 78)\n","    print(f\"# M4 (ideia) — base do M5, SEM FE Região (chunk={tamanho_chunk:,})\")\n","    print(\"#\" * 78)\n","\n","    ano_levels, trimestre_levels = obter_niveis(caminho_parquet)\n","    X_design_info, nomes_colunas = construir_design_info(ano_levels, trimestre_levels)\n","    k = len(nomes_colunas)\n","    print(f\"k (regressores, incl. intercepto e dummies de FE): {k}\")\n","\n","    print(f\"\\n[Passada 1/2] chunk={tamanho_chunk:,}...\")\n","    beta, XtX, Xty, soma_y, soma_y2, n_total, k = passada_1_equacoes_normais(\n","        caminho_parquet, X_design_info, tamanho_chunk\n","    )\n","    print(f\"Total de observações: {n_total:,}\")\n","\n","    print(\"\\n[Passada 2/2]...\")\n","    residuos, xu2_vec_sum, cluster_sums_coorte = passada_2_residuos(\n","        caminho_parquet, X_design_info, beta, n_total, k, nomes_colunas, tamanho_chunk\n","    )\n","\n","    print(\"\\n[Cluster (Coorte) + diagnósticos]...\")\n","    se_cluster, G = erro_padrao_cluster(XtX, cluster_sums_coorte, n_total, k)\n","\n","    sse = soma_y2 - beta @ Xty\n","    media_y = soma_y / n_total\n","    sst = soma_y2 - n_total * media_y ** 2\n","    r2 = 1 - sse / sst\n","    r2_ajustado = 1 - (sse / (n_total - k)) / (sst / (n_total - 1))\n","\n","    residuos64 = residuos.astype(np.float64)\n","    jb_stat, jb_p, skew, kurt = teste_jarque_bera(residuos64)\n","    dw = teste_durbin_watson(residuos64)\n","    XtX_inv = np.linalg.inv(XtX)\n","    soma_u2 = float(residuos64 @ residuos64)\n","    soma_u4 = float((residuos64 ** 4).sum())\n","    bp_stat, bp_p = teste_breusch_pagan(xu2_vec_sum, XtX_inv, soma_u2, soma_u4, n_total, k)\n","    tabela_vif = calcular_vif(XtX, nomes_colunas)\n","\n","    print(f\"\\nR²: {r2:.4f} | R² aj.: {r2_ajustado:.4f} | N: {n_total:,} | G (Coorte): {G}\")\n","    print(f\"JB: {jb_stat:,.1f} (p={jb_p:.3g}) | DW: {dw:.4f} | BP: {bp_stat:,.1f} (p={bp_p:.3g})\")\n","    if G < 30:\n","        print(f\"⚠ G (Coorte) = {G} -- abaixo de 30-50, considere bootstrap wild cluster.\")\n","\n","    tabela_m4 = montar_tabela_m4(beta, se_cluster, nomes_colunas, G, n_total, k, r2, r2_ajustado)\n","\n","    print(\"\\n\" + \"=\" * 78)\n","    print(\"M4 (ideia) — base M5, FE Coorte + Ano + Trimestre, SEM Região\")\n","    print(\"=\" * 78)\n","    print(tabela_m4.to_string())\n","\n","    tabela_vif_out = tabela_vif[~tabela_vif[\"Variável\"].apply(eh_coluna_efeito_fixo)].reset_index(drop=True)\n","\n","    tabela_m4.to_csv(\"m4_base_m5_resultados.csv\", encoding=\"utf-8-sig\")\n","    tabela_vif_out.to_csv(\"m4_base_m5_vif.csv\", index=False, encoding=\"utf-8-sig\")\n","    try:\n","        tabela_m4.to_excel(\"m4_base_m5_resultados.xlsx\")\n","        print(\"\\nExportado: m4_base_m5_resultados.xlsx\")\n","    except ImportError:\n","        print(\"\\nopenpyxl não instalado -- apenas CSV gerado.\")\n","    print(\"Exportado: m4_base_m5_resultados.csv\")\n","    print(\"Exportado: m4_base_m5_vif.csv\")\n","\n","    return {\n","        \"beta\": beta, \"se_cluster\": se_cluster, \"nomes_colunas\": nomes_colunas,\n","        \"tabela_m4\": tabela_m4, \"tabela_vif\": tabela_vif_out,\n","        \"r2\": r2, \"r2_ajustado\": r2_ajustado, \"n_obs\": n_total, \"G_coorte\": G,\n","    }\n","\n","\n","if __name__ == \"__main__\":\n","    caminho = \"/content/pnad_processado_final.parquet\"\n","    resultado = estimar_m4_mesma_base(caminho, tamanho_chunk=100_000)"],"metadata":{"colab":{"base_uri":"htt