:"execute_result","data":{"text/plain":["Index(['Ano', 'Trimestre', 'UF', 'UPA', 'V1008', 'V1014', 'V2003', 'Sexo',\n","       'Ano_Nascimento', 'Idade', 'Cor', 'Escolaridade', 'Renda_Faixa',\n","       'Renda_PEA_Reais', 'Anos_de_Estudo', 'F_Trabalho', 'Condicao_Ocupacao',\n","       'Forca_Trabalho_potencial', 'Subocupacao_por_insu_horas',\n","       'Pessoa_desalentadas', 'Categoria_emprego',\n","       'Grupo_atv_princ_empreedimento', 'Grupo_ocupacional_no_emprego',\n","       'Contribuicao_previdencia', 'Rendimento_hab_Trab_princ',\n","       'Renda_Efetivo_14_Reais', 'Rendimento_hab_Tds_Trabs',\n","       'Horas_hab_trabalhadas', 'COD_FAM', 'COD_PESSOA', 'Regiao'],\n","      dtype='object')"]},"metadata":{},"execution_count":4}]},{"cell_type":"markdown","source":["Graficos"],"metadata":{"id":"4BW3QWaYVhd-"}},{"cell_type":"code","source":["\"\"\"\n","Evolução do salário médio por hora real — PNAD Contínua (2013-2025)\n","\n","Versão otimizada:\n","  - Corrige o fator de conversão semana -> mês (era *4, o correto é 52/12).\n","  - Substitui os loops aninhados (período x sexo/setor/formalidade x região)\n","    por agregações vetorizadas com groupby/unstack.\n","  - Elimina a duplicação nos 7 gráficos, nas 7 validações e no relatório\n","    final, todos agora dirigidos por pequenas listas de configuração.\n","\"\"\"\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import matplotlib.ticker as mticker\n","\n","# ==========================================================\n","# CONSTANTES\n","# ==========================================================\n","\n","FILE_PATH = \"/content/pnad_consolidada_2013_2025.parquet\"\n","\n","REGIOES = [\"Norte\", \"Nordeste\", \"Sudeste\", \"Sul\", \"Centro-Oeste\"]\n","\n","# BUG CORRIGIDO: um mês tem em média 52/12 semanas (~4,345), não 4.\n","# Usar *4 inflava o salário/hora estimado em ~8,6% em todas as séries.\n","SEMANAS_POR_MES = 4.33\n","\n","FONTE = (\n","    \"Fonte: PNAD Contínua – IBGE (2013–2025). \"\n","    \"Valores deflacionados pelo IPCA (Base: Jan/2026).\"\n",")\n","\n","YLABEL_PADRAO = \"Salário médio por hora (R$ reais, Base Jan/2026)\"\n","XLABEL_PADRAO = \"Ano.Trimestre\"\n","\n","\n","# ==========================================================\n","# 1) LEITURA E PREPARAÇÃO DA BASE\n","# ==========================================================\n","\n","def carregar_base(file_path):\n","    df = pd.read_parquet(file_path)\n","\n","    print(\"=\" * 70)\n","    print(\"BASE CARREGADA\")\n","    print(\"=\" * 70)\n","    print(f\"Observações: {len(df):,}\")\n","    print(f\"Colunas: {len(df.columns)}\")\n","    print(f\"\\nPeríodo: {df['Ano'].min()} até {df['Ano'].max()}\")\n","\n","    df[\"Periodo\"] = df[\"Ano\"].astype(str) + \".\" + df[\"Trimestre\"].astype(str)\n","    return df\n","\n","\n","def calcular_salario_hora(df):\n","    \"\"\"Calcula o salário/hora linha a linha, de forma vetorizada.\"\"\"\n","    horas = df[\"Horas_hab_trabalhadas\"].replace(0, np.nan)\n","    rendimento = df[\"Rendimento_hab_Trab_princ\"]\n","\n","    valido = horas.notna() & rendimento.notna()\n","\n","    salario_hora = pd.Series(np.nan, index=df.index)\n","    salario_hora[valido] = rendimento[valido] / (horas[valido] * SEMANAS_POR_MES)\n","    return salario_hora\n","\n","\n","def classificar_grupos(df):\n","    \"\"\"Cria as colunas de corte: Sexo_Grupo, Setor e Formalidade.\"\"\"\n","\n","    df[\"Sexo_Grupo\"] = df[\"Sexo\"].map({1: \"Homem\", 2: \"Mulher\"})\n","\n","    df[\"Setor\"] = np.where(\n","        df[\"Categoria_emprego\"].isin([5, 6, 7]), \"Publico\", \"Privado\"\n","    )\n","\n","    formal = df[\"Categoria_emprego\"].isin([1, 3, 5, 7]) | (\n","        df[\"Categoria_emprego\"].isin([8, 9])\n","        & (df[\"Contribuicao_previdencia\"] == 1)\n","    )\n","    informal = df[\"Categoria_emprego\"].isin([2, 4, 6, 10]) | (\n","        df[\"Categoria_emprego\"].isin([8, 9])\n","        & (df[\"Contribuicao_previdencia\"] == 2)\n","    )\n","    df[\"Formalidade\"] = np.select([formal, informal], [\"Formal\", \"Informal\"], default=None)\n","\n","    return df\n","\n","\n","# ==========================================================\n","# 2) AGREGAÇÃO (VETORIZADA)\n","# ==========================================================\n","\n","def agregar_dimensao(df, periodos_ordenados, coluna_corte=None, categorias=None):\n","    \"\"\"\n","    Agrega o salário/hora médio por Período x Região, com um corte opcional\n","    (Sexo_Grupo, Setor ou Formalidade).\n","\n","    Sem corte -> colunas: Norte, Nordeste, ..., Brasil\n","    Com corte -> colunas: {categoria}_{regiao}, ..., Brasil_{categoria}\n","    \"\"\"\n","    resultado = pd.DataFrame(index=pd.Index(periodos_ordenados, name=\"Periodo\"))\n","\n","    if coluna_corte is None:\n","        tabela = (\n","            df.groupby([\"Periodo\", \"Regiao\"])[\"Salario_Hora\"]\n","            .mean()\n","            .round(2)\n","            .unstack(\"Regiao\")\n","        )\n","        for reg in REGIOES:\n","            resultado[reg] = tabela.get(reg)\n","        resultado[\"Brasil\"] = df.groupby(\"Periodo\")[\"Salario_Hora\"].mean().round(2)\n","        return resultado\n","\n","    for cat in categorias:\n","        sub = df[df[coluna_corte] == cat]\n","        tabela = (\n","            sub.groupby([\"Periodo\", \"Regiao\"])[\"Salario_Hora\"]\n","            .mean()\n","            .round(2)\n","            .unstack(\"Regiao\")\n","        )\n","        for reg in REGIOES:\n","            resultado[f\"{cat}_{reg}\"] = tabela.get(reg)\n","        resultado[f\"Brasil_{cat}\"] = sub.groupby(\"Periodo\")[\"Salario_Hora\"].mean().round(2)\n","\n","    return resultado\n","\n","\n","def montar_df_resultados(df, periodos_ordenados):\n","    partes = [\n","        agregar_dimensao(df, periodos_ordenados),\n","        agregar_dimensao(df, periodos_ordenados, \"Sexo_Grupo\", [\"Homem\", \"Mulher\"]),\n","        agregar_dimensao(df, periodos_ordenados, \"Setor\", [\"Publico\", \"Privado\"]),\n","        agregar_dimensao(df, periodos_ordenados, \"Formalidade\", [\"Formal\", \"Informal\"]),\n","    ]\n","    df_res = pd.concat(partes, axis=1).reset_index()\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"DATAFRAME DE RESULTADOS\")\n","    print(\"=\" * 70)\n","    print(f\"Períodos calculados: {len(df_res)}\")\n","    print(f\"Colunas calculadas: {len(df_res.columns)}\")\n","    print(\"\\nPrimeiros resultados:\")\n","    print(df_res.head(3))\n","\n","    return df_res\n","\n","\n","# ==========================================================\n","# 3) NOMES DAS LEGENDAS (gerados, não digitados um a um)\n","# ==========================================================\n","\n","def montar_nomes_legenda():\n","    nomes = {reg: reg for reg in REGIOES}\n","    nomes[\"Brasil\"] = \"Brasil\"\n","\n","    for prefixo in [\"Homem\", \"Mulher\", \"Publico\", \"Privado\", \"Formal\", \"Informal\"]:\n","        for reg in REGIOES:\n","            nomes[f\"{prefixo}_{reg}\"] = reg\n","        nomes[f\"Brasil_{prefixo}\"] = \"Brasil\"\n","\n","    return nomes\n","\n","\n","NOMES_LEGENDA = montar_nomes_legenda()\n","\n","\n","# ==========================================================\n","# 4) FUNÇÃO DE PLOTAGEM\n","# ==========================================================\n","\n","def plot_salario(df_plot, colunas, titulo, nome_arquivo, ncol_legenda=3,\n","                  ylabel=YLABEL_PADRAO, xlabel=XLABEL_PADRAO):\n","\n","    df_plot = df_plot.copy()\n","    periodo_split = df_plot[\"Periodo\"].astype(str).str.split(\".\", expand=True)\n","    df_plot[\"_Ano\"] = periodo_split[0].astype(int)\n","    df_plot[\"_Trimestre\"] = periodo_split[1].astype(int)\n","\n","    fig, ax = plt.subplots(figsize=(26, 11), dpi=300)\n","\n","    lines = {}\n","    for col in colunas:\n","        label = NOMES_LEGENDA.get(col, col)\n","        (line,) = ax.plot(\n","            df_plot[\"Periodo\"], df_plot[col],\n","            marker=\"o\", markersize=5, linewidth=1.8, label=label,\n","        )\n","        lines[col] = line\n","\n","    ax.set_title(titulo, fontsize=18, pad=28, fontweight=\"bold\")\n","    ax.set_ylabel(ylabel, fontsize=13)\n","    ax.set_xlabel(xlabel, fontsize=13)\n","    ax.grid(True, which=\"major\", axis=\"both\", linestyle=\"--\", linewidth=0.7, alpha=0.5)\n","    ax.tick_params(axis=\"x\", rotation=45, labelsize=9)\n","    ax.tick_params(axis=\"y\", labelsize=11)\n","    ax.yaxis.set_major_formatter(mticker.FormatStrFormatter(\"R$ %.0f\"))\n","\n","    # Eixo Y não começa em zero (mas nunca fica negativo)\n","    valores = df_plot[colunas].values.flatten()\n","    valores = valores[~pd.isna(valores)]\n","\n","    if len(valores) > 0:\n","        y_min_obs, y_max_obs = np.min(valores), np.max(valores)\n","        amplitude = y_max_obs - y_min_obs\n","        margem = amplitude * 0.08 if amplitude > 0 else abs(y_min_obs) * 0.05\n","\n","        y_inf = max(y_min_obs - margem, 0)\n","        y_sup = y_max_obs + margem\n","        ax.set_ylim(y_inf, y_sup)\n","\n","    ax.legend(\n","        loc=\"upper center\", bbox_to_anchor=(0.5, -0.18),\n","        ncol=ncol_legenda, fontsize=11, frameon=True,\n","    )\n","    fig.text(0.01, -0.03, FONTE, fontsize=9, color=\"gray\", style=\"italic\")\n","    plt.tight_layout()\n","    fig.canvas.draw()\n","\n","    _desenhar_rotulos(ax, fig, df_plot, colunas, lines)\n","\n","    for sufixo, dpi in [(\"300dpi\", 300), (\"100dpi\", 100)]:\n","        fname = f\"{nome_arquivo}_{sufixo}.png\"\n","        plt.savefig(fname, dpi=dpi, bbox_inches=\"tight\")\n","        print(f\"Salvo: {fname}\")\n","\n","    plt.show()\n","    plt.close()\n","\n","\n","def _desenhar_rotulos(ax, fig, df_plot, colunas, lines, min_gap_pt=16, font_size=7.5):\n","    \"\"\"Desenha os rótulos numéricos apenas no 4º trimestre, evitando sobreposição.\"\"\"\n","\n","    y_min, y_max = ax.get_ylim()\n","    ax_height_pt = ax.get_window_extent().height * 72 / fig.dpi\n","    pts_por_unidade = ax_height_pt / (y_max - y_min)\n","\n","    indices_rotulos = df_plot.index[df_plot[\"_Trimestre\"] == 4].tolist()\n","\n","    for idx in indices_rotulos:\n","        pontos = [\n","            (df_plot.loc[idx, col], col)\n","            for col in colunas\n","            if pd.notna(df_plot.loc[idx, col])\n","        ]\n","        if not pontos:\n","            continue\n","\n","        pontos = sorted(pontos, key=lambda x: x[0], reverse=True)\n","\n","        label_pos_pt = []\n","        for k, (val, _col) in enumerate(pontos):\n","            val_pt = val * pts_por_unidade\n","            if k == 0:\n","                pos = val_pt + min_gap_pt\n","            else:\n","                pos = min(val_pt - min_gap_pt, label_pos_pt[k - 1] - min_gap_pt)\n","            label_pos_pt.append(pos)\n","\n","        for k, (val, col) in enumerate(pontos):\n","            val_pt = val * pts_por_unidade\n","            offset_y = label_pos_pt[k] - val_pt\n","            va = \"bottom\" if offset_y >= 0 else \"top\"\n","\n","            ax.annotate(\n","                f\"{val:.1f}\",\n","                (df_plot.loc[idx, \"Periodo\"], val),\n","                textcoords=\"offset points\",\n","                xytext=(0, offset_y),\n","                ha=\"center\", va=va,\n","                fontsize=font_size,\n","                color=lines[col].get_color(),\n","                fontweight=\"bold\",\n","            )\n","\n","\n","# ==========================================================\n","# 5) CONFIGURAÇÃO DOS 7 GRÁFICOS (antes eram ~700 linhas repetidas)\n","# ==========================================================\n","\n","def gerar_colunas(prefixo=None):\n","    if prefixo is None:\n","        return REGIOES + [\"Brasil\"]\n","    return [f\"{prefixo}_{r}\" for r in REGIOES] + [f\"Brasil_{prefixo}\"]\n","\n","\n","GRAFICOS = [\n","    dict(colunas=gerar_colunas(), titulo=\"Evolução do Salário Médio por Hora Real — por Região (Brasil)\",\n","         arquivo=\"grafico_1_evolucao_regiao\"),\n","    dict(colunas=gerar_colunas(\"Homem\"), titulo=\"Evolução do Salário Médio por Hora Real — Homens por Região (Brasil)\",\n","         arquivo=\"grafico_2_homens_regiao\"),\n","    dict(colunas=gerar_colunas(\"Mulher\"), titulo=\"Evolução do Salário Médio por Hora Real — Mulheres por Região (Brasil)\",\n","         arquivo=\"grafico_3_mulheres_regiao\"),\n","    dict(colunas=gerar_colunas(\"Formal\"), titulo=\"Evolução do Salário Médio por Hora Real — Trabalhadores Formais por Região (Brasil)\",\n","         arquivo=\"grafico_4_formal_regiao\"),\n","    dict(colunas=gerar_colunas(\"Informal\"), titulo=\"Evolução do Salário Médio por Hora Real — Trabalhadores Informais por Região (Brasil)\",\n","         arquivo=\"grafico_5_informal_regiao\"),\n","    dict(colunas=gerar_colunas(\"Publico\"), titulo=\"Evolução do Salário Médio por Hora Real — Setor Público por Região (Brasil)\",\n","         arquivo=\"grafico_6_publico_regiao\"),\n","    dict(colunas=gerar_colunas(\"Privado\"), titulo=\"Evolução do Salário Médio por Hora Real — Setor Privado por Região (Brasil)\",\n","         arquivo=\"grafico_7_privado_regiao\"),\n","]\n","\n","\n","def gerar_todos_os_graficos(df_res):\n","    for cfg in GRAFICOS:\n","        plot_salario(\n","            df_plot=df_res[[\"Periodo\"] + cfg[\"colunas\"]],\n","            colunas=cfg[\"colunas\"],\n","            titulo=cfg[\"titulo\"],\n","            nome_arquivo=cfg[\"arquivo\"],\n","        )\n","    print(f\"\\nTotal de gráficos gerados: {len(GRAFICOS)}\")\n","\n","\n","# ==========================================================\n","# 6) VALIDAÇÃO — Brasil precisa estar dentro do intervalo regional\n","# ==========================================================\n","\n","def validar_brasil(df, colunas_regioes, coluna_brasil):\n","    erros = []\n","\n","    for _, row in df.iterrows():\n","        valores = [row[c] for c in colunas_regioes if pd.notna(row[c])]\n","        if not valores or pd.isna(row[coluna_brasil]):\n","            continue\n","\n","        minimo, maximo, brasil = min(valores), max(valores), row[coluna_brasil]\n","        if brasil < minimo or brasil > maximo:\n","            erros.append({\n","                \"Periodo\": row[\"Periodo\"],\n","                \"Brasil\": brasil,\n","                \"Min_Regiao\": minimo,\n","                \"Max_Regiao\": maximo,\n","            })\n","\n","    return pd.DataFrame(erros)\n","\n","\n","VALIDACOES_CFG = [\n","    (\"Geral\", None),\n","    (\"Homens\", \"Homem\"),\n","    (\"Mulheres\", \"Mulher\"),\n","    (\"Formal\", \"Formal\"),\n","    (\"Informal\", \"Informal\"),\n","    (\"Público\", \"Publico\"),\n","    (\"Privado\", \"Privado\"),\n","]\n","\n","\n","def rodar_validacoes(df_res):\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"VALIDAÇÃO DAS MÉDIAS BRASIL\")\n","    print(\"=\" * 70)\n","\n","    for nome, prefixo in VALIDACOES_CFG:\n","        colunas_regioes = gerar_colunas(prefixo)[:-1]  # remove o \"Brasil\" do fim\n","        coluna_brasil = \"Brasil\" if prefixo is None else f\"Brasil_{prefixo}\"\n","\n","        erros = validar_brasil(df_res, colunas_regioes, coluna_brasil)\n","\n","        if len(erros) == 0:\n","            print(f\"✓ {nome}: Brasil está dentro do intervalo das médias regionais em todos os períodos.\")\n","        else:\n","            print(f\"⚠ {nome}: {len(erros)} período(s) fora do intervalo regional.\")\n","            print(erros.head(10))\n","\n","\n","# ==========================================================\n","# 7) COMPARAÇÃO FINAL — ÚLTIMO PERÍODO\n","# ==========================================================\n","\n","GRUPOS_COMPARACAO = [\n","    (\"SETOR PÚBLICO\", \"Publico\"),\n","    (\"SETOR PRIVADO\", \"Privado\"),\n","    (\"HOMENS\", \"Homem\"),\n","    (\"MULHERES\", \"Mulher\"),\n","    (\"FORMAL\", \"Formal\"),\n","    (\"INFORMAL\", \"Informal\"),\n","]\n","\n","\n","def imprimir_comparacao_final(df_res):\n","    ultimo = df_res.iloc[-1]\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(f\"COMPARAÇÃO NO ÚLTIMO PERÍODO: {ultimo['Periodo']}\")\n","    print(\"=\" * 70)\n","\n","    for titulo, prefixo in GRUPOS_COMPARACAO:\n","        print(f\"\\n{titulo}:\")\n","        for reg in REGIOES:\n","            print(f\"{reg:15s}: R$ {ultimo[f'{prefixo}_{reg}']:.2f}\")\n","        print(f\"{'Brasil':15s}: R$ {ultimo[f'Brasil_{prefixo}']:.2f}\")\n","\n","\n","# ==========================================================\n","# MAIN\n","# ==========================================================\n","\n","def main():\n","    df = carregar_base(FILE_PATH)\n","\n","    periodos_ordenados = (\n","        df[[\"Ano\", \"Trimestre\", \"Periodo\"]]\n","        .drop_duplicates()\n","        .sort_values([\"Ano\", \"Trimestre\"])[\"Periodo\"]\n","        .tolist()\n","    )\n","    print(\"\\nPeríodos encontrados:\")\n","    print(periodos_ordenados)\n","    print(f\"\\nTotal de períodos: {len(periodos_ordenados)}\")\n","\n","    df[\"Salario_Hora\"] = calcular_salario_hora(df)\n","    df = classificar_grupos(df)\n","\n","    df_res = montar_df_resultados(df, periodos_ordenados)\n","\n","    gerar_todos_os_graficos(df_res)\n","    rodar_validacoes(df_res)\n","    imprimir_comparacao_final(df_res)\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"PROCESSAMENTO CONCLUÍDO\")\n","    print(\"=\" * 70)\n","\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1dOaDvOEKILvDs3I4v-dzSjPqMq2qVAqL"},"id":"LqLDdP2aYRe1","executionInfo":{"status":"ok","timestamp":1787250690583,"user_tz":180,"elapsed":137374,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"cee93a57-1645-4dba-b5b7-a51d85c8fced"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}]},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.ticker as mticker\n","import math\n","\n","# ==========================================================\n","# 1) Leitura e preparação\n","# ==========================================================\n","\n","file_path = '/content/pnad_consolidada_2013_2025.parquet'\n","df = pd.read_parquet(file_path)\n","\n","df[\"Periodo\"] = df[\"Ano\"].astype(str) + \".\" + df[\"Trimestre\"].astype(str)\n","\n","# Salário/hora calculado uma única vez, vetorizado\n","mask_valido = (\n","    df[\"Horas_hab_trabalhadas\"].replace(0, np.nan).notna() &\n","    df[\"Rendimento_hab_Trab_princ\"].notna() &\n","    df[\"Anos_de_Estudo\"].notna() &\n","    df[\"Regiao\"].notna()\n",")\n","df = df.loc[mask_valido].copy()\n","df[\"Salario_Hora\"] = df[\"Rendimento_hab_Trab_princ\"] / (df[\"Horas_hab_trabalhadas\"] * 4.33)\n","\n","# A PNAD topcodeia Anos_de_Estudo em 16 -- trava o intervalo válido\n","df = df[df[\"Anos_de_Estudo\"].between(0, 16)]\n","df[\"Anos_de_Estudo\"] = df[\"Anos_de_Estudo\"].astype(int)\n","\n","FONTE = \"Fonte: PNAD Contínua – IBGE (2013–2025). Valores deflacionados pelo IPCA (Base: Jan/2026).\"\n","\n","# ==========================================================\n","# 2) Faixas de escolaridade\n","# ==========================================================\n","\n","FAIXAS = [\n","    (0, 4,  \"0 a 4 anos (Fund. incompleto)\"),\n","    (5, 8,  \"5 a 8 anos (Fund. completo)\"),\n","    (9, 11, \"9 a 11 anos (Médio)\"),\n","    (12, 14, \"12 a 14 anos (Sup. incompleto)\"),\n","    (15, 16, \"15 a 16 anos (Sup. completo+)\"),\n","]\n","\n","\n","def rotular_faixa(anos):\n","    for lo, hi, label in FAIXAS:\n","        if lo <= anos <= hi:\n","            return label\n","    return np.nan\n","\n","\n","df[\"Faixa_Estudo\"] = df[\"Anos_de_Estudo\"].apply(rotular_faixa)\n","\n","periodos_ordenados = (\n","    df[[\"Ano\", \"Trimestre\", \"Periodo\"]]\n","    .drop_duplicates()\n","    .sort_values([\"Ano\", \"Trimestre\"])\n","    [\"Periodo\"]\n","    .tolist()\n",")\n","\n","colunas_faixas = [label for _, _, label in FAIXAS]\n","regioes_ordenadas = sorted(df[\"Regiao\"].dropna().unique().tolist())\n","\n","# ------------------------------------------------------------\n","# Média Brasil, por Período x Faixa (linha de referência em todos os gráficos)\n","# ------------------------------------------------------------\n","tab_faixas_brasil = (\n","    df.groupby([\"Periodo\", \"Faixa_Estudo\"])[\"Salario_Hora\"]\n","    .mean()\n","    .round(2)\n","    .unstack(\"Faixa_Estudo\")\n","    .reindex(periodos_ordenados)[colunas_faixas]\n",")\n","\n","# ------------------------------------------------------------\n","# Média por Região, Período x Faixa\n","# ------------------------------------------------------------\n","tab_faixas_regiao = (\n","    df.groupby([\"Periodo\", \"Faixa_Estudo\", \"Regiao\"])[\"Salario_Hora\"]\n","    .mean()\n","    .round(2)\n","    .unstack(\"Regiao\")\n","    .reindex(periodos_ordenados, level=\"Periodo\")\n",")\n","\n","\n","# ==========================================================\n","# 3) Função genérica de plot: evolução por região + média Brasil,\n","#    TODAS as faixas selecionadas juntas em um único gráfico\n","#    (cor = região / Brasil, estilo de linha = faixa de escolaridade)\n","# ==========================================================\n","\n","LINESTYLES = [\"-\", \"--\", \"-.\", \":\", (0, (3, 1, 1, 1))]\n","\n","\n","def plot_evolucao_regioes(faixas_selecionadas, nome_arquivo, figsize=(18, 10)):\n","    fig, ax = plt.subplots(figsize=figsize, dpi=300)\n","\n","    cmap = plt.get_cmap(\"tab10\")\n","    cores_regiao = {reg: cmap(i % 10) for i, reg in enumerate(regioes_ordenadas)}\n","    faixa_linestyle = {faixa: LINESTYLES[i % len(LINESTYLES)]\n","                        for i, faixa in enumerate(faixas_selecionadas)}\n","\n","    # Posições (no eixo x categórico) referentes ao último trimestre de cada ano\n","    idx_ultimo_tri = [pos for pos, periodo in enumerate(periodos_ordenados)\n","                       if periodo.split(\".\")[-1] == \"4\"]\n","\n","    for faixa in faixas_selecionadas:\n","        ls = faixa_linestyle[faixa]\n","\n","        # Linhas por região\n","        sub = tab_faixas_regiao.xs(faixa, level=\"Faixa_Estudo\").reindex(periodos_ordenados)\n","        for regiao in regioes_ordenadas:\n","            if regiao not in sub.columns:\n","                continue\n","            valores = sub[regiao].values\n","            ax.plot(periodos_ordenados, valores, marker=\"o\", markersize=3,\n","                    linewidth=1.3, linestyle=ls, color=cores_regiao[regiao],\n","                    alpha=0.85, label=f\"{regiao} — {faixa}\")\n","\n","            for pos in idx_ultimo_tri:\n","                v = valores[pos]\n","                if pd.isna(v):\n","                    continue\n","                ax.annotate(f\"{v:.0f}\", (pos, v), textcoords=\"offset points\",\n","                            xytext=(0, 5), ha=\"center\", fontsize=6,\n","                            color=cores_regiao[regiao])\n","\n","        # Linha Brasil (destacada, sempre preta, mesmo estilo da faixa)\n","        valores_brasil = tab_faixas_brasil[faixa].values\n","        ax.plot(periodos_ordenados, valores_brasil,\n","                marker=\"o\", markersize=4, linewidth=2.4,\n","                linestyle=ls, color=\"black\", label=f\"Brasil (média) — {faixa}\", zorder=10)\n","\n","        for pos in idx_ultimo_tri:\n","            v = valores_brasil[pos]\n","            if pd.isna(v):\n","                continue\n","            ax.annotate(f\"{v:.0f}\", (pos, v), textcoords=\"offset points\",\n","                        xytext=(0, 8), ha=\"center\", fontsize=7,\n","                        fontweight=\"bold\", color=\"black\", zorder=11)\n","\n","    ax.set_title(\"Evolução do Salário Médio por Hora Real, por Região (Brasil)\",\n","                 fontsize=18, pad=24, fontweight=\"bold\")\n","    ax.set_ylabel(\"Salário médio por hora (R$ reais, Base Jan/2026)\", fontsize=13)\n","    ax.set_xlabel(\"Ano.Trimestre\", fontsize=13)\n","    ax.grid(True, axis=\"both\", alpha=0.25, linewidth=0.6)\n","    ax.set_axisbelow(True)\n","    ax.tick_params(axis=\"x\", rotation=45, labelsize=8)\n","    ax.tick_params(axis=\"y\", labelsize=11)\n","    ax.yaxis.set_major_formatter(mticker.FormatStrFormatter('R$ %.0f'))\n","\n","    # Amostra alguns rótulos no eixo x, senão fica ilegível\n","    step = max(1, len(periodos_ordenados) // 15)\n","    ax.set_xticks(periodos_ordenados[::step])\n","\n","    handles, labels = ax.get_legend_handles_labels()\n","    ax.legend(handles, labels, loc=\"upper center\", bbox_to_anchor=(0.5, -0.16),\n","              ncol=min(len(regioes_ordenadas) + 1, 6), fontsize=8, frameon=True)\n","\n","    fig.text(0.01, -0.02, FONTE, fontsize=9, color=\"gray\", style=\"italic\")\n","    plt.tight_layout()\n","\n","    for sufixo, dpi in [(\"300dpi\", 300), (\"100dpi\", 100)]:\n","        fname = f\"{nome_arquivo}_{sufixo}.png\"\n","        plt.savefig(fname, dpi=dpi, bbox_inches=\"tight\")\n","        print(f\"Salvo: {fname}\")\n","\n","    plt.show()\n","    plt.close()\n","\n","\n","# ==========================================================\n","# 4) GRÁFICO -- apenas Fund. incompleto e Superior completo+, por região + Brasil,\n","#    combinadas em um único gráfico\n","# ==========================================================\n","\n","faixas_extremos = [\n","    \"0 a 4 anos (Fund. incompleto)\",\n","    \"15 a 16 anos (Sup. completo+)\",\n","]\n","\n","plot_evolucao_regioes(faixas_extremos, nome_arquivo=\"grafico_evolucao_extremos_regioes\",\n","                       figsize=(18, 10))\n","\n","print(\"\\nGráficos gerados com sucesso!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":817},"id":"5LIFdJOcPaPg","executionInfo":{"status":"ok","timestamp":1787251203873,"user_tz":180,"elapsed":54601,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"b6a8a1ff-84d3-4c4f-cdc8-28d39d421aaa"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Salvo: grafico_evolucao_extremos_regioes_300dpi.png\n","Salvo: grafico_evolucao_extremos_regioes_100dpi.png\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 5400x3000 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Gráficos gerados com sucesso!\n"]}]},{"cell_type":"code","source":["\"\"\"\n","Gráficos — Evolução do Salário Médio por Hora Real por Faixa de Idade\n","(um gráfico para Homens comparando todas as faixas, outro para Mulheres),\n","ao longo de todos os períodos (Ano.Trimestre), 2013-2025.\n","\n","Usa o mesmo estilo/função de plotagem do script de referência\n","(grafico_1a/1b/1c/1d), só trocando a fonte de dados e o agrupamento\n","(Sexo x Faixa_Idade em vez de Sexo x Setor x Formalidade x Região).\n","\n","Fonte dos dados: pnad_consolidada_2013_2025.parquet (microdados brutos,\n","já filtrados para ocupados/força de trabalho — Condicao_Ocupacao=1,\n","F_Trabalho=1 — e idade 25-65). salario_hora é construído aqui a partir\n","de Rendimento_hab_Trab_princ / Horas_hab_trabalhadas.\n","\"\"\"\n","\n","import pyarrow.parquet as pq\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.ticker as mticker\n","\n","# ---------------------------------------------------------------\n","# 1. Configuração\n","# ---------------------------------------------------------------\n","CAMINHO_PARQUET = \"/content/pnad_consolidada_2013_2025.parquet\"\n","\n","MAPA_SEXO = {1: \"Homem\", 2: \"Mulher\"}\n","\n","# Faixas etárias de 5 em 5 anos (dataset já filtrado para 25-65 anos)\n","FAIXAS_IDADE = [25, 30, 35, 40, 45, 50, 55, 60, 66]\n","ROTULOS_IDADE = [\n","    \"25-29\", \"30-34\", \"35-39\", \"40-44\",\n","    \"45-49\", \"50-54\", \"55-59\", \"60-65\",\n","]\n","\n","SEMANAS_POR_MES = 4.33\n","\n","APLICAR_FILTRO_OUTLIER = True\n","PERCENTIL_CORTE_OUTLIER = 0.99  # calculado por grupo Sexo x Faixa_Idade\n","\n","FONTE = \"Fonte: PNAD Contínua – IBGE (2013–2025). Valores deflacionados pelo IPCA (Base: Jan/2026).\"\n","\n","\n","# ---------------------------------------------------------------\n","# 2. Carregamento e construção das variáveis\n","# ---------------------------------------------------------------\n","def carregar_dados(caminho: str) -> pd.DataFrame:\n","    colunas = [\n","        \"Ano\", \"Trimestre\", \"Sexo\", \"Idade\",\n","        \"Rendimento_hab_Trab_princ\", \"Horas_hab_trabalhadas\",\n","    ]\n","    df = pq.read_table(caminho, columns=colunas).to_pandas()\n","\n","    df = df[(df[\"Rendimento_hab_Trab_princ\"] > 0) & (df[\"Horas_hab_trabalhadas\"] > 0)].copy()\n","\n","    df[\"salario_hora\"] = df[\"Rendimento_hab_Trab_princ\"] / (\n","        df[\"Horas_hab_trabalhadas\"] * SEMANAS_POR_MES\n","    )\n","\n","    df[\"Sexo_label\"] = df[\"Sexo\"].map(MAPA_SEXO)\n","\n","    df[\"Faixa_Idade\"] = pd.cut(\n","        df[\"Idade\"], bins=FAIXAS_IDADE, labels=ROTULOS_IDADE,\n","        right=False, include_lowest=True,\n","    )\n","\n","    df[\"Periodo\"] = df[\"Ano\"].astype(str) + \".\" + df[\"Trimestre\"].astype(str)\n","    df[\"_ordem_periodo\"] = df[\"Ano\"] * 10 + df[\"Trimestre\"]\n","\n","    return df\n","\n","\n","def aplicar_filtro_outlier(df: pd.DataFrame) -> pd.DataFrame:\n","    if not APLICAR_FILTRO_OUTLIER:\n","        return df\n","    antes = len(df)\n","    limite_sup = (\n","        df.groupby([\"Sexo_label\", \"Faixa_Idade\"], observed=True)[\"salario_hora\"]\n","        .transform(lambda s: s.quantile(PERCENTIL_CORTE_OUTLIER))\n","    )\n","    df = df[df[\"salario_hora\"] <= limite_sup]\n","    print(f\"Filtro de outlier (p{int(PERCENTIL_CORTE_OUTLIER*100)} por grupo): \"\n","          f\"{antes:,} -> {len(df):,} obs ({(antes - len(df)) / antes:.2%} removidas)\")\n","    return df\n","\n","\n","def construir_serie(df: pd.DataFrame, sexo_label: str) -> pd.DataFrame:\n","    \"\"\"Retorna um DataFrame largo: uma linha por Periodo, uma coluna por\n","    Faixa_Idade, com a média de salario_hora — pronto para plot_salario.\"\"\"\n","    sub = df[df[\"Sexo_label\"] == sexo_label]\n","\n","    agregado = (\n","        sub.groupby([\"_ordem_periodo\", \"Periodo\", \"Faixa_Idade\"], observed=True)[\"salario_hora\"]\n","        .mean()\n","        .reset_index()\n","    )\n","\n","    largo = agregado.pivot_table(\n","        index=[\"_ordem_periodo\", \"Periodo\"], columns=\"Faixa_Idade\",\n","        values=\"salario_hora\", observed=True,\n","    ).reset_index()\n","\n","    largo = largo.sort_values(\"_ordem_periodo\").drop(columns=\"_ordem_periodo\")\n","    largo = largo[[\"Periodo\"] + [c for c in ROTULOS_IDADE if c in largo.columns]]\n","\n","    return largo\n","\n","\n","# ---------------------------------------------------------------\n","# 3. Função de plotagem — versão adaptada para muitas séries (8 faixas\n","#    etárias x ~52 períodos). O script de referência anota TODOS os\n","#    pontos, o que funciona bem com 2-6 linhas mas vira uma \"parede de\n","#    números\" com 8 linhas próximas entre si. Mudanças aqui:\n","#      - remove os rótulos numéricos em cada ponto (a principal fonte\n","#        de poluição visual)\n","#      - usa uma paleta de alto contraste + estilos de linha alternados\n","#        (sólido/tracejado), já que cores puras do ciclo padrão ficam\n","#        parecidas demais com 8 séries\n","#      - rotula cada linha só uma vez, no fim, direto ao lado do último\n","#        ponto (mais fácil de ler do que caçar a legenda embaixo)\n","#      - reduz a densidade do eixo X (mostra só o 1º trimestre de cada\n","#        ano) para não empilhar 52 rótulos girados\n","# ---------------------------------------------------------------\n","PALETA_ALTO_CONTRASTE = [\n","    \"#1f77b4\", \"#d62728\", \"#2ca02c\", \"#9467bd\",\n","    \"#ff7f0e\", \"#17becf\", \"#8c564b\", \"#e377c2\",\n","]\n","ESTILOS_LINHA = [\"-\", \"--\"]  # alterna sólido/tracejado a cada 2 séries\n","\n","\n","def plot_salario(df_plot, colunas, titulo, ylabel, xlabel, nome_arquivo, ncol_legenda=3):\n","    fig, ax = plt.subplots(figsize=(26, 11), dpi=300)\n","\n","    lines = {}\n","    for i, col in enumerate(colunas):\n","        cor = PALETA_ALTO_CONTRASTE[i % len(PALETA_ALTO_CONTRASTE)]\n","        estilo = ESTILOS_LINHA[(i // len(PALETA_ALTO_CONTRASTE)) % len(ESTILOS_LINHA)]\n","        line = ax.plot(df_plot[\"Periodo\"], df_plot[col],\n","                        marker='o', markersize=4, label=col, linewidth=2.0,\n","                        color=cor, linestyle=estilo, alpha=0.9)\n","        lines[col] = line[0]\n","\n","    ax.set_title(titulo, fontsize=18, pad=28, fontweight='bold')\n","    ax.set_ylabel(ylabel, fontsize=13)\n","    ax.set_xlabel(xlabel, fontsize=13)\n","    ax.grid(axis='y', linestyle=':', linewidth=0.6, color='lightgray', alpha=0.7)\n","    ax.set_axisbelow(True)\n","    ax.tick_params(axis='y', labelsize=11)\n","    ax.yaxis.set_major_formatter(mticker.FormatStrFormatter('R$ %.0f'))\n","    ax.yaxis.set_major_locator(mticker.MultipleLocator(5))  # ticks sempre de 5 em 5, uniformes\n","    ax.legend(loc='upper center', bbox_to_anchor=(0.5, -0.16),\n","              ncol=8, fontsize=11, frameon=True)\n","    fig.text(0.01, -0.05, FONTE, fontsize=9, color='gray', style='italic')\n","\n","    # Eixo X: mostra todos os períodos (Ano.Trimestre) disponíveis, em diagonal.\n","    periodos = df_plot[\"Periodo\"].tolist()\n","    ax.set_xticks(periodos)\n","    ax.set_xticklabels(periodos, rotation=45, ha='right', fontsize=8)\n","\n","    # Espaço à direita não é mais necessário (rótulos de fim de linha\n","    # foram substituídos pela legenda embaixo do gráfico).\n","\n","    # Eixo Y começando em 0, com margem no topo\n","    _, y_max = ax.get_ylim()\n","    ax.set_ylim(0, y_max * 1.08)\n","\n","    plt.tight_layout()\n","    fig.canvas.draw()\n","\n","    for sufixo, dpi in [(\"300dpi\", 300), (\"100dpi\", 100)]:\n","        fname = f\"{nome_arquivo}_{sufixo}.png\"\n","        plt.savefig(fname, dpi=dpi, bbox_inches='tight')\n","        print(f\"Salvo: {fname}\")\n","\n","    plt.show()\n","    plt.close()\n","\n","\n","# ---------------------------------------------------------------\n","# 4. Execução\n","# ---------------------------------------------------------------\n","def main():\n","    print(\"Carregando dados...\")\n","    df = carregar_dados(CAMINHO_PARQUET)\n","    print(f\"Total lido: {len(df):,} observações\")\n","\n","    df = aplicar_filtro_outlier(df)\n","\n","    print(\"Construindo séries por Sexo x Faixa de Idade...\")\n","    df_homem = construir_serie(df, \"Homem\")\n","    df_mulher = construir_serie(df, \"Mulher\")\n","\n","    colunas_idade_homem = [c for c in ROTULOS_IDADE if c in df_homem.columns]\n","    colunas_idade_mulher = [c for c in ROTULOS_IDADE if c in df_mulher.columns]\n","\n","    print(\"Gerando gráfico — Homens por faixa de idade...\")\n","    plot_salario(\n","        df_plot=df_homem,\n","        colunas=colunas_idade_homem,\n","        titulo=\"Evolução do Salário Médio por Hora Real — Homens por Faixa de Idade (Brasil)\",\n","        ylabel=\"Salário médio por hora (R$ reais, Base Jan/2026)\",\n","        xlabel=\"Ano.Trimestre\",\n","        nome_arquivo=\"grafico_2a_homens_faixa_idade\",\n","        ncol_legenda=4,\n","    )\n","\n","    print(\"Gerando gráfico — Mulheres por faixa de idade...\")\n","    plot_salario(\n","        df_plot=df_mulher,\n","        colunas=colunas_idade_mulher,\n","        titulo=\"Evolução do Salário Médio por Hora Real — Mulheres por Faixa de Idade (Brasil)\",\n","        ylabel=\"Salário médio por hora (R$ reais, Base Jan/2026)\",\n","        xlabel=\"Ano.Trimestre\",\n","        nome_arquivo=\"grafico_2b_mulheres_faixa_idade\",\n","        ncol_legenda=4,\n","    )\n","\n","    print(\"\\nTodos os gráficos foram gerados com sucesso!\")\n","\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"CxGPITdgH-eN","executionInfo":{"status":"ok","timestamp":1786915100730,"user_tz":180,"elapsed":19398,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"c3a86c23-cc6b-4135-f7e9-8d49f735a11b"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Carregando dados...\n","Total lido: 9,066,345 observações\n","Filtro de outlier (p99 por grupo): 9,066,345 -> 8,975,814 obs (1.00% removidas)\n","Construindo séries por Sexo x Faixa de Idade...\n","Gerando gráfico — Homens por faixa de idade...\n","Salvo: grafico_2a_homens_faixa_idade_300dpi.png\n","Salvo: grafico_2a_homens_faixa_idade_100dpi.png\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 7800x3300 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Gerando gráfico — Mulheres por faixa de idade...\n","Salvo: grafico_2b_mulheres_faixa_idade_300dpi.png\n","Salvo: grafico_2b_mulheres_faixa_idade_100dpi.png\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 7800x3300 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Todos os gráficos foram gerados com sucesso!\n"]}]},{"cell_type":"code","source":["import pandas as pd\n","\n","# Carregando o dataset processado final\n","df_final = pd.read_parquet('/content/pnad_processado_final.parquet')\n","\n","# Exibindo as primeiras linhas e informações básicas\n","display(df_final.head())\n","df_final.info()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":269},"id":"uINkLujYMBR2","executionInfo":{"status":"error","timestamp":1786933109690,"user_tz":1