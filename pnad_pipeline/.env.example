# Configurações do Pipeline PNAD Contínua + IPCA

# Diretório base de dados (opcional, padrão: data/ no diretório raiz do pacote)
# PNAD_DATA_DIR=data

# Caminhos de saída padrão
# PNAD_DEFAULT_PARQUET_PATH=data/processed/pnad_consolidada_2013_2025.parquet
# PNAD_DEFAULT_STATA_PATH=data/processed/pnad_descritiva_2013_2025.dta

# Configurações do IPCA / Banco Central
IPCA_BCB_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.433/dados?formato=json
DATA_BASE_DEFLACAO=01/01/2026

# Período padrão de extração
DEFAULT_ANO_INICIO=2013
DEFAULT_ANO_FIM=2025

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
