arrow/error.pxi\u001b[0m in \u001b[0;36mpyarrow.lib.check_status\u001b[0;34m()\u001b[0m\n","\u001b[0;31mArrowInvalid\u001b[0m: Could not open Parquet input source '<Buffer>': Parquet magic bytes not found in footer. Either the file is corrupted or this is not a parquet file."]}]},{"cell_type":"code","source":["df_final['Coorte'].unique()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"TB7H8MncMhRf","executionInfo":{"status":"ok","timestamp":1786912660437,"user_tz":180,"elapsed":34,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"2cb78b89-f9c9-4593-a069-e52134a6c2cd"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["['1-50-54-1', '0-60-65-4', '1-55-59-4', '1-35-39-4', '0-35-39-4', ..., '0-25-29-3', '1-45-49-3', '0-45-49-3', '1-55-59-3', '1-60-65-3']\n","Length: 80\n","Categories (80, object): ['0-25-29-1', '0-25-29-2', '0-25-29-3', '0-25-29-4', ..., '1-60-65-2',\n","                          '1-60-65-3', '1-60-65-4', '1-60-65-5']"]},"metadata":{},"execution_count":13}]},{"cell_type":"code","source":["\"\"\"\n","Tabela de Coortes — Comparação 2013 vs 2025\n","Formato: linhas = Coorte (Sexo + faixa etária real, extraídos da coluna\n","`Coorte` já gerada no pipeline), colunas agrupadas = variável (2013 | 2025\n","lado a lado).\n","\n","A coluna `Coorte` do parquet vem no formato \"Sexo-Faixa-Cor\"\n","(ex.: '1-3-1'). Aqui usamos apenas os dois primeiros dígitos:\n","  - 1º dígito = Sexo (0 = Homem, 1 = Mulher)\n","  - 2º dígito = Faixa_Idade (código 1 a 8, ver FAIXA_IDADE_LABELS)\n","O 3º dígito (Cor/etnia) é ignorado nesta tabela.\n","\n","Variáveis: Salário-médio/hora, Escolaridade (anos), Formal (%),\n","Setor público (%). \"Capital (%)\" NÃO está disponível no dataset atual\n","(não há identificação de município/capital, só UF) — fica marcada como\n","placeholder (NaN) até que essa variável seja adicionada ao pipeline.\n","\"\"\"\n","\n","import pyarrow.parquet as pq\n","import pyarrow.compute as pc\n","import pandas as pd\n","import numpy as np\n","\n","# ---------------------------------------------------------------\n","# 1. Configuração\n","# ---------------------------------------------------------------\n","CAMINHO_PARQUET = \"/content/pnad_processado_final.parquet\"\n","CAMINHO_SAIDA = \"/content/tabela_coortes_2013_2025.xlsx\"\n","\n","MAPA_SEXO = {\"0\": \"Homem\", \"1\": \"Mulher\"}\n","\n","ANOS_COMPARACAO = [2013, 2025]\n","\n","# Correspondência código -> faixa etária real (mesma do pipeline principal)\n","FAIXA_IDADE_LABELS = {\n","    \"1\": \"25-29\", \"2\": \"30-34\", \"3\": \"35-39\", \"4\": \"40-44\",\n","    \"5\": \"45-49\", \"6\": \"50-54\", \"7\": \"55-59\", \"8\": \"60-65\",\n","}\n","ORDEM_FAIXAS = [\"25-29\", \"30-34\", \"35-39\", \"40-44\", \"45-49\", \"50-54\", \"55-59\", \"60-65\"]\n","\n","APLICAR_FILTRO_QUALIDADE = True  # remove salario_hora <= 0\n","\n","\n","def carregar_dados(caminho: str, anos: list[int]) -> pd.DataFrame:\n","    colunas = [\n","        \"Ano\", \"Coorte\",\n","        \"salario_hora\", \"Anos_de_Estudo\", \"is_formal\", \"is_public\",\n","    ]\n","    filtro = pc.field(\"Ano\").isin(anos)\n","    tabela = pq.read_table(caminho, columns=colunas, filters=filtro)\n","    df = tabela.to_pandas()\n","\n","    # Extrai os dois primeiros dígitos da string \"Coorte\" (Sexo-Faixa-Cor),\n","    # ignorando o terceiro (Cor/etnia)\n","    partes = df[\"Coorte\"].astype(str).str.split(\"-\", expand=True)\n","    df[\"Sexo_cod\"] = partes[0]\n","    df[\"Faixa_cod\"] = partes[1]\n","\n","    df[\"Sexo\"] = df[\"Sexo_cod\"].map(MAPA_SEXO)\n","    df[\"Faixa_Idade\"] = pd.Categorical(\n","        df[\"Faixa_cod\"].map(FAIXA_IDADE_LABELS),\n","        categories=ORDEM_FAIXAS,\n","        ordered=True,\n","    )\n","\n","    return df\n","\n","\n","def aplicar_filtros(df: pd.DataFrame) -> pd.DataFrame:\n","    if not APLICAR_FILTRO_QUALIDADE:\n","        return df\n","    antes = len(df)\n","    df = df[df[\"salario_hora\"] > 0].copy()\n","    print(f\"Filtro de qualidade: {antes:,} -> {len(df):,} obs \"\n","          f\"({(antes - len(df)) / antes:.2%} removidas)\")\n","    return df\n","\n","\n","def construir_tabela(df: pd.DataFrame) -> pd.DataFrame:\n","    \"\"\"Agrega por Sexo x Faixa_Idade x Ano, depois pivota para o\n","    formato lado a lado (2013 | 2025) por variável, replicando a tabela\n","    de referência.\"\"\"\n","\n","    agregado = (\n","        df.groupby([\"Sexo\", \"Faixa_Idade\", \"Ano\"], observed=True)\n","        .agg(\n","            Salario_medio_hora=(\"salario_hora\", \"mean\"),\n","            Escolaridade_anos=(\"Anos_de_Estudo\", \"mean\"),\n","            Formal_pct=(\"is_formal\", lambda s: s.mean() * 100),\n","            Setor_publico_pct=(\"is_public\", lambda s: s.mean() * 100),\n","            N=(\"salario_hora\", \"count\"),\n","        )\n","        .reset_index()\n","    )\n","\n","    pivô = agregado.pivot_table(\n","        index=[\"Sexo\", \"Faixa_Idade\"],\n","        columns=\"Ano\",\n","        values=[\"Salario_medio_hora\", \"Escolaridade_anos\", \"Formal_pct\", \"Setor_publico_pct\", \"N\"],\n","        observed=True,\n","    )\n","\n","    # Placeholder para \"Capital (%)\" — variável não disponível no dataset atual\n","    for ano in ANOS_COMPARACAO:\n","        pivô[(\"Capital_pct\", ano)] = np.nan\n","\n","    # Ordena colunas: variável -> ano, na mesma ordem da tabela de referência\n","    ordem_variaveis = [\n","        \"Salario_medio_hora\", \"Escolaridade_anos\",\n","        \"Formal_pct\", \"Setor_publico_pct\", \"Capital_pct\",\n","    ]\n","    pivô = pivô.reindex(\n","        columns=pd.MultiIndex.from_product([ordem_variaveis, ANOS_COMPARACAO]),\n","        level=None,\n","    )\n","\n","    pivô = pivô.round(2)\n","\n","    # Ordena linhas: Homem (faixas em ordem crescente), depois Mulher\n","    pivô = pivô.reindex(\n","        pd.MultiIndex.from_product([[\"Homem\", \"Mulher\"], ORDEM_FAIXAS]),\n","    )\n","\n","    # Rótulo único \"Coorte\" (ex.: \"Homem 25-29\"), como na tabela de referência\n","    pivô.index = [f\"{sexo} {faixa}\" for sexo, faixa in pivô.index]\n","    pivô.index.name = \"Coorte\"\n","\n","    return pivô\n","\n","\n","NOMES_VARIAVEIS_PT = {\n","    \"Salario_medio_hora\": \"Salário-médio (hora)\",\n","    \"Escolaridade_anos\": \"Escolaridade (anos)\",\n","    \"Formal_pct\": \"Formal (%)\",\n","    \"Setor_publico_pct\": \"Setor público (%)\",\n","    \"Capital_pct\": \"Capital (%)\",\n","    \"N\": \"N (obs.)\",\n","}\n","\n","\n","def salvar_excel_formatado(tabela: pd.DataFrame, caminho: str):\n","    \"\"\"Salva com cabeçalho em duas linhas mescladas (variável / ano),\n","    replicando visualmente a tabela de referência.\"\"\"\n","    from openpyxl import Workbook\n","    from openpyxl.styles import Alignment, Font, Border, Side\n","    from openpyxl.utils import get_column_letter\n","\n","    wb = Workbook()\n","    ws = wb.active\n","    ws.title = \"Coortes_2013_2025\"\n","\n","    variaveis = list(dict.fromkeys(v for v, _ in tabela.columns))  # ordem preservada, sem N\n","    anos = ANOS_COMPARACAO\n","\n","    # Cabeçalho linha 1: nome da variável (mesclado sobre as 2 colunas de ano)\n","    # Cabeçalho linha 2: ano\n","    col = 2  # coluna 1 é \"Coorte\"\n","    ws.cell(row=1, column=1, value=\"Coorte\")\n","    ws.merge_cells(start_row=1, start_column=1, end_row=2, end_column=1)\n","\n","    for var in variaveis:\n","        nome_pt = NOMES_VARIAVEIS_PT.get(var, var)\n","        ws.cell(row=1, column=col, value=nome_pt)\n","        ws.merge_cells(start_row=1, start_column=col, end_row=1, end_column=col + len(anos) - 1)\n","        for i, ano in enumerate(anos):\n","            ws.cell(row=2, column=col + i, value=ano)\n","        col += len(anos)\n","\n","    negrito = Font(bold=True)\n","    centro = Alignment(horizontal=\"center\", vertical=\"center\")\n","    borda = Border(bottom=Side(style=\"thin\"))\n","    for row in ws[1:2]:\n","        for cell in row:\n","            cell.font = negrito\n","            cell.alignment = centro\n","            cell.border = borda\n","\n","    # Linhas de dados\n","    linha_excel = 3\n","    for coorte, valores in tabela.iterrows():\n","        ws.cell(row=linha_excel, column=1, value=coorte)\n","        col = 2\n","        for var in variaveis:\n","            for ano in anos:\n","                v = valores[(var, ano)]\n","                ws.cell(row=linha_excel, column=col,\n","                         value=None if pd.isna(v) else float(v))\n","                col += 1\n","        linha_excel += 1\n","\n","    # Larguras de coluna\n","    ws.column_dimensions[\"A\"].width = 20\n","    for c in range(2, col):\n","        ws.column_dimensions[get_column_letter(c)].width = 10\n","\n","    wb.save(caminho)\n","\n","\n","def main():\n","    print(f\"Carregando dados para {ANOS_COMPARACAO}...\")\n","    df = carregar_dados(CAMINHO_PARQUET, ANOS_COMPARACAO)\n","    print(f\"Total lido: {len(df):,} observações\")\n","\n","    df = aplicar_filtros(df)\n","\n","    print(\"Construindo tabela de coortes...\")\n","    tabela = construir_tabela(df)\n","\n","    print(\"\\n--- Tabela de Coortes 2013 vs 2025 ---\")\n","    print(tabela.to_string())\n","\n","    print(\"\\nSalvando em Excel (com cabeçalho mesclado)...\")\n","    salvar_excel_formatado(tabela, CAMINHO_SAIDA)\n","\n","    print(f\"Arquivo salvo em: {CAMINHO_SAIDA}\")\n","    print(\"\\nATENÇÃO: a coluna 'Capital (%)' foi deixada como NaN — essa \"\n","          \"variável (residência na capital/região metropolitana) não existe \"\n","          \"no parquet atual, que só tem granularidade de UF.\")\n","\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1tiav4-Z2inP","executionInfo":{"status":"ok","timestamp":1786933403293,"user_tz":180,"elapsed":9477,"user":{"displayName":"CAUA SILVA","userId":"14265110906194890154"}},"outputId":"8f0d52ea-8c09-4b70-ee7f-d6ffee695b4e"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Carregando dados para [2013, 2025]...\n","Total lido: 1,381,872 observações\n","Filtro de qualidade: 1,381,872 -> 1,381,872 obs (0.00% removidas)\n","Construindo tabela de coortes...\n","\n","--- Tabela de Coortes 2013 vs 2025 ---\n","             Salario_medio_hora            Escolaridade_anos        Formal_pct        Setor_publico_pct        Capital_pct     \n","                           2013       2025              2013   2025       2013   2025              2013   2025        2013 2025\n","Coorte                                                                                                                         \n","Homem 25-29           14.640000  15.840000             10.41  11.83      62.62  57.02              8.41   6.90         NaN  NaN\n","Homem 30-34           17.190001  18.670000              9.87  11.65      63.01  59.60              9.86   8.14         NaN  NaN\n","Homem 35-39           18.270000  21.690001              8.89  11.40      60.06  61.05             10.17  10.47         NaN  NaN\n","Homem 40-44           19.520000  22.910000              8.37  10.91      59.26  61.41             10.76  11.90         NaN  NaN\n","Homem 45-49           20.629999  23.010000              7.99  10.01      58.45  60.36             11.75  12.43         NaN  NaN\n","Homem 50-54           21.350000  22.420000              7.70   9.16      56.74  59.17             12.28  11.95         NaN  NaN\n","Homem 55-59           22.080000  21.889999              7.17   8.51      52.77  55.67             11.67  11.40         NaN  NaN\n","Homem 60-65           22.629999  23.309999              6.50   8.35      44.56  50.66             10.34  11.84         NaN  NaN\n","Mulher 25-29          14.170000  15.940000             12.03  13.20      63.30  59.16             16.07  15.06         NaN  NaN\n","Mulher 30-34          16.120001  18.340000             11.51  13.10      62.76  59.68             19.35  16.86         NaN  NaN\n","Mulher 35-39          16.690001  20.270000             10.81  12.88      60.90  61.59             21.21  19.96         NaN  NaN\n","Mulher 40-44          17.020000  20.360001             10.19  12.50      60.13  62.45             22.33  22.52         NaN  NaN\n","Mulher 45-49          18.309999  20.910000              9.87  11.90      60.46  62.70             25.61  24.90         NaN  NaN\n","Mulher 50-54          19.340000  20.090000              9.40  11.17      58.63  60.51             25.71  24.11         NaN  NaN\n","Mulher 55-59          19.299999  20.440001              8.83  10.72      55.22  58.32             25.26  24.36         NaN  NaN\n","Mulher 60-65          20.030001  21.850000              8.14  10.32      43.53  51.96             20.39  23.04         NaN  NaN\n","\n","Salvando em Excel (com cabeçalho mesclado)...\n","Arquivo salvo em: /content/tabela_coortes_2013_2025.xlsx\n","\n","ATENÇÃO: a coluna 'Capital (%)' foi deixada como NaN — essa variável (residência na capital/região metropolitana) não existe no parquet atual, que só tem granularidade de UF.\n"]}]},{"cell_type":"markdown","source":["# Estimação final"],"metadata":{"id":"w-igGIx9-Lze"}},{"cell_type":"code","source":["\"\"\"\n","PIPELINE COMPLETO — M5 AJUSTADO (consolidação dos 4 scripts em execução única)\n","================================================================================\n","Junta em uma única execução, sobre uma única leitura em duas passadas do\n","parquet, o que antes era feito em 4 scripts separados (5 passadas totais):\n","\n","  [1] m5_ajustado_chunks_otimizado.py  -> Passada 1 (equações normais) +\n","      Passada 2 (resíduos, cluster sums Coorte/UF/interseção, momentos p/\n","      White) + SE cluster duplo (CGM 2011) + testes de diagnóstico + VIF.\n","  [2] wild_cluster_bootstrap_uf.py     -> bootstrap wild cluster em UF.\n","      Original reestimava beta/XtX (passada extra) e recomputava as somas\n","      por cluster UF (outra passada extra). Aqui reaproveita `beta`, `XtX`\n","      e `cluster_sums_uf` que a Passada 2 do item [1] já produziu.\n","  [3] graficos_diagnostico_m5.py       -> gráficos de resíduos, VIF e\n","      matriz de correlação. Original fazia uma passada extra pra recalcular\n","      resíduos porque só tinha o CSV de coeficientes. Aqui reaproveita os\n","      resíduos já em memória.\n","  [4] consolidar_tabela_final.py       -> junta coeficientes + bootstrap\n","      numa tabela única com estrelas de significância, efeito % aprox. e\n","      sinalização de robustez. Original lia dois CSVs do disco; aqui já\n","      tem as duas tabelas em memória (mas ainda exporta os CSVs, pra manter\n","      compatibilidade com quem quiser conferir cada etapa separadamente).\n","\n","RESULTADO: 2 passadas pelo parquet (7,15M linhas) em vez de 5.\n","\n","Lógica estatística idêntica à dos scripts originais — nada foi alterado,\n","só reorganizado pra evitar recomputação.\n","\"\"\"\n","\n","import gc\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import scipy.stats as stats\n","import pyarrow.parquet as pq\n","from patsy import dmatrix, build_design_matrices\n","\n","# =============================================================================\n","# 0. CONFIGURAÇÃO (idêntica aos 4 scripts originais)\n","# =============================================================================\n","\n","BINS_NASCIMENTO = [1947, 1952, 1957, 1962, 1967, 1972, 1977, 1982, 1988]\n","LABELS_NASCIMENTO = ['1', '2', '3', '4', '5', '6', '7', '8']\n","IDADE_MINIMA_TRABALHO = 14\n","\n","# Se True: os dummies de C(Ano, ...) continuam entrando no design (X_design_info,\n","# XtX, beta, resíduos) normalmente -- Ano segue sendo controlado como efeito fixo,\n","# absorvendo a variação ano a ano. A única mudança é que as linhas correspondentes\n","# aos dummies de Ano são removidas das TABELAS DE SAÍDA (coeficientes, VIF,\n","# matriz de correlação, bootstrap UF, tabela final) e dos gráficos -- não aparecem\n","# individualmente, só o efeito fixo em si (sem \"mostrar\" cada ano na tabela).\n","# Se False: volta ao comportamento original (todas as linhas de Ano aparecem).\n","OMITIR_EFEITOS_ANO_DA_TABELA = True\n","\n","\n","def eh_coluna_efeito_fixo_ano(nome_coluna: str) -> bool:\n","    \"\"\"Identifica colunas do design que são dummies de C(Ano, levels=...),\n","    a partir do nome gerado pelo patsy (ex.: \"C(Ano, levels=ANO_LEVELS)[T.2013]\").\"\"\"\n","    return nome_coluna.startswith(\"C(Ano\")\n","\n","DUMMIES_SETOR = [\n","    \"Setor_Industria_Geral\", \"Setor_Construcao\", \"Setor_Comercio\",\n","    \"Setor_Transporte_Armazenagem_Correio\", \"Setor_Alojamento_Alimentacao\",\n","    \"Setor_Info_Comunicacao_Financ_Imob_Prof_Adm\", \"Setor_Adm_Publica\",\n","    \"Setor_Educacao_Saude\", \"Setor_Outros_Servicos\", \"Setor_Servicos_Domesticos\",\n","]  # referência omitida: Setor_Agropecuaria\n","\n","DUMMIES_OCUPACAO = [\n","    \"Ocup_Diretores_Gerentes\", \"Ocup_Profissionais_Ciencias_Intelectuais\",\n","    \"Ocup_Tecnicos_Nivel_Medio\", \"Ocup_Apoio_Administrativo\",\n","    \"Ocup_Servicos_Vendedores_Comercio_Mercado\",\n","    \"Ocup_Qualificados_Agropecuaria_Pesca\",\n","    \"Ocup_Qualificados_Construcao_Mecanica_Oficios\",\n","    \"Ocup_Operadores_Instalacoes_Maquinas\",\n","    \"Ocup_Forcas_Armadas_Policiais_Bombeiros\",\n","]  # referência omitida: Ocup_Elementares\n","\n","REGIOES_NAO_REFERENCIA = [\"Norte\", \"Sul\", \"Centro-Oeste\", \"Sudeste\"]  # Nordeste = referência\n","NOMES_COLUNAS_REGIAO = [f\"Reg_{r}\" for r in REGIOES_NAO_REFERENCIA]\n","DUMMIES_REGIAO_FORMULA = [\n","    f\"Q('{nome}')\" if \"-\" in nome else nome for nome in NOMES_COLUNAS_REGIAO\n","]\n","\n","CODIGOS_COR_NAO_REFERENCIA = [2, 3, 4, 5]  # 1 = Branca (referência, omitida)\n","NOMES_COR = {1: \"Branca\", 2: \"Preta\", 3: \"Amarela\", 4: \"Parda\", 5: \"Indigena\"}\n","NOMES_COLUNAS_COR = [f\"Cor_{NOMES_COR[c]}\" for c in CODIGOS_COR_NAO_REFERENCIA]\n","\n","CONTROLES_BASE = (\n","    [\"Anos_de_Estudo\", \"is_formal\", \"is_public\", \"Sexo_Dummy\"]\n","    + DUMMIES_SETOR + DUMMIES_OCUPACAO + NOMES_COLUNAS_COR\n",")\n","\n","COLUNAS_NECESSARIAS = list(set(\n","    [\"salario_hora\", \"Ano\", \"Ano_Nascimento\", \"Anos_de_Estudo\", \"Regiao\", \"UF\",\n","     \"is_formal\", \"is_public\", \"Sexo_Dummy\", \"Cor\"] + DUMMIES_SETOR + DUMMIES_OCUPACAO\n","))\n","\n","\n","def montar_formula_rhs() -> str:\n","    return \" + \".join(\n","        CONTROLES_BASE + DUMMIES_REGIAO_FORMULA + [\"C(Ano, levels=ANO_LEVELS)\"]\n","    )\n","\n","\n","# =============================================================================\n","# 1. PREPARAÇÃO DE CHUNK (com downcast agressivo de dtype)\n","# =============================================================================\n","\n","def preparar_chunk(chunk: pd.DataFrame) -> pd.DataFrame:\n","    chunk[\"Ano\"] = pd.to_numeric(chunk[\"Ano\"], downcast=\"unsigned\")\n","    chunk[\"Ano_Nascimento\"] = pd.to_numeric(chunk[\"Ano_Nascimento\"], downcast=\"unsigned\")\n","    chunk[\"UF\"] = chunk[\"UF\"].astype(\"category\")\n","    chunk[\"Cor\"] = pd.to_numeric(chunk[\"Cor\"], downcast=\"integer\")\n","    chunk[\"Anos_de_Estudo\"] = pd.to_numeric(chunk[\"Anos_de_Estudo\"], downcast=\"float\")\n","    chunk[\"salario_hora\"] = chunk[\"salario_hora\"].astype(\"float32\")\n","    for col in [\"is_formal\", \"is_public\", \"Sexo_Dummy\"] + DUMMIES_SETOR + DUMMIES_OCUPACAO:\n","        chunk[col] = pd.to_numeric(chunk[col], downcast=\"unsigned\")\n","\n","    chunk = chunk[chunk[\"salario_hora\"] > 0].copy()\n","    if chunk.empty:\n","        return chunk\n","\n","    chunk[\"Idade\"] = chunk[\"Ano\"].astype(np.int32) - chunk[\"Ano_Nascimento\"].astype(np.int32)\n","    chunk[\"Experiencia\"] = chunk[\"Idade\"] - chunk[\"Anos_de_Estudo\"] - 6\n","    chunk = chunk[(chunk[\"Experiencia\"] >= 0) & (chunk[\"Idade\"] >= IDADE_MINIMA_TRABALHO)].copy()\n","    if chunk.empty:\n","        return chunk\n","\n","    chunk[\"Faixa_Nascimento\"] = pd.cut(\n","        chunk[\"Ano_Nascimento\"], bins=BINS_NASCIMENTO, labels=LABELS_NASCIMENTO,\n","        include_lowest=True\n","    ).astype(object)\n","    chunk = chunk[chunk[\"Faixa_Nascimento\"].notna()].copy()\n","    if chunk.empty:\n","        return chunk\n","\n","    for reg in REGIOES_NAO_REFERENCIA:\n","        chunk[f\"Reg_{reg}\"] = (chunk[\"Regiao\"] == reg).astype(np.uint8)\n","    for codigo in CODIGOS_COR_NAO_REFERENCIA:\n","        chunk[f\"Cor_{NOMES_COR[codigo]}\"] = (chunk[\"Cor\"] == codigo).astype(np.uint8)\n","\n","    chunk[\"y\"] = np.log(chunk[\"salario_hora\"].astype(np.float64))  # log em float64 por precisão\n","\n","    chunk[\"Coorte_Cluster\"] = (\n","        chunk[\"Sexo_Dummy\"].astype(int).astype(str) + \"-\"\n","        + chunk[\"Faixa_Nascimento\"].astype(str) + \"-\"\n","        + chunk[\"Cor\"].astype(int).astype(str)\n","    )\n","    chunk[\"UF_Cluster\"] = chunk[\"UF\"].astype(str)\n","    chunk[\"Coorte_UF_Cluster\"] = chunk[\"Coorte_Cluster\"] + \"|\" + chunk[\"UF_Cluster\"]\n","\n","    return chunk\n","\n","\n","# =============================================================================\n","# 2. NÍVEIS DE Ano + DESIGN INFO FIXO\n","# =============================================================================\n","\n","def obter_niveis_ano(caminho_parquet: str) -> list:\n","    tabela = pq.read_table(caminho_parquet, columns=[\"Ano\"])\n","    ano_levels = sorted(tabela.to_pandas()[\"Ano\"].dropna().unique().tolist())\n","    print(f\"Níveis de Ano encontrados ({len(ano_levels)}): {ano_levels}\")\n","    del tabela\n","    gc.collect()\n","    return ano_levels\n","\n","\n","def construir_design_info(ano_levels: list):\n","    df_sint = pd.DataFrame({\"Ano\": ano_levels})\n","    df_sint[\"Anos_de_Estudo\"] = 0.0\n","    df_sint[\"is_formal\"] = 0\n","    df_sint[\"is_public\"] = 0\n","    df_sint[\"Sexo_Dummy\"] = 0\n","    for col in DUMMIES_SETOR + DUMMIES_OCUPACAO + NOMES_COLUNAS_REGIAO + NOMES_COLUNAS_COR:\n","        df_sint[col] = 0\n","\n","    global ANO_LEVELS\n","    ANO_LEVELS = ano_levels\n","\n","    formula_rhs = montar_formula_rhs()\n","    X_design = dmatrix(formula_rhs, data=df_sint, return_type=\"dataframe\")\n","    return X_design.design_info, formula_rhs, X_design.columns.tolist()\n","\n","\n","def iterar_chunks(caminho_parquet: str, colunas: list, tamanho_chunk: int):\n","    parquet_file = pq.ParquetFile(caminho_parquet)\n","    for batch in parquet_file.iter_batches(batch_size=tamanho_chunk, columns=colunas):\n","        yield batch.to_pandas()\n","\n","\n","# =============================================================================\n","# 3. PASSADA 1 — EQUAÇÕES NORMAIS (X'X, X'y, Σy, Σy²) -> beta\n","# =============================================================================\n","\n","def passada_1_equacoes_normais(caminho_parquet: str, X_design_info, tamanho_chunk: int):\n","    k = None\n","    XtX = None\n","    Xty = None\n","    soma_y = 0.0\n","    soma_y2 = 0.0\n","    n_total = 0\n","\n","    colunas_leitura = list(set(COLUNAS_NECESSARIAS))\n","\n","    for i, chunk_bruto in enumerate(iterar_chunks(caminho_parquet, colunas_leitura, tamanho_chunk)):\n","        chunk = preparar_chunk(chunk_bruto)\n","        del chunk_bruto\n","        if chunk.empty:\n","            del chunk\n","            gc.collect()\n","            continue\n","\n","        (X_mat,), = [build_design_matrices([X_design_info], chunk, return_type=\"dataframe\")]\n","        X_vals = X_mat.values\n","        y_vals = chunk[\"y\"].values\n","\n","        if XtX is None:\n","            k = X_vals.shape[1]\n","            XtX = np.zeros((k, k))\n","            Xty = np.zeros(k)\n","\n","        XtX += X_vals.T @ X_vals\n","        Xty += X_vals.T @ y_vals\n","        soma_y += y_vals.sum()\n","        soma_y2 += (y_vals ** 2).sum()\n","        n_total += X_vals.shape[0]\n","\n","        print(f\"  [Passada 1/2] chunk {i+1}: +{X_vals.shape[0]:,} obs (acumulado: {n_total:,})\")\n","\n","        del chunk, X_mat, X_vals, y_vals\n","        gc.collect()\n","\n","    beta = np.linalg.solve(XtX, Xty)\n","    return beta, XtX, Xty, soma_y, soma_y2, n_total, k\n","\n","\n","# =============================================================================\n","# 4. PASSADA 2 — RESÍDUOS, CLUSTER SUMS (Coorte, UF, Interseção), BP\n","#    -> os cluster_sums_uf calculados aqui são os MESMOS que o bootstrap\n","#       wild cluster precisa; não é recalculado depois.\n","# =============================================================================\n","\n","def _acumular_grupo(tmp: pd.DataFrame, chave: str, k: int, destino: dict):\n","    grouped = tmp.groupby(chave, observed=True)[tmp.columns.difference([chave], sort=False)].sum()\n","    for label, row in grouped.iterrows():\n","        if label not in destino:\n","            destino[label] = np.zeros(k)\n","        destino[label] += row.values\n","    del grouped\n","\n","\n","def passada_2_residuos(caminho_parquet: str, X_design_info, beta: np.ndarray,\n","                        n_total: int, k: int, nomes_colunas: list,\n","                        tamanho_chunk: int):\n","    residuos = np.empty(n_total, dtype=np.float32)\n","    ano_ordem = np.empty(n_total, dtype=np.int16)\n","    xu2_vec_sum = np.zeros(k)\n","\n","    cluster_sums_coorte: dict[str, np.ndarray] = {}\n","    cluster_sums_uf: dict[str, np.ndarray] = {}\n","    cluster_sums_intersecao: dict[str, np.ndarray] = {}\n","\n","    soma_yhat = soma_yhat2 = soma_yhat3 = soma_yhat4 = 0.0\n","    soma_yhat_u2 = soma_yhat2_u2 = 0.0\n","\n","    colunas_leitura = list(set(COLUNAS_NECESSARIAS))\n","    idx = 0\n","\n","    for i, chunk_bruto in enumerate(iterar_chunks(caminho_parquet, colunas_leitura, tamanho_chunk)):\n","        chunk = preparar_chunk(chunk_bruto)\n","        del chunk_bruto\n","        if chunk.empty:\n","            del chunk\n","            gc.collect()\n","            continue\n","\n","        (X_mat,), = [build_design_matrices([X_design_info], chunk, return_type=\"dataframe\")]\n","        X_vals = X_mat.values\n","        y_vals = chunk[\"y\"].values\n","        u = y_vals - X_vals @ beta\n","        n_c = len(u)\n","\n","        residuos[idx: idx + n_c] = u.astype(np.float32)\n","        ano_ordem[idx: idx + n_c] = chunk[\"Ano\"].values.astype(np.int16)\n","        idx += n_c\n","\n","        xu2_vec_sum += X_vals.T @ (u ** 2)\n","\n","        xu = X_vals * u[:, None]\n","        base = pd.DataFrame(xu, columns=nomes_colunas)\n","\n","        tmp1 = base.copy()\n","        tmp1[\"cluster\"] = chunk[\"Coorte_Cluster\"].values\n","        _acumular_grupo(tmp1, \"cluster\", k, cluster_sums_coorte)\n","        del tmp1\n","\n","        tmp2 = base.copy()\n","        tmp2[\"cluster\"] = chunk[\"UF_Cluster\"].values\n","        _acumular_grupo(tmp2, \"cluster\", k, cluster_sums_uf)\n","        del tmp2\n","\n","        tmp3 = base.copy()\n","        tmp3[\"cluster\"] = chunk[\"Coorte_UF_Cluster\"].values\n","        _acumular_grupo(tmp3, \"cluster\", k, cluster_sums_intersecao)\n","        del tmp3, base, xu\n","\n","        yhat = y_vals - u\n","        u2 = u ** 2\n","        soma_yhat += yhat.sum()\n","        soma_yhat2 += (yhat ** 2).sum()\n","        soma_yhat3 += (yhat ** 3).sum()\n","        soma_yhat4 += (yhat ** 4).sum()\n","        soma_yhat_u2 += (yhat * u2).sum()\n","        soma_yhat2_u2 += ((yhat ** 2) * u2).sum()\n","\n","        print(f\"  [Passada 2/2] chunk {i+1}: +{n_c:,} obs (acumulado: {idx:,})\")\n","\n","        del chunk, X_mat, X_vals, y_vals, u, u2, yhat\n","        gc.collect()\n","\n","    return (residuos, ano_ordem, xu2_vec_sum,\n","            cluster_sums_coorte, cluster_sums_uf, cluster_sums_intersecao,\n","            soma_yhat, soma_yhat2, soma_yhat3, soma_yhat4,\n","            soma_yhat_u2, soma_yhat2_u2)\n","\n","\n","# =============================================================================\n","# 5. ERRO-PADRÃO CLUSTER DE DUAS VIAS (Cameron-Gelbach-Miller, 2011)\n","# =============================================================================\n","\n","def _matriz_v_cluster(XtX_inv: np.ndarray, cluster_sums: dict, n_total: int, k: int):\n","    labels = list(cluster_sums.keys())\n","    G = len(labels)\n","    S = np.vstack([cluster_sums[lb] for lb in labels])\n","    Omega = S.T @ S\n","    correcao = (G / (G - 1)) * ((n_total - 1) / (n_total - k))\n","    V = correcao * (XtX_inv @ Omega @ XtX_inv)\n","    return V, G\n","\n","\n","def erro_padrao_cluster_duplo(XtX, cluster_sums_coorte, cluster_sums_uf,\n","                               cluster_sums_intersecao, n_total, k):\n","    XtX_inv = np.linalg.inv(XtX)\n","    V_coorte, G_coorte = _matriz_v_cluster(XtX_inv, cluster_sums_coorte, n_total, k)\n","    V_uf, G_uf = _matriz_v_cluster(XtX_inv, cluster_sums_uf, n_total, k)\n","    V_intersecao, G_intersecao = _matriz_v_cluster(XtX_inv, cluster_sums_intersecao, n_total, k)\n","\n","    V_duplo = V_coorte + V_uf - V_intersecao\n","\n","    autovalores, autovetores = np.linalg.eigh(V_duplo)\n","    if np.any(autovalores < 0):\n","        n_negativos = int((autovalores < 0).sum())\n","        print(f\"⚠ V_duplo não era semidefinida positiva ({n_negativos} autovalor(es) \"\n","              f\"negativo(s)) -- aplicando eigenvalue clipping (CGM 2011).\")\n","        autovalores = np.clip(autovalores, 0, None)\n","        V_duplo = autovetores @ np.diag(autovalores) @ autovetores.T\n","\n","    se_duplo = np.sqrt(np.diag(V_duplo))\n","    G_min = min(G_coorte, G_uf)\n","    return se_duplo, G_min, G_coorte, G_uf, G_intersecao, V_duplo\n","\n","\n","# =============================================================================\n","# 6. TESTES DE DIAGNÓSTICO\n","# =============================================================================\n","\n","def teste_jarque_bera(residuos):\n","    jb_stat, jb_p = stats.jarque_bera(residuos)\n","    return jb_stat, jb_p, stats.skew(residuos), stats.kurtosis(residuos, fisher=False)\n","\n","\n","def teste_durbin_watson(residuos_ordenados):\n","    diffs = np.diff(residuos_ordenados)\n","    return float(np.sum(diffs ** 2) / np.sum(residuos_ordenados ** 2))\n","\n","\n","def teste_breusch_pagan(xu2_vec_sum, XtX_inv, soma_u2, soma_u4, n_total, k):\n","    beta_aux = XtX_inv @ xu2_vec_sum\n","    sse_aux = soma_u4 - beta_aux @ xu2_vec_sum\n","    sst_aux = soma_u4 - (soma_u2 ** 2) / n_total\n","    r2_aux = 1 - sse_aux / sst_aux\n","    bp_stat = n_total * r2_aux\n","    bp_p = 1 - stats.chi2.cdf(bp_stat, k - 1)\n","    return bp_stat, bp_p, r2_aux\n","\n","\n","def teste_white_simplificado(soma_u2, soma_u4, soma_yhat, soma_yhat2, soma_yhat3,\n","                              soma_yhat4, soma_yhat_u2, soma_yhat2_u2, n_total):\n","    ZtZ = np.array([\n","        [n_total, soma_yhat, soma_yhat2],\n","        [soma_yhat, soma_yhat2, soma_yhat3],\n","        [soma_yhat2, soma_yhat3, soma_yhat4],\n","    ])\n","    Ztu2 = np.array([soma_u2, soma_yhat_u2, soma_yhat2_u2])\n","    gamma = np.linalg.solve(ZtZ, Ztu2)\n","    sst_aux = soma_u4 - (soma_u2 ** 2) / n_total\n","    sse_aux = soma_u4 - gamma @ Ztu2\n","    r2_aux = 1 - sse_aux / sst_aux\n","    white_stat = n_total * r2_aux\n","    white_p = 1 - stats.chi2.cdf(white_stat, 2)\n","    return white_stat, white_p, r2_aux\n","\n","\n","def teste_breusch_godfrey(residuos_ordenados, ordem: int = 1):\n","    u = residuos_ordenados.astype(np.float64)\n","    n = len(u)\n","    Y = u[ordem:]\n","    Z = np.column_stack([np.ones(len(Y))] + [u[ordem - j: n - j] for j in range(1, ordem + 1)])\n","    gamma, *_ = np.linalg.lstsq(Z, Y, rcond=None)\n","    sse_aux = np.sum((Y - Z @ gamma) ** 2)\n","    sst_aux = np.sum((Y - Y.mean()) ** 2)\n","    r2_aux = 1 - sse_aux / sst_aux\n","    n_efetivo = len(Y)\n","    bg_stat = n_efetivo * r2_aux\n","    bg_p = 1 - stats.chi2.cdf(bg_stat, ordem)\n","    return bg_stat, bg_p, r2_aux\n","\n","\n","def calcular_vif(XtX, nomes_colunas):\n","    idx_intercepto = nomes_colunas.index(\"Intercept\") if \"Intercept\" in nomes_colunas else 0\n","    idx_outros = [i for i in range(len(nomes_colunas)) if i != idx_intercepto]\n","    nomes_outros = [nomes_colunas[i] for i in idx_outros]\n","\n","    n = XtX[idx_intercepto, idx_intercepto]\n","    soma_x = XtX[idx_intercepto, idx_outros]\n","    XtX_sub = XtX[np.ix_(idx_outros, idx_outros)]\n","    M = XtX_sub - np.outer(soma_x, soma_x) / n\n","    M_inv = np.linalg.inv(M)\n","    vif = np.diag(M) * np.diag(M_inv)\n","\n","    return (pd.DataFrame({\"Variável\": nomes_outros, \"VIF\": vif})\n","            .sort_values(\"VIF\", ascending=False).reset_index(drop=True))\n","\n","\n","def calcular_matriz_correlacao(XtX, nomes_colunas):\n","    idx_intercepto = nomes_colunas.index(\"Intercept\") if \"Intercept\" in nomes_colunas else 0\n","    idx_outros = [i for i in range(len(nomes_colunas)) if i != idx_intercepto]\n","    nomes_outros = [nomes_colunas[i] for i in idx_outros]\n","\n","    n = XtX[idx_intercepto, idx_intercepto]\n","    soma_x = XtX[idx_intercepto, idx_outros]\n","    XtX_sub = XtX[np.ix_(idx_outros, idx_outros)]\n","    M = XtX_sub - np.outer(soma_x, soma_x) / n\n","    d = np.sqrt(np.diag(M))\n","    corr = M / np.outer(d, d)\n","    np.fill_diagonal(corr, 1.0)\n","    corr = np.clip(corr, -1.0, 1.0)\n","    return pd.DataFrame(corr, index=nomes_outros, columns=nomes_outros)\n","\n","\n","def numero_condicao(XtX):\n","    autovalores = np.linalg.eigvalsh(XtX)\n","    autovalores = autovalores[autovalores > 1e-12]\n","    return float(np.sqrt(autovalores.max() / autovalores.min()))\n","\n","\n","# =============================================================================\n","# 7. SUMÁRIO PRINCIPAL (coeficientes, SE cluster duplo, testes, VIF, correlação)\n","# =============================================================================\n","\n","def imprimir_sumario(beta, se_duplo, G_min, G_coorte, G_uf, G_intersecao,\n","                      XtX, Xty, soma_y, soma_y2, n_total, k, nomes_colunas,\n","                      residuos, ano_ordem, xu2_vec_sum,\n","                      soma_yhat, soma_yhat2, soma_yhat3, soma_yhat4,\n","                      soma_yhat_u2, soma_yhat2_u2):\n","    XtX_inv = np.linalg.inv(XtX)\n","    sse = soma_y2 - beta @ Xty\n","    media_y = soma_y / n_total\n","    sst = soma_y2 - n_total * media_y ** 2\n","    r2 = 1 - sse / sst\n","    r2_ajustado = 1 - (sse / (n_total - k)) / (sst / (n_total - 1))\n","    f_stat = ((sst - sse) / (k - 1)) / (sse / (n_total - k))\n","    f_p = 1 - stats.f.cdf(f_stat, k - 1, n_total - k)\n","    cond_no = numero_condicao(XtX)\n","\n","    residuos64 = residuos.astype(np.float64)\n","    jb_stat, jb_p, skew, kurt = teste_jarque_bera(residuos64)\n","    omni_stat, omni_p = stats.normaltest(residuos64)\n","    dw_original = teste_durbin_watson(residuos64)\n","    ordem_ano = np.argsort(ano_ordem, kind=\"stable\")\n","    dw_ano = teste_durbin_watson(residuos64[ordem_ano])\n","    soma_u2 = float(residuos64 @ residuos64)\n","    soma_u4 = float((residuos64 ** 4).sum())\n","    bp_stat, bp_p, r2_aux_bp = teste_breusch_pagan(xu2_vec_sum, XtX_inv, soma_u2, soma_u4, n_total, k)\n","    white_stat, white_p, _ = teste_white_simplificado(\n","        soma_u2, soma_u4, soma_yhat, soma_yhat2, soma_yhat3, soma_yhat4,\n","        soma_yhat_u2, soma_yhat2_u2, n_total\n","    )\n","    bg_stat, bg_p, _ = teste_breusch_godfrey(residuos64[ordem_ano], ordem=1)\n","    tabela_vif = calcular_vif(XtX, nomes_colunas)\n","    matriz_corr = calcular_matriz_correlacao(XtX, nomes_colunas)\n","\n","    t_stats = beta / se_duplo\n","    df_t = G_min - 1\n","    p_valores = 2 * (1 - stats.t.cdf(np.abs(t_stats), df_t))\n","    ic_baixo = beta - stats.t.ppf(0.975, df_t) * se_duplo\n","    ic_alto = beta + stats.t.ppf(0.975, df_t) * se_duplo\n","\n","    tabela_coef = pd.DataFrame({\n","        \"Variável\": nomes_colunas, \"Coef.\": beta,\n","        \"Erro_Padrao_Cluster_Duplo\": se_duplo, \"t\": t_stats, \"P>|t|\": p_valores,\n","        \"IC_2.5%\": ic_baixo, \"IC_97.5%\": ic_alto,\n","    })\n","\n","    # -- Ano continua no modelo (X_design_info, XtX, beta, resíduos acima usam\n","    #    todas as k colunas normalmente); aqui só filtramos o que é IMPRESSO/\n","    #    EXPORTADO/RETORNADO, se OMITIR_EFEITOS_ANO_DA_TABELA estiver ligado.\n","    n_anos_omitidos = 0\n","    if OMITIR_EFEITOS_ANO_DA_TABELA:\n","        mask_ano_coef = tabela_coef[\"Variável\"].apply(eh_coluna_efeito_fixo_ano)\n","        n_anos_omitidos = int(mask_ano_coef.sum())\n","        tabela_coef = tabela_coef.loc[~mask_ano_coef].reset_index(drop=True)\n","\n","        mask_ano_vif = tabela_vif[\"Variável\"].apply(eh_coluna_efeito_fixo_ano)\n","        tabela_vif = tabela_vif.loc[~mask_ano_vif].reset_index(drop=True)\n","\n","        colunas_corr_manter = [c for c in matriz_corr.columns if not eh_coluna_efeito_fixo_ano(c)]\n","        matriz_corr = matriz_corr.loc[colunas_corr_manter, colunas_corr_manter]\n","\n","    print(\"\\n\" + \"=\" * 78)\n","    print(f\"R²: {r2:.4f} | R² aj.: {r2_ajustado:.4f} | F: {f_stat:,.2f} (p={f_p:.3g}) | Cond.No: {cond_no:,.1f}\")\n","    print(f\"N: {n_total:,} | G Coorte/UF/∩: {G_coorte}/{G_uf}/{G_intersecao}\")\n","    print(f\"JB: {jb_stat:,.1f} (p={jb_p:.3g}) | Omnibus: {omni_stat:,.1f} (p={omni_p:.3g})\")\n","    print(f\"DW orig: {dw_original:.4f} | DW p/Ano: {dw_ano:.4f}\")\n","    print(f\"BP: {bp_stat:,.1f} (p={bp_p:.3g}) | White: {white_stat:,.1f} (p={white_p:.3g}) | BG: {bg_stat:,.1f} (p={bg_p:.3g})\")\n","    if G_min < 30:\n","        print(f\"⚠ min(G_Coorte, G_UF) = {G_min} -- abaixo de 30-50. Ver seção de bootstrap wild cluster em UF.\")\n","    if n_anos_omitidos:\n","        print(f\"ℹ {n_anos_omitidos} dummies de Ano foram estimados e continuam controlando o \"\n","              f\"modelo como efeito fixo, mas foram omitidos desta tabela (OMITIR_EFEITOS_ANO_DA_TABELA=True).\")\n","    print(\"=\" * 78)\n","    print(tabela_coef.to_string(index=False, float_format=lambda v: f\"{v:,.5f}\"))\n","\n","    tabela_coef.to_csv(\"m5_ajustado_coeficientes_cluster_coorte_uf.csv\", index=False, encoding=\"utf-8-sig\")\n","    tabela_vif.to_csv(\"m5_ajustado_vif.csv\", index=False, encoding=\"utf-8-sig\")\n","    print(\"\\nExportado: m5_ajustado_coeficientes_cluster_coorte_uf.csv\")\n","    print(\"Exportado: m5_ajustado_vif.csv\")\n","\n","    testes = {\n","        \"jb_stat\": jb_stat, \"jb_p\": jb_p, \"skew\": skew, \"kurt\": kurt,\n","        \"dw_original\": dw_original, \"bp_stat\": bp_stat, \"bp_p\": bp_p,\n","    }\n","\n","    return {\n","        \"tabela_coeficientes\": tabela_coef, \"tabela_vif\": tabela_vif,\n","        \"matriz_correlacao\": matriz_corr, \"testes\": testes, \"r2\": r2,\n","    }\n","\n","\n","# =============================================================================\n","# 8. WILD CLUSTER BOOTSTRAP (dimensão UF) — reaproveita cluster_sums_uf, XtX\n","#    e beta já calculados na Passada 2; nenhuma releitura do parquet.\n","# =============================================================================\n","\n","def pesos_rademacher(G: int, rng: np.random.Generator) -> np.ndarray:\n","    return rng.choice([-1.0, 1.0], size=G)\n","\n","\n","def pesos_webb(G: int, rng: np.random.Generator) -> np.ndarray:\n","    \"\"\"Peso de 6 pontos de Webb (2014) -- alternativa mais conservadora que\n","    Rademacher quando G é pequeno (aqui G_UF=27, no limite aceitável).\"\"\"\n","    valores = np.array([-np.sqrt(1.5), -1.0, -np.sqrt(0.5), np.sqrt(0.5), 1.0, np.sqrt(1.5)])\n","    return rng.choice(valores, size=G)\n","\n","\n","def rodar_wild_bootstrap_uf(beta: np.ndarray, XtX: np.ndarray,\n","                             cluster_sums_uf: dict, nomes_colunas: list,\n","                             n_total: int, k: int,\n","                             n_boot: int = 4999, tipo_peso: str = \"rademacher\",\n","                             seed: int = 0):\n","    print(f\"\\n[Bootstrap] {n_boot:,} réplicas, pesos={tipo_peso}, G_UF={len(cluster_sums_uf)}...\")\n","    XtX_inv = np.linalg.inv(XtX)\n","    labels = list(cluster_sums_uf.keys())\n","    G = len(labels)\n","    S = np.vstack([cluster_sums_uf[lb] for lb in labels])  # (G, k)\n","\n","    rng = np.random.default_rng(seed)\n","    gerador_peso = pesos_rademacher if tipo_peso == \"rademacher\" else pesos_webb\n","\n","    betas_boot = np.empty((n_boot, k))\n","    for b in range(n_boot):\n","        w = gerador_peso(G, rng)\n","        delta = XtX_inv @ (w @ S)\n","        betas_boot[b] = beta + delta\n","\n","    se_boot = betas_boot.std(axis=0, ddof=1)\n","    ic_baixo = np.percentile(betas_boot, 2.5, axis=0)\n","    ic_alto = np.percentile(betas_boot, 97.5, axis=0)\n","\n","    Omega = S.T @ S\n","    correcao = (G / (G - 1)) * ((n_total - 1) / (n_total - k))\n","    V_uf = correcao * (XtX_inv @ Omega @ XtX_inv)\n","    se_assintotica_uf = np.sqrt(np.diag(V_uf))\n","\n","    df_t = G - 1\n","    t_boot = beta / se_boot\n","    p_boot_aprox = 2 * (1 - stats.t.cdf(np.abs(t_boot), df_t))\n","\n","    tabela = pd.DataFrame({\n","        \"Variável\": nomes_colunas,\n","        \"Coef.\": beta,\n","        \"SE_Assintotica_UF\": se_assintotica_uf,\n","        \"SE_Bootstrap_UF\": se_boot,\n","        \"Razao_Boot_Assint\": se_boot / se_assintotica_uf,\n","        \"IC_Boot_2.5%\": ic_baixo,\n","        \"IC_Boot_97.5%\": ic_alto,\n","        \"t_boot_aprox\": t_boot,\n","        \"p_boot_aprox\": p_boot_aprox,\n","    })\n","\n","    # -- betas_boot (todas as k colunas, incl. Ano) é retornado intacto --\n","    #    o bootstrap em si roda sobre o modelo completo. Só a TABELA impressa/\n","    #    exportada/usada na consolidação final omite as linhas de Ano.\n","    if OMITIR_EFEITOS_ANO_DA_TABELA:\n","        mask_ano = tabela[\"Variável\"].apply(eh_coluna_efeito_fixo_ano)\n","        tabela = tabela.loc[~mask_ano].reset_index(drop=True)\n","\n","    print(\"\\n\" + \"=\" * 78)\n","    print(f\"WILD CLUSTER BOOTSTRAP — UF (G={G}, réplicas={n_boot:,}, pesos={tipo_peso})\")\n","    print(\"=\" * 78)\n","    print(tabela.to_string(index=False, float_format=lambda v: f\"{v:,.5f}\"))\n","    print(\"\\nNota: SE_Bootstrap_UF / SE_Assintotica_UF > 1.15 ou < 0.85 sinaliza que a \"\n","          \"aproximação assintótica (t-Student, G-1 graus de liberdade) pode estar \"\n","          \"distorcendo a inferência nessa variável -- confie mais no IC bootstrap \"\n","          \"nesses casos.\")\n","    print(\"p_boot_aprox usa SE_Bootstrap_UF com t-Student(G-1) -- é uma aproximação de \"\n","          \"Wald, não o p-valor bootstrap-t exato (que exigiria refit restrito por \"\n","          \"réplica). Para inferência formal de hipótese, prefira o IC percentil.\")\n","\n","    tabela.to_csv(\"m5_wild_cluster_bootstrap_uf.csv\", index=False, encoding=\"utf-8-sig\")\n","    print(\"\\nExportado: m5_wild_cluster_bootstrap_uf.csv\")\n","\n","    return tabela, betas_boot\n","\n","\n","# =============================================================================\n","# 9. GRÁFICOS — reaproveitam resíduos/tabela_vif/matriz_corr já em memória\n","# =============================================================================\n","\n","def plotar_diagnostico_residuos(residuos, testes, dpi=200):\n","    u = residuos.astype(np.float64)\n","    rng = np.random.default_rng(0)\n","    amostra_idx = np.sort(rng.choice(len(u), size=min(20_000, len(u)), replace=False))\n","\n","    fig, axes = plt.subplots(2, 2, figsize=(13, 10))\n","\n","    ax = axes[0, 0]\n","    ax.hist(u, bins=100, density=True, color=\"#1f77b4\", alpha=0.7, label=\"Resíduos\")\n","    x_norm = np.linspace(u.min(), u.max(), 300)\n","    ax.plot(x_norm, stats.norm.pdf(x_norm, u.mean(), u.std()), color=\"#d62728\", linewidth=2, label=\"Normal teórica\")\n","    ax.set_title(f\"Histograma dos Resíduos\\nJB={testes['jb_stat']:,.1f} (p={testes['jb_p']:.3g}), \"\n","                 f\"Skew={testes['skew']:.3f}, Curtose={testes['kurt']:.3f}\")\n","    ax.legend(fontsize=8)\n","\n","    ax = axes[0, 1]\n","    stats.probplot(u[amostra_idx], dist=\"norm\", plot=ax)\n","    ax.set_title(\"Q-Q Plot dos Resíduos (amostra de 20 mil)\")\n","\n","    ax = axes[1, 0]\n","    ax.scatter(amostra_idx, u[amostra_idx], s=2, alpha=0.3, color=\"#2ca02c\")\n","    ax.axhline(0, color=\"black\", linewidth=1, linestyle=\"--\")\n","    ax.set_title(f\"Resíduos vs. Ordem Original\\nDurbin-Watson = {testes['dw_original']:.4f}\")\n","\n","    ax = axes[1, 1]\n","    ax.scatter(amostra_idx, np.sqrt(np.abs(u[amostra_idx])), s=2, alpha=0.3, color=\"#ff7f0e\")\n","    ax.set_title(f\"√|Resíduo| vs. Ordem\\nBreusch-Pagan={testes['bp_stat']:,.1f} (p={testes['bp_p']:.3g})\")\n","\n","    fig.suptitle(\"Diagnóstico de Resíduos — M5 Ajustado\", fontsize=13, y=1.01)\n","    fig.tight_layout()\n","    fig.savefig(\"m5_ajustado_diagnostico_residuos.png\", dpi=dpi, bbox_inches=\"tight\")\n","    plt.close(fig)\n","    print(\"Exportado: m5_ajustado_diagnostico_residuos.png\")\n","\n","\n","def plotar_vif(tabela_vif, dpi=200):\n","    tabela_vif_plot = tabela_vif.sort_values(\"VIF\", ascending=True)\n","    fig, ax = plt.subplots(figsize=(9, max(4, len(tabela_vif_plot) * 0.3)))\n","    cores = [\"#d62728\" if v > 10 else (\"#ff7f0e\" if v > 5 else \"#2ca02c\") for v in tabela_vif_plot[\"VIF\"]]\n","    ax.barh(tabela_vif_plot[\"Variável\"], tabela_vif_plot[\"VIF\"], color=cores)\n","    ax.axvline(5, color=\"#ff7f0e\", linestyle=\"--\", linewidth=1, label=\"VIF = 5 (monitorar)\")\n","    ax.axvline(10, color=\"#d62728\", linestyle=\"--\", linewidth=1, label=\"VIF = 10 (preocupante)\")\n","    ax.set_xlabel(\"VIF\")\n","    ax.set_title(\"Variance Inflation Factor (VIF) por Regressor\")\n","    ax.legend(fontsize=8, loc=\"lower right\")\n","    ax.tick_params(axis=\"y\", labelsize=7)\n","    fig.tight_layout()\n","    fig.savefig(\"m5_ajustado_vif_grafico.png\", dpi=dpi, bbox_inches=\"tight\")\n","    plt.close(fig)\n","    print(\"Exportado: m5_ajustado_vif_grafico.png\")\n","\n","\n","def plotar_matriz_correlacao(matriz_corr, dpi=200):\n","    n_vars = matriz_corr.shape[0]\n","    tamanho_lado = max(10, n_vars * 0.35)\n","    fig, ax = plt.subplots(figsize=(tamanho_lado, tamanho_lado))\n","    im = ax.imshow(matriz_corr.values, cmap=\"RdBu_r\", vmin=-1, vmax=1)\n","    ax.set_xticks(range(n_vars))\n","    ax.set_xticklabels(matriz_corr.columns, rotation=90, fontsize=6)\n","    ax.set_yticks(range(n_vars))\n","    ax.set_yticklabels(matriz_corr.index, fontsize=6)\n","    ax.set_title(\"Matriz de Correlação dos Regressores\")\n","    fig.colorbar(im, ax=ax, fraction=0.046, pad=0.04, label=\"Correlação de Pearson\")\n","    fig.tight_layout()\n","    fig.savefig(\"m5_ajustado_matriz_correlacao.png\", dpi=dpi, bbox_inches=\"tight\")\n","    plt.close(fig)\n","    print(\"Exportado: m5_ajustado_matriz_correlacao.png\")\n","\n","\n","# =============================================================================\n","# 10. TABELA FINAL CONSOLIDADA (coeficientes + robustez do bootstrap)\n","# =============================================================================\n","\n","def estrelas_significancia(p: float) -> str:\n","    if p < 0.01:\n","        return \"***\"\n","    elif p < 0.05:\n","        return \"**\"\n","    elif p < 0.10:\n","        return \"*\"\n","    return \"\"\n","\n","\n","def consolidar_tabela_final(tabela_coef: pd.DataFrame, tabela_boot: pd.DataFrame,\n","                             caminho_saida: str = \"m5_ajustado_tabela_final.csv\"):\n","    tabela = tabela_coef.merge(\n","        tabela_boot[[\"Variável\", \"SE_Bootstrap_UF\", \"SE_Assintotica_UF\", \"Razao_Boot_Assint\"]],\n","        on=\"Variável\", how=\"left\"\n","    )\n","\n","    tabela[\"Signif.\"] = tabela[\"P>|t|\"].apply(estrelas_significancia)\n","\n","    tabela[\"Efeito_%_Aprox\"] = (np.exp(tabela[\"Coef.\"]) - 1) * 100\n","    tabela.loc[tabela[\"Variável\"] == \"Intercept\", \"Efeito_%_Aprox\"] = np.nan\n","\n","    def flag_robustez(razao):\n","        if pd.isna(razao):\n","            return \"não checado\"\n","        return \"OK\" if 0.85 <= razao <= 1.15 else \"Atenção\"\n","\n","    tabela[\"Robustez_Bootstrap\"] = tabela[\"Razao_Boot_Assint\"].apply(flag_robustez)\n","\n","    colunas_finais = [\n","        \"Variável\", \"Coef.\", \"Signif.\", \"Erro_Padrao_Cluster_Duplo\",\n","        \"t\", \"P>|t|\", \"IC_2.5%\", \"IC_97.5%\", \"Efeito_%_Aprox\",\n","        \"SE_Bootstrap_UF\", \"Razao_Boot_Assint\", \"Robustez_Bootstrap\",\n","    ]\n","    tabela = tabela[colunas_finais]\n","\n","    tabela.to_csv(caminho_saida, index=False, encoding=\"utf-8-sig\")\n","    print(f\"\\nExportado: {caminho_saida}\")\n","\n","    n_atencao = (tabela[\"Robustez_Bootstrap\"] == \"Atenção\").sum()\n","    print(f\"Variáveis sinalizadas para atenção na robustez bootstrap: {n_atencao} de {len(tabela)}\")\n","\n","    print(\"\\n\" + \"=\" * 100)\n","    print(\"TABELA FINAL DE COEFICIENTES — M5 AJUSTADO (cluster duplo Coorte + UF)\")\n","    print(\"=\" * 100)\n","    colunas_print = [\"Variável\", \"Coef.\", \"Signif.\", \"Erro_Padrao_Cluster_Duplo\", \"P>|t|\", \"Efeito_%_Aprox\"]\n","    print(tabela[colunas_print].to_string(index=False, float_format=lambda v: f\"{v:,.4f}\"))\n","    print(\"\\nSignificância: *** p<0.01, ** p<0.05, * p<0.10\")\n","    print(\"Efeito_%_Aprox = (exp(coef.) - 1) × 100 -- interpretação direta para dummies;\")\n","    print(\"para Anos_de_Estudo, é o efeito aproximado de +1 ano de estudo sobre o salário-hora.\")\n","\n","    return tabela\n","\n","\n","# =============================================================================\n","# 11. PONTO DE ENTRADA — ORQUESTRA TUDO EM 2 PASSADAS PELO PARQUET\n","# =============================================================================\n","\n","def rodar_pipeline_completo(caminho_parquet: str, tamanho_chunk: int = 100_000,\n","                             n_boot: int = 4999, tipo_peso: str = \"rademacher\"):\n","    print(\"#\" * 78)\n","    print(f\"# PIPELINE COMPLETO M5 AJUSTADO (chunk={tamanho_chunk:,}, boot={n_boot:,})\")\n","    print(\"#\" * 78)\n","\n","    ano_levels = obter_niveis_ano(caminho_parquet)\n","    X_design_info, formula_rhs, nomes_colunas = construir_design_info(ano_levels)\n","    k = len(nomes_colunas)\n","    print(f\"k (regressores, incl. intercepto): {k}\")\n","\n","    # --- Passada 1/2: equações normais -----------------------------------\n","    print(f\"\\n[Passada 1/2] chunk={tamanho_chunk:,}...\")\n","    beta, XtX, Xty, soma_y, soma_y2, n_total, k = passada_1_equacoes_normais(\n","        caminho_parquet, X_design_info, tamanho_chunk\n","    )\n","    print(f\"Total de observações: {n_total:,}\")\n","\n","    # --- Passada 2/2: resíduos + cluster sums (Coorte, UF, interseção) ---\n","    print(\"\\n[Passada 2/2]...\")\n","    (residuos, ano_ordem, xu2_vec_sum,\n","     cs_coorte, cs_uf, cs_intersecao,\n","     s_yhat, s_yhat2, s_yhat3, s_yhat4, s_yhat_u2, s_yhat2_u2) = passada_2_residuos(\n","        caminho_parquet, X_design_info, beta, n_total, k, nomes_colunas, tamanho_chunk\n","    )\n","\n","    # --- Cluster duplo + testes + VIF + correlação (sem reler parquet) ---\n","    print(\"\\n[Cluster duplo + sumário]...\")\n","    se_duplo, G_min, G_coorte, G_uf, G_intersecao, V_duplo = erro_padrao_cluster_duplo(\n","        XtX, cs_coorte, cs_uf, cs_intersecao, n_total, k\n","    )\n","    sumario = imprimir_sumario(\n","        beta, se_duplo, G_min, G_coorte, G_uf, G_intersecao,\n","        XtX, Xty, soma_y, soma_y2, n_total, k, nomes_colunas,\n","        residuos, ano_ordem, xu2_vec_sum,\n","        s_yhat, s_yhat2, s_yhat3, s_yhat4, s_yhat_u2, s_yhat2_u2\n","    )\n","\n","    # --- Wild cluster bootstrap em UF (reaproveita cs_uf, XtX, beta) -----\n","    tabela_boot, betas_boot = rodar_wild_bootstrap_uf(\n","        beta, XtX, cs_uf, nomes_colunas, n_total, k,\n","        n_boot=n_boot, tipo_peso=tipo_peso\n","    )\n","\n","    # --- Gráficos (reaproveita resíduos, VIF, correlação já em memória) --\n","    print(\"\\n[Gráficos]...\")\n","    plotar_diagnostico_residuos(residuos, sumario[\"testes\"])\n","    plotar_vif(sumario[\"tabela_vif\"])\n","    plotar_matriz_correlacao(sumario[\"matriz_correlacao\"])\n","\n","    # --- Tabela final consolidada -----------------------------------------\n","    tabela_final = consolidar_tabela_final(sumario[\"tabela_coeficientes\"], tabela_boot)\n","\n","    print(\"\\nConcluído. Arquivos gerados:\")\n","    print(\"  m5_ajustado_coeficientes_cluster_coorte_uf.csv\")\n","    print(\"  m5_ajustado_vif.csv\")\n","    print(\"  m5_wild_cluster_bootstrap_uf.csv\")\n","    print(\"  m5_ajustado_tabela_final.csv\")\n","    print(\"  m5_ajustado_diagnostico_residuos.png\")\n","    print(\"  m5_ajustado_vif_grafico.png\")\n","    print(\"  m5_ajustado_matriz_correlacao.png\")\n","\n","    return {\n","        \"beta\": beta, \"XtX\": XtX, \"n_obs\": n_total, \"k\": k,\n","        \"tabela_coeficientes\": sumario[\"tabela_coeficientes\"],\n","        \"tabela_vif\": sumario[\"tabela_vif\"],\n","        \"matriz_correlacao\": sumario[\"matriz_correlacao\"],\n","        \"tabela_bootstrap_uf\": tabela_boot,\n","        \"tabela_final\": tabela_final,\n","        \"betas_boot\": betas_boot,\n","        \"r2\": sumario[\"r2\"],\n","    }\n","\n","\n","if __name__ == \"__main__\":\n","    caminho = \"/content/pnad_processado_final.parquet\"\n","    # Se estourar RAM, reduza tamanho_chunk (ex.: 50_000).\n","    resultado = rodar_pipeline_completo(\n","        caminho, tamanho_chunk=100_000, n_boot=4999, tipo_peso=\"rademacher\"\n","    )"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"T1Yzq1Jx-LRQ","executionInfo":{"status":"ok","timestamp":1787251643746,"user